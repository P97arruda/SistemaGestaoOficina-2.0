<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OficinaCET107.Mobile.Views.DetalhesVeiculoPage"
    Title="Detalhes do Veículo"
    BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <!-- CABEÇALHO -->
            <Border BackgroundColor="#0D6EFD"
                    StrokeThickness="0"
                    Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label Text="🚗  Detalhes do Veículo"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Consulte as informações do seu veículo."
                           FontSize="14"
                           TextColor="#E7F1FF"/>

                </VerticalStackLayout>
            </Border>

            <!-- CARREGAMENTO -->
            <ActivityIndicator
                x:Name="LoadingIndicator"
                Color="#0D6EFD"
                IsRunning="True"
                IsVisible="True"
                HorizontalOptions="Center"
                Margin="0,40,0,0"/>

            <!-- CONTEÚDO -->
            <VerticalStackLayout
                x:Name="DetalhesContent"
                Spacing="16"
                IsVisible="False">

                <Label Text="Informações do veículo"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#212529"/>

                <Border BackgroundColor="White"
                        Stroke="#E9ECEF"
                        StrokeThickness="1"
                        Padding="20">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Opacity="0.06"
                                Radius="8"
                                Offset="0,3"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <!-- MARCA -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Marca"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="MarcaLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- MODELO -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Modelo"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="ModeloLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- ANO -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Ano"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="AnoLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- MATRÍCULA -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Matrícula"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="MatriculaLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- QUILOMETRAGEM -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Quilometragem"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="QuilometragemLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- COMBUSTÍVEL -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Combustível"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="CombustivelLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
