<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OficinaCET107.Mobile.Views.DetalhesMarcacaoPage"
    Title="Detalhes da Marcação"
    BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <!-- CABEÇALHO -->
            <Border BackgroundColor="#0D6EFD"
                    StrokeThickness="0"
                    Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label Text="📅  Detalhes da Marcação"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Consulte as informações do seu agendamento."
                           FontSize="14"
                           TextColor="#E7F1FF"/>

                </VerticalStackLayout>
            </Border>

            <!-- CONTEÚDO -->
            <VerticalStackLayout
                x:Name="DetalhesContent"
                Spacing="16"
                IsVisible="False">

                <Label Text="Informações da marcação"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#212529"/>

                <Border BackgroundColor="White"
                        Stroke="#E9ECEF"
                        StrokeThickness="1"
                        Padding="20">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Opacity="0.06"
                                Radius="8"
                                Offset="0,3"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <!-- TIPO DE SERVIÇO -->
                        <VerticalStackLayout Spacing="5">

                            <Label Text="Tipo de serviço"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="TipoServicoLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- VEÍCULO -->
                        <VerticalStackLayout Spacing="5">

                            <Label Text="Veículo"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="VeiculoLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- MATRÍCULA -->
                        <VerticalStackLayout Spacing="5">

                            <Label Text="Matrícula"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="MatriculaLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- DATA E HORA -->
                        <VerticalStackLayout Spacing="5">

                            <Label Text="Data e hora"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="DataHoraLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- ESTADO -->
                        <VerticalStackLayout Spacing="5">

                            <Label Text="Estado da marcação"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="EstadoLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- MECÂNICO -->
                        <VerticalStackLayout Spacing="5">

                            <Label Text="Mecânico responsável"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="MecanicoLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="Informações da marcação registada na oficina."
                    FontSize="12"
                    TextColor="#6C757D"
                    HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
