<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OficinaCET107.Mobile.Views.DashboardPage"
    Title="Área do Cliente"
    BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- CABEÇALHO -->
            <Border BackgroundColor="White"
                    Stroke="#E9ECEF"
                    StrokeThickness="1"
                    Padding="20,18">

                <Grid ColumnDefinitions="48,*"
                      ColumnSpacing="12">

                    <Border Grid.Column="0"
                            BackgroundColor="#0D6EFD"
                            StrokeThickness="0"
                            WidthRequest="46"
                            HeightRequest="46">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Label Text="O"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">

                        <Label Text="OficinaCET107"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#212529"/>

                        <Label Text="Área do Cliente"
                               FontSize="13"
                               TextColor="#6C757D"/>

                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- CONTEÚDO -->
            <VerticalStackLayout Padding="20,24"
                                 Spacing="22">

                <!-- BOAS-VINDAS -->
                <Border BackgroundColor="#0D6EFD"
                        StrokeThickness="0"
                        Padding="22">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">

                        <Label Text="Bem-vindo!"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <Label Text="Acompanhe os seus veículos, marcações e serviços realizados."
                               FontSize="14"
                               TextColor="#E7F1FF"
                               LineBreakMode="WordWrap"/>

                    </VerticalStackLayout>
                </Border>

                <!-- TÍTULO -->
                <VerticalStackLayout Spacing="5">

                    <Label Text="Acesso rápido"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="#212529"/>

                    <Label Text="O que pretende consultar?"
                           FontSize="13"
                           TextColor="#6C757D"/>

                </VerticalStackLayout>

                <!-- CARDS -->
                <VerticalStackLayout Spacing="14">


                    <!-- MEUS VEÍCULOS -->
                    <Border x:Name="VeiculosCard"
                            BackgroundColor="White"
                            Stroke="#E9ECEF"
                            StrokeThickness="1"
                            Padding="16">

                            <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>

                        <!-- Permite clicar em todo o cartão -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVeiculosTapped"/>
                        </Border.GestureRecognizers>

                        <Border.Shadow>
                            <Shadow Brush="Black"
                            Opacity="0.06"
                            Radius="8"
                            Offset="0,3"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="50,*,20"
                              ColumnSpacing="12">

                            <!-- Ícone -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#E7F1FF"
                                    StrokeThickness="0"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Label Text="🚗"
                                       FontSize="23"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <!-- Informações -->
                            <VerticalStackLayout Grid.Column="1"
                             Spacing="5"
                             VerticalOptions="Center">

                                <Label Text="Meus Veículos"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#212529"/>

                                <Label Text="Consultar veículos registados"
                                       FontSize="12"
                                       TextColor="#6C757D"/>

                            </VerticalStackLayout>

                            <!-- Seta -->
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="27"
                                   TextColor="#0D6EFD"
                                   VerticalOptions="Center"/>

                        </Grid>
                    </Border>

                    <!-- MINHAS MARCAÇÕES -->
                    <Border x:Name="MarcacoesCard"
                            BackgroundColor="White"
                            Stroke="#E9ECEF"
                            StrokeThickness="1"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="Black"
                            Opacity="0.06"
                            Radius="8"
                            Offset="0,3"/>
                        </Border.Shadow>

                        <!-- CARTÃO INTEIRO CLICÁVEL -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMarcacoesTapped"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="50,*,20"
                              ColumnSpacing="12">

                            <!-- ÍCONE -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#E7F1FF"
                                    StrokeThickness="0"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Label Text="📅"
                                FontSize="23"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                            </Border>

                            <!-- INFORMAÇÕES -->
                            <VerticalStackLayout Grid.Column="1"
                             Spacing="4"
                             VerticalOptions="Center">

                                <Label Text="Minhas Marcações"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#212529"/>

                                <Label Text="Consultar agendamentos"
                                FontSize="12"
                                TextColor="#6C757D"/>

                            </VerticalStackLayout>

                            <!-- SETA -->
                            <Label Grid.Column="2"
                                Text="›"
                            FontSize="27"
                            TextColor="#0D6EFD"
                            VerticalOptions="Center"/>

                        </Grid>
                    </Border>

                  <!-- HISTÓRICO DE REPARAÇÕES -->
<Border x:Name="ReparacoesCard"
        BackgroundColor="White"
        Stroke="#E9ECEF"
        StrokeThickness="1"
        Padding="16">

    <Border.StrokeShape>
        <RoundRectangle CornerRadius="14"/>
    </Border.StrokeShape>

    <Border.Shadow>
        <Shadow Brush="Black"
                Opacity="0.06"
                Radius="8"
                Offset="0,3"/>
    </Border.Shadow>

    <!-- CARTÃO INTEIRO CLICÁVEL -->
    <Border.GestureRecognizers>
        <TapGestureRecognizer
            Tapped="OnReparacoesTapped"/>
    </Border.GestureRecognizers>

    <Grid ColumnDefinitions="50,*,20"
          ColumnSpacing="12">

        <!-- ÍCONE -->
        <Border Grid.Column="0"
                BackgroundColor="#E7F1FF"
                StrokeThickness="0"
                WidthRequest="50"
                HeightRequest="50"
                VerticalOptions="Center">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <Label Text="🔧"
                   FontSize="23"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

        </Border>

        <!-- INFORMAÇÕES -->
        <VerticalStackLayout
            Grid.Column="1"
            Spacing="4"
            VerticalOptions="Center">

            <Label Text="Histórico de Reparações"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="#212529"/>

            <Label Text="Consultar serviços realizados"
                   FontSize="12"
                   TextColor="#6C757D"/>

        </VerticalStackLayout>

        <!-- SETA -->
        <Label Grid.Column="2"
               Text="›"
               FontSize="27"
               TextColor="#0D6EFD"
               VerticalOptions="Center"/>

    </Grid>

</Border>


                    <!-- MEU PERFIL -->
                    <Border x:Name="PerfilCard"
        BackgroundColor="White"
        Stroke="#E9ECEF"
        StrokeThickness="1"
        Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="Black"
                Opacity="0.06"
                Radius="8"
                Offset="0,3"/>
                        </Border.Shadow>

                        <!-- CARTÃO INTEIRO CLICÁVEL -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
            Tapped="OnPerfilTapped"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="50,*,20"
          ColumnSpacing="12">

                            <!-- ÍCONE -->
                            <Border Grid.Column="0"
                BackgroundColor="#E7F1FF"
                StrokeThickness="0"
                WidthRequest="50"
                HeightRequest="50"
                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Label Text="👤"
                   FontSize="23"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

                            </Border>

                            <!-- INFORMAÇÕES -->
                            <VerticalStackLayout Grid.Column="1"
                             Spacing="4"
                             VerticalOptions="Center">

                                <Label Text="Meu Perfil"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#212529"/>

                                <Label Text="Consultar dados pessoais"
                   FontSize="12"
                   TextColor="#6C757D"/>

                            </VerticalStackLayout>

                            <!-- SETA -->
                            <Label Grid.Column="2"
               Text="›"
               FontSize="27"
               TextColor="#0D6EFD"
               VerticalOptions="Center"/>

                        </Grid>

                    </Border>




                </VerticalStackLayout>

                <!-- TERMINAR SESSÃO -->
                <Button x:Name="LogoutButton"
                        Text="Terminar Sessão"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#DC3545"
                        BackgroundColor="White"
                        BorderColor="#DEE2E6"
                        BorderWidth="1"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,8,0,0"
                        Clicked="OnLogoutClicked"/>

                <!-- RODAPÉ -->
                <Label Text="OficinaCET107 • Área do Cliente"
                       FontSize="12"
                       TextColor="#ADB5BD"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,10"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
