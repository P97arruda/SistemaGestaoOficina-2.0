<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OficinaCET107.Mobile.Views.VeiculosPage"
    Title="Meus Veículos"
    BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="20"
          Padding="20">

        <!-- CABEÇALHO -->
        <VerticalStackLayout Spacing="15">

            <Border BackgroundColor="#0D6EFD"
                    StrokeThickness="0"
                    Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label Text="Meus Veículos"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Consulte os veículos associados à sua conta."
                           FontSize="14"
                           TextColor="#E7F1FF"/>

                </VerticalStackLayout>

            </Border>

            <Label Text="Veículos registados"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#212529"/>

        </VerticalStackLayout>

        <!-- LISTA DE VEÍCULOS -->
        <CollectionView
            x:Name="VeiculosCollection"
            Grid.Row="1"
            SelectionMode="None"
            IsVisible="False">

            <!-- LISTA VAZIA -->
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20,50"
                    Spacing="12"
                    HorizontalOptions="Center">

                    <Label Text="🚗"
                           FontSize="42"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Nenhum veículo encontrado"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#212529"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Os seus veículos registados na oficina aparecerão aqui."
                           FontSize="14"
                           TextColor="#6C757D"
                           HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <!-- CARTÕES DOS VEÍCULOS -->
            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border BackgroundColor="White"
                            Stroke="#E9ECEF"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Opacity="0.06"
                                    Radius="8"
                                    Offset="0,3"/>
                        </Border.Shadow>

                        <!-- CARTÃO INTEIRO CLICÁVEL -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnVeiculoTapped"
                                CommandParameter="{Binding Id}"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="50,*,20"
                              ColumnSpacing="12">

                            <!-- ÍCONE -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#E7F1FF"
                                    StrokeThickness="0"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Label Text="🚗"
                                       FontSize="23"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>

                            </Border>

                            <!-- MATRÍCULA DO VEÍCULO -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label Text="{Binding Matricula}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#212529"/>

                                <Label Text="Ver detalhes do veículo"
                                       FontSize="12"
                                       TextColor="#6C757D"/>

                            </VerticalStackLayout>

                            <!-- SETA -->
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="27"
                                   TextColor="#0D6EFD"
                                   VerticalOptions="Center"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- INDICADOR DE CARREGAMENTO -->
        <ActivityIndicator
            x:Name="LoadingIndicator"
            Grid.Row="1"
            Color="#0D6EFD"
            IsRunning="True"
            IsVisible="True"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>

    </Grid>

</ContentPage>
