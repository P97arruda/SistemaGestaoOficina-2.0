<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OficinaCET107.Mobile.Views.PerfilPage"
    Title="Meu Perfil"
    BackgroundColor="#F8F9FA">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- CABEÇALHO -->
            <Border BackgroundColor="#0D6EFD"
                    StrokeThickness="0"
                    Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label Text="Meu Perfil"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Consulte as suas informações pessoais."
                           FontSize="14"
                           TextColor="#E7F1FF"/>

                </VerticalStackLayout>

            </Border>

            <!-- CARREGAMENTO -->
            <ActivityIndicator
                x:Name="LoadingIndicator"
                Color="#0D6EFD"
                IsRunning="False"
                IsVisible="False"
                HorizontalOptions="Center"/>

            <!-- CONTEÚDO DO PERFIL -->
            <VerticalStackLayout
                x:Name="PerfilContent"
                IsVisible="False"
                Spacing="20">

                <!-- FOTOGRAFIA E NOME -->
                <Border BackgroundColor="White"
                        Stroke="#E9ECEF"
                        StrokeThickness="1"
                        Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Opacity="0.06"
                                Radius="8"
                                Offset="0,3"/>
                    </Border.Shadow>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="12">

                        <!-- FOTO DE PERFIL -->
                        <Border BackgroundColor="#E7F1FF"
                                StrokeThickness="0"
                                WidthRequest="100"
                                HeightRequest="100"
                                HorizontalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="50"/>
                            </Border.StrokeShape>

                            <Grid>

                                <!-- AVATAR PADRÃO -->
                                <Label x:Name="AvatarPadrao"
                                       Text="👤"
                                       FontSize="48"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="True"/>

                                <!-- FOTO DO CLIENTE -->
                                <Image x:Name="FotoPerfilImage"
                                       WidthRequest="100"
                                       HeightRequest="100"
                                       Aspect="AspectFill"
                                       IsVisible="False">

                                    <Image.Clip>
                                        <EllipseGeometry
                                            Center="50,50"
                                            RadiusX="50"
                                            RadiusY="50"/>
                                    </Image.Clip>

                                </Image>

                            </Grid>

                        </Border>

                        <!-- NOME COMPLETO -->
                        <Label x:Name="NomeCompletoLabel"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#212529"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="Cliente da oficina"
                               FontSize="14"
                               TextColor="#6C757D"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                </Border>

                <!-- INFORMAÇÕES PESSOAIS -->
                <Label Text="Informações pessoais"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#212529"/>

                <Border BackgroundColor="White"
                        Stroke="#E9ECEF"
                        StrokeThickness="1"
                        Padding="20">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Opacity="0.06"
                                Radius="8"
                                Offset="0,3"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <!-- NOME -->
                        <VerticalStackLayout Spacing="5">

                            <Label Text="Nome completo"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="NomeLabel"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- NIF -->
                        <VerticalStackLayout Spacing="5">

                            <Label Text="NIF"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="NifLabel"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- EMAIL -->
                        <VerticalStackLayout Spacing="5">

                            <Label Text="Email"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="EmailLabel"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#212529"
                                   LineBreakMode="WordWrap"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#E9ECEF"/>

                        <!-- TELEFONE -->
                        <VerticalStackLayout Spacing="5">

                            <Label Text="Telefone"
                                   FontSize="13"
                                   TextColor="#6C757D"/>

                            <Label x:Name="TelefoneLabel"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- INFORMAÇÃO -->
                <Label
                    Text="Informações associadas à sua conta de cliente."
                    FontSize="12"
                    TextColor="#6C757D"
                    HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
