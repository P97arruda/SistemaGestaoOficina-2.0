
@model SistemaGestaoOficina.Data.Entities.Peca

@{
    ViewData["Title"] = "Criar Peça";
}

<div class="container mt-4">

    <h2 class="mb-4">Criar Peça</h2>

    <div class="row">
        <div class="col-md-6">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Ex: Filtro de óleo" />

                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Preco" class="form-label"></label>

                    <input asp-for="Preco"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0.01" />

                    <span asp-validation-for="Preco"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Ativa"
                           class="form-check-input" />

                    <label asp-for="Ativa"
                           class="form-check-label"></label>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        Guardar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Voltar
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
