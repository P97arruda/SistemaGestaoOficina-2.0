
@model SistemaGestaoOficina.Data.Entities.Peca

@{
    ViewData["Title"] = "Editar Peça";
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Editar Peça</h2>

        <p class="text-muted mb-0">
            Atualize as informações da peça registada na oficina.
        </p>
    </div>

    <!-- FORMULÁRIO -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-controller="Pecas"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- NOME -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nome" class="form-label">
                            Nome da Peça
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               placeholder="Ex: Filtro de óleo" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- PREÇO -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Preco" class="form-label">
                            Preço (€)
                        </label>

                        <input asp-for="Preco"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01" />

                        <span asp-validation-for="Preco"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <!-- ESTADO -->
                <div class="form-check mb-4">
                    <input asp-for="Ativa"
                           class="form-check-input" />

                    <label asp-for="Ativa"
                           class="form-check-label">
                        Peça Ativa
                    </label>
                </div>

                <!-- BOTÕES -->
                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar Alterações
                    </button>

                    <a asp-controller="Pecas"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
