@model IEnumerable<SistemaGestaoOficina.Data.Entities.Peca>

@{
    ViewData["Title"] = "Gestão de Peças";
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Gestão de Peças</h2>
            <p class="text-muted mb-0">
                Consulte e gira as peças registadas na OficinaCET107.
            </p>
        </div>

        <a asp-controller="Pecas"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Criar Peça
        </a>

    </div>

    <!-- MENSAGENS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <!-- TABELA -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-3">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Preço (€)</th>
                            <th>Estado</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var peca in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @peca.Nome
                                </td>

                                <td>
                                    @peca.Preco.ToString("N2") €
                                </td>

                                <td>
                                    @if (peca.Ativa)
                                    {
                                        <span class="badge bg-success">
                                            Ativa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inativa
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <div class="d-inline-flex align-items-center gap-2">

                                        <!-- APAGAR -->
                                        <form asp-controller="Pecas"
                                              asp-action="Delete"
                                              asp-route-id="@peca.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Tem a certeza de que deseja apagar esta peça?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Apagar
                                            </button>

                                        </form>

                                        <!-- EDITAR -->
                                        <a asp-controller="Pecas"
                                           asp-action="Edit"
                                           asp-route-id="@peca.Id"
                                           class="btn btn-sm btn-warning">
                                            Editar
                                        </a>

                                        <!-- DETALHES -->
                                        <a asp-controller="Pecas"
                                           asp-action="Details"
                                           asp-route-id="@peca.Id"
                                           class="btn btn-sm btn-info text-white">
                                            Detalhes
                                        </a>

                                    </div>

                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-4">
                                    Nenhuma peça registada.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
