
@model SistemaGestaoOficina.Data.Entities.Peca

@{
    ViewData["Title"] = "Detalhes da Peça";
}

<div class="container mt-4">

    <h2 class="mb-4">Detalhes da Peça</h2>

    <div class="card mb-4">
        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Nome
                </dt>
                <dd class="col-sm-9">
                    @Model.Nome
                </dd>

                <dt class="col-sm-3">
                    Preço
                </dt>
                <dd class="col-sm-9">
                    @Model.Preco.ToString("N2") €
                </dd>

                <dt class="col-sm-3">
                    Estado
                </dt>
                <dd class="col-sm-9">
                    @if (Model.Ativa)
                    {
                        <span class="badge bg-success">Ativa</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inativa</span>
                    }
                </dd>

            </dl>

        </div>
    </div>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Voltar
    </a>

</div>
