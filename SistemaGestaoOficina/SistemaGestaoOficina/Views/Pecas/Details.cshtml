
@model SistemaGestaoOficina.Data.Entities.Peca

@{
    ViewData["Title"] = "Detalhes da Peça";
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Detalhes da Peça</h2>

        <p class="text-muted mb-0">
            Consulte as informações da peça registada.
        </p>
    </div>

    <!-- CARTÃO DE DETALHES -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                Informações da Peça
            </h5>

            <hr />

            <dl class="row mb-0">

                <dt class="col-sm-3">
                    Nome
                </dt>
                <dd class="col-sm-9">
                    @Model.Nome
                </dd>

                <dt class="col-sm-3">
                    Preço
                </dt>
                <dd class="col-sm-9">
                    @Model.Preco.ToString("N2") €
                </dd>

                <dt class="col-sm-3">
                    Estado
                </dt>
                <dd class="col-sm-9">
                    @if (Model.Ativa)
                    {
                        <span class="badge bg-success">
                            Ativa
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inativa
                        </span>
                    }
                </dd>

            </dl>

        </div>
    </div>

    <!-- BOTÕES -->
    <div class="d-flex gap-2 mt-4">

        <a asp-controller="Pecas"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Editar
        </a>

        <a asp-controller="Pecas"
           asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>

    </div>

</div>
