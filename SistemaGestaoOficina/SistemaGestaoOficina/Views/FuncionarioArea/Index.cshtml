@{
    ViewData["Title"] = "Área do Funcionário";
}

<div class="container mt-5">

    <div class="mb-4">
        <h2 class="fw-bold">Área do Funcionário</h2>
        <p class="text-muted">
            Gestão dos serviços e atendimento da oficina.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">👥 Clientes</h5>
                    <p class="card-text text-muted">
                        Consultar clientes e gerir os seus dados.
                    </p>
                    <button class="btn btn-primary" disabled>
                        Gerir Clientes
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">🚘 Veículos</h5>
                    <p class="card-text text-muted">
                        Consultar e gerir os veículos dos clientes.
                    </p>
                    <button class="btn btn-primary" disabled>
                        Gerir Veículos
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">📅 Marcações</h5>
                    <p class="card-text text-muted">
                        Criar e acompanhar as marcações da oficina.
                    </p>
                    <button class="btn btn-primary" disabled>
                        Gerir Marcações
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">🔧 Serviços</h5>
                    <p class="card-text text-muted">
                        Consultar serviços e histórico das reparações.
                    </p>
                    <button class="btn btn-primary" disabled>
                        Ver Serviços
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">💶 Faturação</h5>
                    <p class="card-text text-muted">
                        Gerir a faturação dos serviços realizados.
                    </p>
                    <button class="btn btn-primary" disabled>
                        Gerir Faturação
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">👤 Meu Perfil</h5>
                    <p class="card-text text-muted">
                        Consultar e alterar os dados da sua conta.
                    </p>
                    <button class="btn btn-outline-secondary" disabled>
                        Meu Perfil
                    </button>
                </div>
            </div>
        </div>

    </div>

</div>
