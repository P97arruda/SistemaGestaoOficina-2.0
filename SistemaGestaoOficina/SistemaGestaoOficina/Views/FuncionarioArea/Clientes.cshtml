@model IEnumerable<SistemaGestaoOficina.Data.Entities.User>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Clientes</h2>
            <p class="text-muted mb-0">
                Clientes registados na oficina.
            </p>
        </div>

        <div>
            <a asp-controller="FuncionarioArea"
               asp-action="CreateCliente"
               class="btn btn-primary">
                + Criar Cliente
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Voltar
            </a>
        </div>

    </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Voltar
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Contacto</th>
                            <th>NIF</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var cliente in Model)
                        {
                            <tr>
                                <td>@cliente.FullName</td>
                                <td>@cliente.Email</td>
                                <td>@cliente.PhoneNumber</td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(cliente.NIF))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        @cliente.NIF
                                    }
                                </td>

                              <td>
                                    <a asp-controller="FuncionarioArea"
                                    asp-action="EditCliente"
                                    asp-route-id="@cliente.Id"
                                    class="btn btn-sm btn-warning">
                                    Editar
                                    </a>

                                    <form asp-controller="FuncionarioArea"
                                    asp-action="DeleteCliente"
                                    asp-route-id="@cliente.Id"
                                    method="post"
                                    class="d-inline"
                                    onsubmit="return confirm('Tem a certeza que deseja apagar este cliente?');">

                                    <button type="submit" class="btn btn-sm btn-danger">
                                    Apagar
                                    </button>
                                    </form>

                                    <button class="btn btn-sm btn-outline-primary" disabled>
                                    Veículos
                                    </button>
                             </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>