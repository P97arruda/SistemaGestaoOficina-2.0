
@model SistemaGestaoOficina.Models.MarcacaoViewModel

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Criar Marcação";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<style>
    .flatpickr-calendar {
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
    }

    .flatpickr-day.selected,
    .flatpickr-day.selected:hover {
        background: var(--bs-primary);
        border-color: var(--bs-primary);
        color: white;
    }

    .flatpickr-day.today {
        border-color: var(--bs-primary);
    }

    .flatpickr-day:hover {
        background: #e9ecef;
    }

    .flatpickr-day.flatpickr-disabled {
        color: #ced4da;
        cursor: not-allowed;
    }

    .campo-calendario {
        position: relative;
    }

    .campo-calendario .form-control {
        padding-right: 45px;
        cursor: pointer;
    }

    .icone-calendario {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--bs-primary);
        cursor: pointer;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .horario-btn {
        min-width: 85px;
    }

    /* CAMPOS COM PESQUISA AUTOMÁTICA */
    .campo-pesquisa {
        position: relative;
    }

    .pesquisa-resultados {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        z-index: 1050;
        max-height: 220px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    }

    .pesquisa-resultado {
        display: block;
        width: 100%;
        padding: 10px 12px;
        border: 0;
        border-bottom: 1px solid #f1f3f5;
        background: #fff;
        text-align: left;
        font-size: 14px;
        cursor: pointer;
    }

    .pesquisa-resultado:hover,
    .pesquisa-resultado:focus {
        background: #eff6ff;
        color: #0d6efd;
    }
</style>

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Nova Marcação</h2>

        <p class="text-muted">
            Registe uma nova marcação na OficinaCET107.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-controller="Marcacoes"
                  asp-action="Create"
                  method="post"
                  id="formMarcacao">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <!-- CLIENTE -->
                    <div class="col-md-6 mb-3">

                        <label for="pesquisaCliente"
                               class="form-label">
                            Cliente
                        </label>

                        <div class="campo-pesquisa"
                             id="areaPesquisaCliente">

                            <input type="text"
                                   id="pesquisaCliente"
                                   class="form-control"
                                   placeholder="Escreva o nome do cliente..."
                                   autocomplete="off"
                                   aria-autocomplete="list"
                                   aria-controls="resultadosCliente" />

                            <div id="resultadosCliente"
                                 class="pesquisa-resultados d-none"
                                 role="listbox"></div>

                        </div>

                        <select asp-for="UserId"
                                asp-items="ViewBag.Clientes"
                                id="UserId"
                                class="d-none"
                                tabindex="-1"
                                aria-hidden="true">

                            <option value="">
                                Selecione o cliente
                            </option>

                        </select>

                        <span asp-validation-for="UserId"
                              class="text-danger"></span>
                    </div>

                    <!-- VEÍCULO -->
                    <div class="col-md-6 mb-3">

                        <label for="pesquisaVeiculo"
                               class="form-label">
                            Veículo
                        </label>

                        <div class="campo-pesquisa"
                             id="areaPesquisaVeiculo">

                            <input type="text"
                                   id="pesquisaVeiculo"
                                   class="form-control"
                                   placeholder="Selecione primeiro um cliente"
                                   autocomplete="off"
                                   aria-autocomplete="list"
                                   aria-controls="resultadosVeiculo"
                                   disabled />

                            <div id="resultadosVeiculo"
                                 class="pesquisa-resultados d-none"
                                 role="listbox"></div>

                        </div>

                        <select asp-for="VeiculoId"
                                id="VeiculoId"
                                class="d-none"
                                data-selected="@Model?.VeiculoId"
                                tabindex="-1"
                                aria-hidden="true"
                                disabled>

                            <option value="">
                                Selecione o veículo
                            </option>

                        </select>

                        <span asp-validation-for="VeiculoId"
                              class="text-danger"></span>
                    </div>

                    <!-- MECÂNICO -->
                    <div class="col-md-6 mb-3">

                        <label for="pesquisaMecanico"
                               class="form-label">
                            Mecânico
                        </label>

                        <div class="campo-pesquisa"
                             id="areaPesquisaMecanico">

                            <input type="text"
                                   id="pesquisaMecanico"
                                   class="form-control"
                                   placeholder="Escreva o nome do mecânico..."
                                   autocomplete="off"
                                   aria-autocomplete="list"
                                   aria-controls="resultadosMecanico" />

                            <div id="resultadosMecanico"
                                 class="pesquisa-resultados d-none"
                                 role="listbox"></div>

                        </div>

                        <select asp-for="MecanicoId"
                                asp-items="ViewBag.Mecanicos"
                                id="MecanicoId"
                                class="d-none"
                                tabindex="-1"
                                aria-hidden="true">

                            <option value="">
                                Selecione o mecânico
                            </option>

                        </select>

                        <span asp-validation-for="MecanicoId"
                              class="text-danger"></span>
                    </div>

                    <!-- TIPO DE SERVIÇO -->
                    <div class="col-md-6 mb-3">

                        <label for="pesquisaTipoServico"
                               class="form-label">
                            Tipo de Serviço
                        </label>

                        <div class="campo-pesquisa"
                             id="areaPesquisaTipoServico">

                            <input type="text"
                                   id="pesquisaTipoServico"
                                   class="form-control"
                                   placeholder="Escreva o tipo de serviço..."
                                   autocomplete="off"
                                   aria-autocomplete="list"
                                   aria-controls="resultadosTipoServico" />

                            <div id="resultadosTipoServico"
                                 class="pesquisa-resultados d-none"
                                 role="listbox"></div>

                        </div>

                        <select asp-for="TipoServico"
                                asp-items="ViewBag.TiposServico"
                                id="TipoServico"
                                class="d-none"
                                tabindex="-1"
                                aria-hidden="true">

                            <option value="">
                                Selecione o tipo de serviço
                            </option>

                        </select>

                        <span asp-validation-for="TipoServico"
                              class="text-danger"></span>
                    </div>

                </div>

                <!-- CALENDÁRIO E HORÁRIOS -->
                <div class="mt-3 mb-4">

                    <h5 class="fw-bold mb-3">
                        Escolha a data e o horário
                    </h5>

                    <div class="row">

                        <!-- DATA -->
                        <div class="col-md-5 mb-3">

                            <label for="dataMarcacao"
                                   class="form-label">
                                Data da Marcação
                            </label>

                            <div class="campo-calendario">

                                <input type="text"
                                       id="dataMarcacao"
                                       class="form-control bg-white"
                                       placeholder="Selecione uma data"
                                       autocomplete="off"
                                       readonly
                                       required />

                                <span id="iconeCalendario"
                                      class="icone-calendario"
                                      title="Abrir calendário">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="18"
                                         height="18"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <rect x="3" y="5"
                                              width="18" height="16"
                                              rx="2" />

                                        <path d="M16 3v4" />
                                        <path d="M8 3v4" />
                                        <path d="M3 10h18" />

                                    </svg>

                                </span>
                            </div>

                            <small class="text-muted">
                                Escolha uma data no calendário.
                            </small>
                        </div>

                        <!-- HORÁRIOS -->
                        <div class="col-md-7 mb-3">

                            <label class="form-label">
                                Horários disponíveis
                            </label>

                            <div id="horariosDisponiveis"
                                 class="d-flex flex-wrap gap-2">

                                <p class="text-muted mb-0">
                                    Selecione primeiro uma data.
                                </p>

                            </div>
                        </div>

                    </div>

                    <!-- DATA ENVIADA AO CONTROLLER -->
                    <input asp-for="DataHora"
                           type="hidden"
                           id="DataHora" />

                    <span asp-validation-for="DataHora"
                          class="text-danger"></span>

                </div>

                <!-- BOTÕES -->
                <div class="d-flex gap-2 mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar Marcação
                    </button>

                    <a asp-controller="Marcacoes"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/pt.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // CAMPOS DO FORMULÁRIO
            const clienteSelect =
                document.getElementById("UserId");

            const veiculoSelect =
                document.getElementById("VeiculoId");

            const mecanicoSelect =
                document.getElementById("MecanicoId");

            const tipoServicoSelect =
                document.getElementById("TipoServico");

            const pesquisaVeiculo =
                document.getElementById("pesquisaVeiculo");

            const veiculoInicial =
                veiculoSelect.dataset.selected;

            let pedidoVeiculos = 0;

            // NORMALIZAR TEXTO PARA PESQUISAR
            // IGNORANDO MAIÚSCULAS E ACENTOS
            function normalizar(texto) {
                return texto.normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLowerCase();
            }

            // PESQUISA AUTOMÁTICA PARA QUALQUER SELECT
            function configurarPesquisa(
                inputId,
                selectId,
                resultadosId,
                areaId,
                mensagemVazia
            ) {
                const input =
                    document.getElementById(inputId);

                const select =
                    document.getElementById(selectId);

                const resultados =
                    document.getElementById(resultadosId);

                const area =
                    document.getElementById(areaId);

                // FECHAR LISTA
                function fecharResultados() {
                    resultados.classList.add("d-none");
                    resultados.replaceChildren();
                    input.setAttribute("aria-expanded", "false");
                }

                // MOSTRAR O TEXTO DA OPÇÃO SELECIONADA
                function sincronizarTexto() {

                    const opcao =
                        select.options[select.selectedIndex];

                    if (select.value && opcao) {
                        input.value = opcao.textContent.trim();
                    } else {
                        input.value = "";
                    }
                }

                // APRESENTAR RESULTADOS FILTRADOS
                function mostrarResultados() {

                    resultados.replaceChildren();

                    const busca =
                        normalizar(input.value.trim());

                    // NÃO MOSTRAR NADA COM O CAMPO VAZIO
                    if (busca.length === 0) {
                        fecharResultados();
                        return;
                    }

                    // OBTER OPÇÕES ATUAIS DO SELECT
                    const opcoes = Array.from(select.options)
                        .filter(opcao => opcao.value);

                    // PESQUISAR EM QUALQUER PARTE DO NOME
                    const encontrados = opcoes
                        .filter(opcao =>
                            normalizar(
                                opcao.textContent.trim()
                            ).includes(busca))
                        .slice(0, 8);

                    if (encontrados.length === 0) {

                        const aviso =
                            document.createElement("div");

                        aviso.className =
                            "text-muted small p-3";

                        aviso.textContent =
                            mensagemVazia;

                        resultados.appendChild(aviso);
                    }

                    encontrados.forEach(opcao => {

                        const botao =
                            document.createElement("button");

                        botao.type = "button";
                        botao.className = "pesquisa-resultado";
                        botao.setAttribute("role", "option");
                        botao.textContent =
                            opcao.textContent.trim();

                        botao.addEventListener("click", function () {

                            // SELECIONAR O VALOR REAL
                            select.value = opcao.value;

                            // MOSTRAR O TEXTO SELECIONADO
                            input.value = opcao.textContent.trim();

                            fecharResultados();

                            // DISPARAR A ALTERAÇÃO
                            select.dispatchEvent(
                                new Event("change", {
                                    bubbles: true
                                })
                            );
                        });

                        resultados.appendChild(botao);
                    });

                    resultados.classList.remove("d-none");
                    input.setAttribute("aria-expanded", "true");
                }

                // PESQUISAR ENQUANTO ESCREVE
                input.addEventListener("input", function () {

                    // LIMPAR SELEÇÃO ANTERIOR
                    if (select.value) {

                        select.value = "";

                        select.dispatchEvent(
                            new Event("change", {
                                bubbles: true
                            })
                        );
                    }

                    mostrarResultados();
                });

                // NÃO MOSTRAR LISTA NO CAMPO VAZIO
                input.addEventListener("focus", function () {

                    if (input.value.trim().length === 0) {
                        fecharResultados();
                        return;
                    }

                    if (!select.value) {
                        mostrarResultados();
                    }
                });

                // TECLAS ENTER E ESCAPE
                input.addEventListener("keydown", function (event) {

                    if (event.key === "Escape") {
                        fecharResultados();
                    }

                    if (event.key === "Enter") {

                        event.preventDefault();

                        const primeiro =
                            resultados.querySelector("button");

                        if (primeiro &&
                            !resultados.classList.contains("d-none")) {
                            primeiro.click();
                        }
                    }
                });

                // FECHAR AO CLICAR FORA DO CAMPO
                document.addEventListener("click", function (event) {

                    if (!area.contains(event.target)) {
                        fecharResultados();
                    }
                });

                return {
                    sincronizarTexto,
                    fecharResultados
                };
            }

            // CONFIGURAR PESQUISA DE CLIENTES
            const pesquisaClientes = configurarPesquisa(
                "pesquisaCliente",
                "UserId",
                "resultadosCliente",
                "areaPesquisaCliente",
                "Nenhum cliente encontrado."
            );

            // CONFIGURAR PESQUISA DE VEÍCULOS
            const pesquisaVeiculos = configurarPesquisa(
                "pesquisaVeiculo",
                "VeiculoId",
                "resultadosVeiculo",
                "areaPesquisaVeiculo",
                "Nenhum veículo encontrado."
            );

            // CONFIGURAR PESQUISA DE MECÂNICOS
            const pesquisaMecanicos = configurarPesquisa(
                "pesquisaMecanico",
                "MecanicoId",
                "resultadosMecanico",
                "areaPesquisaMecanico",
                "Nenhum mecânico encontrado."
            );

            // CONFIGURAR PESQUISA DE SERVIÇOS
            const pesquisaServicos = configurarPesquisa(
                "pesquisaTipoServico",
                "TipoServico",
                "resultadosTipoServico",
                "areaPesquisaTipoServico",
                "Nenhum serviço encontrado."
            );

            // CARREGAR VEÍCULOS DO CLIENTE
            async function carregarVeiculos(
                clienteId,
                veiculoSelecionado = ""
            ) {
                const pedidoAtual = ++pedidoVeiculos;

                // LIMPAR VEÍCULO ANTERIOR
                veiculoSelect.disabled = true;
                pesquisaVeiculo.disabled = true;
                pesquisaVeiculo.value = "";
                pesquisaVeiculos.fecharResultados();

                veiculoSelect.replaceChildren();

                const opcao =
                    document.createElement("option");

                opcao.value = "";

                opcao.textContent = clienteId
                    ? "A carregar veículos..."
                    : "Selecione primeiro um cliente";

                veiculoSelect.appendChild(opcao);

                pesquisaVeiculo.placeholder = clienteId
                    ? "A carregar veículos..."
                    : "Selecione primeiro um cliente";

                if (!clienteId) {
                    return;
                }

                try {
                    const url =
                        '@Url.Action("GetVeiculosPorCliente", "Marcacoes")'
                        + "?userId=" + encodeURIComponent(clienteId);

                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error("Erro ao carregar veículos.");
                    }

                    const veiculos = await response.json();

                    // IGNORAR RESPOSTAS DE CLIENTES ANTERIORES
                    if (pedidoAtual !== pedidoVeiculos) {
                        return;
                    }

                    veiculoSelect.replaceChildren();

                    const primeiraOpcao =
                        document.createElement("option");

                    primeiraOpcao.value = "";

                    primeiraOpcao.textContent =
                        veiculos.length > 0
                            ? "Selecione o veículo"
                            : "Este cliente não possui veículos registados";

                    veiculoSelect.appendChild(primeiraOpcao);

                    veiculos.forEach(function (veiculo) {

                        const option =
                            document.createElement("option");

                        option.value = veiculo.id;
                        option.textContent = veiculo.texto;

                        veiculoSelect.appendChild(option);
                    });

                    const possuiVeiculos =
                        veiculos.length > 0;

                    veiculoSelect.disabled = !possuiVeiculos;
                    pesquisaVeiculo.disabled = !possuiVeiculos;

                    pesquisaVeiculo.placeholder = possuiVeiculos
                        ? "Pesquisar matrícula, marca ou modelo..."
                        : "Este cliente não possui veículos registados";

                    // RECUPERAR VEÍCULO APÓS ERRO DE VALIDAÇÃO
                    if (veiculoSelecionado) {

                        const existe = veiculos.some(
                            v => String(v.id) ===
                                 String(veiculoSelecionado)
                        );

                        if (existe) {
                            veiculoSelect.value =
                                String(veiculoSelecionado);

                            pesquisaVeiculos.sincronizarTexto();
                        }
                    }

                } catch (error) {

                    if (pedidoAtual !== pedidoVeiculos) {
                        return;
                    }

                    veiculoSelect.replaceChildren();

                    const opcaoErro =
                        document.createElement("option");

                    opcaoErro.value = "";
                    opcaoErro.textContent =
                        "Erro ao carregar veículos";

                    veiculoSelect.appendChild(opcaoErro);

                    veiculoSelect.disabled = true;
                    pesquisaVeiculo.disabled = true;

                    pesquisaVeiculo.placeholder =
                        "Erro ao carregar veículos";

                    console.error(error);
                }
            }

            // ALTERAÇÃO DO CLIENTE
            clienteSelect.addEventListener("change", function () {

                carregarVeiculos(this.value);
            });

            // RECUPERAR SELEÇÕES APÓS ERROS
            pesquisaClientes.sincronizarTexto();
            pesquisaMecanicos.sincronizarTexto();
            pesquisaServicos.sincronizarTexto();

            if (clienteSelect.value) {

                carregarVeiculos(
                    clienteSelect.value,
                    veiculoInicial
                );
            }

            // CALENDÁRIO
            const dataInput =
                document.getElementById("dataMarcacao");

            const horariosContainer =
                document.getElementById("horariosDisponiveis");

            const dataHoraInput =
                document.getElementById("DataHora");

            const formulario =
                document.getElementById("formMarcacao");

            const iconeCalendario =
                document.getElementById("iconeCalendario");

            const calendario = flatpickr(dataInput, {

                locale: "pt",
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                minDate: "today",
                maxDate: "2030-12-31",
                disableMobile: true,

                disable: [
                    function (date) {
                        return date.getDay() === 0;
                    }
                ],

                onChange: function () {
                    mostrarHorarios();
                }
            });

            iconeCalendario.addEventListener("click", function () {
                calendario.open();
            });

            // MOSTRAR HORÁRIOS
            function mostrarHorarios() {

                horariosContainer.innerHTML = "";
                dataHoraInput.value = "";

                if (!dataInput.value) {

                    horariosContainer.innerHTML =
                        '<p class="text-muted">Selecione uma data.</p>';

                    return;
                }

                const data = new Date(
                    dataInput.value + "T12:00:00"
                );

                const diaSemana = data.getDay();

                if (diaSemana === 0) {

                    horariosContainer.innerHTML =
                        '<p class="text-danger">A oficina está encerrada aos domingos.</p>';

                    return;
                }

                // SEGUNDA A SEXTA: 09:00 ÀS 18:00
                // SÁBADO: 09:00 ÀS 13:00
                const horaFinal = diaSemana === 6 ? 13 : 18;

                let horariosAdicionados = 0;

                for (let hora = 9; hora < horaFinal; hora++) {

                    const horario =
                        String(hora).padStart(2, "0") + ":00";

                    const dataHorario = new Date(
                        dataInput.value + "T" + horario + ":00"
                    );

                    if (dataHorario <= new Date()) {
                        continue;
                    }

                    const botao =
                        document.createElement("button");

                    botao.type = "button";

                    botao.className =
                        "btn btn-outline-primary horario-btn";

                    botao.textContent = horario;

                    botao.addEventListener("click", function () {

                        const botoes =
                            horariosContainer.querySelectorAll("button");

                        botoes.forEach(function (btn) {

                            btn.classList.remove("btn-primary");
                            btn.classList.add("btn-outline-primary");
                        });

                        botao.classList.remove("btn-outline-primary");
                        botao.classList.add("btn-primary");

                        dataHoraInput.value =
                            dataInput.value + "T" + horario;
                    });

                    horariosContainer.appendChild(botao);
                    horariosAdicionados++;
                }

                if (horariosAdicionados === 0) {

                    horariosContainer.innerHTML =
                        '<p class="text-muted">Não existem horários futuros para esta data.</p>';
                }
            }

            // VALIDAÇÃO DO FORMULÁRIO
            formulario.addEventListener("submit", function (event) {

                // VERIFICAR TODAS AS SELEÇÕES
                if (!clienteSelect.value ||
                    !veiculoSelect.value ||
                    !mecanicoSelect.value ||
                    !tipoServicoSelect.value) {

                    event.preventDefault();

                    alert(
                        "Selecione o cliente, veículo, mecânico e tipo de serviço."
                    );

                    return;
                }

                if (!dataHoraInput.value) {

                    event.preventDefault();

                    alert(
                        "Selecione uma data e um horário para a marcação."
                    );

                    return;
                }

                const dataSelecionada = new Date(
                    dataHoraInput.value + ":00"
                );

                if (dataSelecionada <= new Date()) {

                    event.preventDefault();

                    alert(
                        "A data e o horário devem ser futuros."
                    );
                }
            });

        });
    </script>
}
