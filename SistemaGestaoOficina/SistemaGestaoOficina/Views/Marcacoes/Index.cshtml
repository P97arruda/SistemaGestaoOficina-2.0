
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Marcacao>

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Marcações";
}

<div class="container py-4">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Marcações</h2>

            <p class="text-muted mb-0">
                Consulte e gira as marcações registadas na OficinaCET107.
            </p>
        </div>

        <a asp-controller="Marcacoes"
           asp-action="Create"
           class="btn btn-primary">
            + Criar Marcação
        </a>
    </div>

    <!-- Mensagens -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Tabela de Marcações -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Veículo</th>
                            <th>Mecânico</th>
                            <th>Tipo de Serviço</th>
                            <th>Data e Hora</th>
                            <th>Estado</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var marcacao in Model)
                            {
                                <tr>
                                    <!-- Cliente -->
                                    <td>
                                        @marcacao.User?.FullName
                                    </td>

                                    <!-- Veículo -->
                                    <td>
                                        @marcacao.Veiculo?.Marca
                                        @marcacao.Veiculo?.Modelo -
                                        @marcacao.Veiculo?.Matricula
                                    </td>

                                    <!-- Mecânico -->
                                    <td>
                                        @marcacao.Mecanico?.Nome
                                    </td>

                                    <!-- Tipo de Serviço -->
                                    <td>
                                        @marcacao.TipoServico
                                    </td>

                                    <!-- Data e Hora -->
                                    <td>
                                        @marcacao.DataHora.ToString("dd/MM/yyyy - HH:mm")
                                    </td>

                                    <!-- Estado -->
                                    <td>
                                        @if (marcacao.Estado == "Cancelada")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelada
                                            </span>
                                        }
                                        else if (marcacao.Estado == "Concluída")
                                        {
                                            <span class="badge bg-success">
                                                Concluída
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                @marcacao.Estado
                                            </span>
                                        }
                                    </td>

                                    <!-- Ações -->
                                    <td class="text-nowrap">

                                        <!-- Detalhes -->
                                        <a asp-controller="Marcacoes"
                                           asp-action="Details"
                                           asp-route-id="@marcacao.Id"
                                           class="btn btn-sm btn-info text-white">
                                            Detalhes
                                        </a>

                                        @if (marcacao.Estado == "Agendada")
                                        {
                                            <!-- Editar -->
                                            <a asp-controller="Marcacoes"
                                               asp-action="Edit"
                                               asp-route-id="@marcacao.Id"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            <!-- Cancelar -->
                                            <form asp-controller="Marcacoes"
                                                  asp-action="Cancelar"
                                                  asp-route-id="@marcacao.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Tem a certeza de que deseja cancelar esta marcação?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Cancelar
                                                </button>
                                            </form>

                                            <!-- Apagar -->
                                            <form asp-controller="Marcacoes"
                                                  asp-action="Delete"
                                                  asp-route-id="@marcacao.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Tem a certeza de que deseja apagar definitivamente esta marcação? Esta operação não pode ser desfeita.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Apagar
                                                </button>
                                            </form>
                                        }

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    Ainda não existem marcações registadas.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

    <!-- Voltar ao Painel da Rececionista -->
    <div class="mt-3">
     <a asp-controller="RececionistaArea"
       asp-action="Index"
       class="btn btn-secondary">
        Voltar
     </a>
    </div>

</div>
