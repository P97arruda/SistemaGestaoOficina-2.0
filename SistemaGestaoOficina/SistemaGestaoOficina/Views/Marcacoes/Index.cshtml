
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Marcacao>

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Marcações";

    var marcacoes = Model?.ToList()
        ?? new List<SistemaGestaoOficina.Data.Entities.Marcacao>();

    var emCurso = marcacoes
        .Where(m => m.Estado == "Agendada")
        .ToList();

    var concluidas = marcacoes
        .Where(m => m.Estado == "Concluída")
        .ToList();

    var canceladas = marcacoes
        .Where(m => m.Estado == "Cancelada")
        .ToList();
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar-check text-primary me-2"></i>
                Marcações
            </h2>

            <p class="text-muted mb-0">
                Acompanhe e faça a gestão das marcações da oficina.
            </p>
        </div>

        <a asp-controller="Marcacoes"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Criar Marcação
        </a>

    </div>

    <!-- MENSAGENS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <!-- FILTROS E PESQUISA -->
    <div class="row align-items-center g-3 mb-4">

        <div class="col-lg-7">
            <div class="d-flex gap-2 flex-wrap">

                <!-- EM CURSO -->
                <button type="button"
                        class="btn btn-primary filtro-marcacao"
                        data-filtro="curso">

                    <i class="bi bi-clock me-1"></i>
                    Em Curso (@emCurso.Count)
                </button>

                <!-- CONCLUÍDAS -->
                <button type="button"
                        class="btn btn-outline-primary filtro-marcacao"
                        data-filtro="concluida">

                    <i class="bi bi-check-circle me-1"></i>
                    Concluídas (@concluidas.Count)
                </button>

                <!-- CANCELADAS -->
                <button type="button"
                        class="btn btn-outline-primary filtro-marcacao"
                        data-filtro="cancelada">

                    <i class="bi bi-x-circle me-1"></i>
                    Canceladas (@canceladas.Count)
                </button>

            </div>
        </div>

        <div class="col-lg-5">
            <div class="input-group">

                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>

                <input type="search"
                       id="pesquisaMarcacoes"
                       class="form-control"
                       placeholder="Pesquisar cliente, veículo ou serviço..." />

            </div>
        </div>

    </div>

    <!-- MARCAÇÕES EM CURSO -->
    <div id="tabelaEmCurso"
         class="card border-0 shadow-sm tabela-marcacoes">

        <div class="card-body p-3">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>Veículo</th>
                            <th>Mecânico</th>
                            <th>Tipo de Serviço</th>
                            <th>Data e Hora</th>
                            <th>Estado</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var marcacao in emCurso)
                        {
                            var pesquisa = $"{marcacao.User?.FullName} " +
                                $"{marcacao.Veiculo?.Marca} " +
                                $"{marcacao.Veiculo?.Modelo} " +
                                $"{marcacao.Veiculo?.Matricula} " +
                                $"{marcacao.Mecanico?.Nome} " +
                                $"{marcacao.TipoServico}";

                            <tr class="linha-marcacao"
                                data-pesquisa="@pesquisa.ToLowerInvariant()">

                                <td class="fw-semibold">
                                    @marcacao.User?.FullName
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @marcacao.Veiculo?.Marca
                                        @marcacao.Veiculo?.Modelo
                                    </div>

                                    <small class="text-muted">
                                        @marcacao.Veiculo?.Matricula
                                    </small>
                                </td>

                                <td>
                                    @marcacao.Mecanico?.Nome
                                </td>

                                <td>
                                    @marcacao.TipoServico
                                </td>

                                <td>
                                    @marcacao.DataHora.ToString("dd/MM/yyyy - HH:mm")
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        <i class="bi bi-clock me-1"></i>
                                        Agendada
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end align-items-center gap-2">

                                        <!-- DETALHES -->
                                        <a asp-controller="Marcacoes"
                                           asp-action="Details"
                                           asp-route-id="@marcacao.Id"
                                           class="btn btn-sm btn-outline-secondary">

                                            <i class="bi bi-eye me-1"></i>
                                            Ver
                                        </a>

                                        <!-- EDITAR -->
                                        <a asp-controller="Marcacoes"
                                           asp-action="Edit"
                                           asp-route-id="@marcacao.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-pencil-square me-1"></i>
                                            Editar
                                        </a>

                                        <!-- CANCELAR -->
                                        <form asp-controller="Marcacoes"
                                              asp-action="Cancelar"
                                              asp-route-id="@marcacao.Id"
                                              method="post"
                                              class="m-0"
                                              onsubmit="return confirm('Tem a certeza de que deseja cancelar esta marcação?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Cancelar
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            <div id="semResultadosCurso"
                 class="text-center text-muted py-5 d-none">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                Nenhuma marcação em curso encontrada.
            </div>

            <div class="border-top mt-3 pt-3 text-muted small">
                <span id="contadorCurso"></span>
            </div>

        </div>
    </div>

    <!-- MARCAÇÕES CONCLUÍDAS -->
    <div id="tabelaConcluidas"
         class="card border-0 shadow-sm tabela-marcacoes d-none">

        <div class="card-body p-3">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>Veículo</th>
                            <th>Mecânico</th>
                            <th>Tipo de Serviço</th>
                            <th>Data e Hora</th>
                            <th>Estado</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var marcacao in concluidas)
                        {
                            var pesquisa = $"{marcacao.User?.FullName} " +
                                $"{marcacao.Veiculo?.Marca} " +
                                $"{marcacao.Veiculo?.Modelo} " +
                                $"{marcacao.Veiculo?.Matricula} " +
                                $"{marcacao.Mecanico?.Nome} " +
                                $"{marcacao.TipoServico}";

                            <tr class="linha-marcacao"
                                data-pesquisa="@pesquisa.ToLowerInvariant()">

                                <td class="fw-semibold">
                                    @marcacao.User?.FullName
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @marcacao.Veiculo?.Marca
                                        @marcacao.Veiculo?.Modelo
                                    </div>

                                    <small class="text-muted">
                                        @marcacao.Veiculo?.Matricula
                                    </small>
                                </td>

                                <td>
                                    @marcacao.Mecanico?.Nome
                                </td>

                                <td>
                                    @marcacao.TipoServico
                                </td>

                                <td>
                                    @marcacao.DataHora.ToString("dd/MM/yyyy - HH:mm")
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Concluída
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Marcacoes"
                                       asp-action="Details"
                                       asp-route-id="@marcacao.Id"
                                       class="btn btn-sm btn-outline-secondary">

                                        <i class="bi bi-eye me-1"></i>
                                        Ver
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            <div id="semResultadosConcluidas"
                 class="text-center text-muted py-5 d-none">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                Nenhuma marcação concluída encontrada.
            </div>

            <div class="border-top mt-3 pt-3 text-muted small">
                <span id="contadorConcluidas"></span>
            </div>

        </div>
    </div>

    <!-- MARCAÇÕES CANCELADAS -->
    <div id="tabelaCanceladas"
         class="card border-0 shadow-sm tabela-marcacoes d-none">

        <div class="card-body p-3">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>Veículo</th>
                            <th>Mecânico</th>
                            <th>Tipo de Serviço</th>
                            <th>Data e Hora</th>
                            <th>Estado</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var marcacao in canceladas)
                        {
                            var pesquisa = $"{marcacao.User?.FullName} " +
                                $"{marcacao.Veiculo?.Marca} " +
                                $"{marcacao.Veiculo?.Modelo} " +
                                $"{marcacao.Veiculo?.Matricula} " +
                                $"{marcacao.Mecanico?.Nome} " +
                                $"{marcacao.TipoServico}";

                            <tr class="linha-marcacao"
                                data-pesquisa="@pesquisa.ToLowerInvariant()">

                                <td class="fw-semibold">
                                    @marcacao.User?.FullName
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @marcacao.Veiculo?.Marca
                                        @marcacao.Veiculo?.Modelo
                                    </div>

                                    <small class="text-muted">
                                        @marcacao.Veiculo?.Matricula
                                    </small>
                                </td>

                                <td>
                                    @marcacao.Mecanico?.Nome
                                </td>

                                <td>
                                    @marcacao.TipoServico
                                </td>

                                <td>
                                    @marcacao.DataHora.ToString("dd/MM/yyyy - HH:mm")
                                </td>

                                <td>
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Cancelada
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Marcacoes"
                                       asp-action="Details"
                                       asp-route-id="@marcacao.Id"
                                       class="btn btn-sm btn-outline-secondary">

                                        <i class="bi bi-eye me-1"></i>
                                        Ver
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            <div id="semResultadosCanceladas"
                 class="text-center text-muted py-5 d-none">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                Nenhuma marcação cancelada encontrada.
            </div>

            <div class="border-top mt-3 pt-3 text-muted small">
                <span id="contadorCanceladas"></span>
            </div>

        </div>
    </div>

    <!-- VOLTAR -->
    <div class="mt-3">
        <a asp-controller="RececionistaArea"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar
        </a>
    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const botoes = document.querySelectorAll(".filtro-marcacao");
            const pesquisa = document.getElementById("pesquisaMarcacoes");

            const tabelas = {
                curso: document.getElementById("tabelaEmCurso"),
                concluida: document.getElementById("tabelaConcluidas"),
                cancelada: document.getElementById("tabelaCanceladas")
            };

            const mensagensVazias = {
                curso: document.getElementById("semResultadosCurso"),
                concluida: document.getElementById("semResultadosConcluidas"),
                cancelada: document.getElementById("semResultadosCanceladas")
            };

            const contadores = {
                curso: document.getElementById("contadorCurso"),
                concluida: document.getElementById("contadorConcluidas"),
                cancelada: document.getElementById("contadorCanceladas")
            };

            let filtroAtual = "curso";

            function atualizarTabela() {

                const termo = pesquisa.value.trim().toLowerCase();
                const tabelaAtual = tabelas[filtroAtual];
                const linhas = tabelaAtual.querySelectorAll(".linha-marcacao");

                let visiveis = 0;

                linhas.forEach(linha => {

                    const texto = linha.dataset.pesquisa || "";
                    const mostrar = texto.includes(termo);

                    linha.classList.toggle("d-none", !mostrar);

                    if (mostrar) {
                        visiveis++;
                    }
                });

                mensagensVazias[filtroAtual].classList.toggle(
                    "d-none",
                    visiveis > 0
                );

                contadores[filtroAtual].textContent =
                    `A mostrar ${visiveis} marcação(ões)`;
            }

            botoes.forEach(botao => {

                botao.addEventListener("click", function () {

                    filtroAtual = this.dataset.filtro;

                    botoes.forEach(b => {
                        b.classList.remove("btn-primary");
                        b.classList.add("btn-outline-primary");
                    });

                    this.classList.remove("btn-outline-primary");
                    this.classList.add("btn-primary");

                    Object.values(tabelas).forEach(tabela => {
                        tabela.classList.add("d-none");
                    });

                    tabelas[filtroAtual].classList.remove("d-none");

                    atualizarTabela();
                });
            });

            pesquisa.addEventListener("input", atualizarTabela);

            atualizarTabela();
        });
    </script>
}
