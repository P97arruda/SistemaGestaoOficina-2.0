
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Marcacao>

@using System.Linq
@using SistemaGestaoOficina.Data.Entities

@{
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
    ViewData["Title"] = "Marcações";

    var marcacoes = Model?.ToList() ?? new List<Marcacao>();

    var emCurso = marcacoes
        .Where(m => m.Estado == "Agendada")
        .ToList();

    var concluidas = marcacoes
        .Where(m => m.Estado == "Concluida" || m.Estado == "Concluída")
        .ToList();

    var canceladas = marcacoes
        .Where(m => m.Estado == "Cancelada")
        .ToList();

    var grupos = new[]
    {
        new
        {
            Chave = "curso",
            Titulo = "Agendada",
            Registos = emCurso
        },
        new
        {
            Chave = "concluida",
            Titulo = "Concluída",
            Registos = concluidas
        },
        new
        {
            Chave = "cancelada",
            Titulo = "Cancelada",
            Registos = canceladas
        }
    };
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center
                flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Marcações</h2>

            <p class="text-muted mb-0">
                Consulte e faça a gestão das marcações da oficina.
            </p>
        </div>

        <a asp-controller="Marcacoes"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Criar Marcação
        </a>

    </div>

    <!-- MENSAGENS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <!-- FILTROS E PESQUISA -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-3">

            <div class="row align-items-end g-3">

                <!-- FILTROS -->
                <div class="col-lg-7">

                    <label class="form-label fw-semibold d-block">
                        Estado das Marcações
                    </label>

                    <div class="d-flex gap-2 flex-wrap">

                        <button type="button"
                                class="btn btn-primary filtro-marcacao"
                                data-filtro="curso">

                            <i class="bi bi-clock me-1"></i>
                            Em Curso (@emCurso.Count)
                        </button>

                        <button type="button"
                                class="btn btn-outline-primary filtro-marcacao"
                                data-filtro="concluida">

                            <i class="bi bi-check-circle me-1"></i>
                            Concluídas (@concluidas.Count)
                        </button>

                        <button type="button"
                                class="btn btn-outline-primary filtro-marcacao"
                                data-filtro="cancelada">

                            <i class="bi bi-x-circle me-1"></i>
                            Canceladas (@canceladas.Count)
                        </button>

                    </div>

                </div>

                <!-- PESQUISA -->
                <div class="col-lg-5">

                    <label for="pesquisaMarcacoes"
                           class="form-label fw-semibold">
                        Pesquisar Marcações
                    </label>

                    <div class="input-group">

                        <span class="input-group-text bg-white">
                            <i class="bi bi-search text-muted"></i>
                        </span>

                        <input type="search"
                               id="pesquisaMarcacoes"
                               class="form-control"
                               placeholder="Cliente, matrícula ou serviço..."
                               autocomplete="off" />

                        <button type="button"
                                id="limparPesquisa"
                                class="btn btn-outline-secondary"
                                title="Limpar pesquisa">
                            <i class="bi bi-x-lg"></i>
                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>

    <!-- TABELAS DAS MARCAÇÕES -->
    @foreach (var grupo in grupos)
    {
        <div id="tabela-@grupo.Chave"
             class="card border-0 shadow-sm tabela-marcacoes @(grupo.Chave == "curso" ? "" : "d-none")">

            <div class="card-body p-3">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Cliente</th>
                                <th>Veículo</th>
                                <th>Mecânico</th>
                                <th>Tipo de Serviço</th>
                                <th>Data e Hora</th>
                                <th>Estado</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var marcacao in grupo.Registos)
                            {
                                var pesquisa = $"{marcacao.User?.FullName} " +
                                    $"{marcacao.Veiculo?.Marca} " +
                                    $"{marcacao.Veiculo?.Modelo} " +
                                    $"{marcacao.Veiculo?.Matricula} " +
                                    $"{marcacao.Mecanico?.Nome} " +
                                    $"{marcacao.TipoServico}";

                                <tr class="linha-marcacao"
                                    data-pesquisa="@pesquisa.ToLowerInvariant()">

                                    <!-- CLIENTE -->
                                    <td class="fw-semibold">
                                        @(marcacao.User?.FullName ?? "Não informado")
                                    </td>

                                    <!-- VEÍCULO -->
                                    <td>
                                        <div class="fw-semibold">
                                            @marcacao.Veiculo?.Marca
                                            @marcacao.Veiculo?.Modelo
                                        </div>

                                        <small class="text-muted">
                                            @marcacao.Veiculo?.Matricula
                                        </small>
                                    </td>

                                    <!-- MECÂNICO -->
                                    <td>
                                        @(marcacao.Mecanico?.Nome ?? "Não atribuído")
                                    </td>

                                    <!-- SERVIÇO -->
                                    <td>
                                        @marcacao.TipoServico
                                    </td>

                                    <!-- DATA -->
                                    <td class="text-nowrap">
                                        @marcacao.DataHora.ToString("dd/MM/yyyy - HH:mm")
                                    </td>

                                    <!-- ESTADO -->
                                    <td>

                                        @if (grupo.Chave == "curso")
                                        {
                                            <span class="badge bg-primary">
                                                Agendada
                                            </span>
                                        }
                                        else if (grupo.Chave == "concluida")
                                        {
                                            <span class="badge bg-success">
                                                Concluída
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelada
                                            </span>
                                        }

                                    </td>

                                    <!-- AÇÕES -->
                                    <td class="text-end">

                                        <div class="d-flex justify-content-end
                                                    align-items-center gap-2">

                                            @if (grupo.Chave == "curso")
                                            {
                                                <!-- CANCELAR -->
                                                <form asp-controller="Marcacoes"
                                                      asp-action="Cancelar"
                                                      asp-route-id="@marcacao.Id"
                                                      method="post"
                                                      class="m-0"
                                                      onsubmit="return confirm('Tem a certeza que deseja cancelar esta marcação?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger">
                                                        Cancelar
                                                    </button>

                                                </form>

                                                <!-- EDITAR -->
                                                <a asp-controller="Marcacoes"
                                                   asp-action="Edit"
                                                   asp-route-id="@marcacao.Id"
                                                   class="btn btn-sm btn-warning">
                                                    Editar
                                                </a>
                                            }

                                            <!-- DETALHES -->
                                            <a asp-controller="Marcacoes"
                                               asp-action="Details"
                                               asp-route-id="@marcacao.Id"
                                               class="btn btn-sm btn-info text-white">
                                                Detalhes
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- SEM RESULTADOS -->
                <div id="semResultados-@grupo.Chave"
                     class="text-center text-muted py-5 d-none">

                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Nenhuma marcação encontrada.

                </div>

                <!-- CONTADOR -->
                <div class="border-top mt-3 pt-3 text-muted small">
                    <span id="contador-@grupo.Chave"></span>
                </div>

            </div>
        </div>
    }

    <!-- VOLTAR -->
    <div class="mt-3">

        <a asp-controller="RececionistaArea"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar
        </a>

    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const botoes = document.querySelectorAll(".filtro-marcacao");
            const pesquisa = document.getElementById("pesquisaMarcacoes");
            const limparPesquisa = document.getElementById("limparPesquisa");

            let filtroAtual = "curso";

            function atualizarTabela() {

                const termo = pesquisa.value.trim().toLocaleLowerCase("pt-PT");

                const tabelaAtual =
                    document.getElementById("tabela-" + filtroAtual);

                const linhas =
                    tabelaAtual.querySelectorAll(".linha-marcacao");

                const semResultados =
                    document.getElementById("semResultados-" + filtroAtual);

                const contador =
                    document.getElementById("contador-" + filtroAtual);

                let visiveis = 0;

                linhas.forEach(function (linha) {

                    const texto = linha.dataset.pesquisa || "";
                    const corresponde = texto.includes(termo);

                    linha.classList.toggle("d-none", !corresponde);

                    if (corresponde) {
                        visiveis++;
                    }
                });

                semResultados.classList.toggle("d-none", visiveis > 0);

                contador.textContent =
                    `A mostrar ${visiveis} marcação(ões)`;
            }

            // ALTERNAR ESTADO
            botoes.forEach(function (botao) {

                botao.addEventListener("click", function () {

                    filtroAtual = this.dataset.filtro;

                    botoes.forEach(function (b) {
                        b.classList.remove("btn-primary");
                        b.classList.add("btn-outline-primary");
                    });

                    this.classList.remove("btn-outline-primary");
                    this.classList.add("btn-primary");

                    document.querySelectorAll(".tabela-marcacoes")
                        .forEach(function (tabela) {
                            tabela.classList.add("d-none");
                        });

                    document.getElementById("tabela-" + filtroAtual)
                        .classList.remove("d-none");

                    atualizarTabela();
                });
            });

            // PESQUISA
            pesquisa.addEventListener("input", atualizarTabela);

            // LIMPAR PESQUISA
            limparPesquisa.addEventListener("click", function () {
                pesquisa.value = "";
                atualizarTabela();
                pesquisa.focus();
            });

            atualizarTabela();
        });
    </script>
}
