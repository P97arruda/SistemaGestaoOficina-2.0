
@model SistemaGestaoOficina.Data.Entities.Mecanico

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Editar Mecânico";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Editar Mecânico</h2>
        <p class="text-muted mb-0">
            Atualize as informações do mecânico na OficinaCET107.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Especialidade" class="form-label"></label>
                        <input asp-for="Especialidade" class="form-control" />
                        <span asp-validation-for="Especialidade"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Horario" class="form-label"></label>
                        <input asp-for="Horario" class="form-control" />
                        <span asp-validation-for="Horario"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Contacto" class="form-label"></label>
                        <input asp-for="Contacto" class="form-control" />
                        <span asp-validation-for="Contacto"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <div class="form-check">
                            <input asp-for="Ativo"
                                   class="form-check-input" />
                            <label asp-for="Ativo"
                                   class="form-check-label"></label>
                        </div>
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Guardar Alterações
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
