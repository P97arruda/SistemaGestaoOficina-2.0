
@model SistemaGestaoOficina.Data.Entities.Mecanico

@{
    ViewData["Title"] = "Detalhes do Mecânico";
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Detalhes do Mecânico
        </h2>

        <p class="text-muted mb-0">
            Consulte as informações do mecânico registado.
        </p>
    </div>

    <!-- CARTÃO PRINCIPAL -->
    <div class="card shadow-sm border-0 rounded-3"
         style="max-width: 900px;">

        <div class="card-body p-4">

            <!-- FOTOGRAFIA E NOME -->
            <div class="d-flex align-items-center gap-3 mb-4">

                @if (Model.User != null &&
                     Model.User.ImageId != Guid.Empty)
                {
                    <img src="@Model.User.ImageFullPath"
                         alt="Fotografia de @Model.Nome"
                         class="rounded-circle"
                         style="width: 85px;
                                height: 85px;
                                object-fit: cover;
                                flex-shrink: 0;" />
                }
                else
                {
                    <div class="rounded-circle bg-primary text-white
                                d-flex align-items-center justify-content-center
                                fw-bold fs-3"
                         style="width: 85px;
                                height: 85px;
                                min-width: 85px;">

                        @(string.IsNullOrWhiteSpace(Model.Nome)
                            ? "M"
                            : Model.Nome.Substring(0, 1).ToUpper())
                    </div>
                }

                <div>
                    <h4 class="fw-bold mb-1">
                        @Model.Nome
                    </h4>

                    <span class="badge bg-primary">
                        Mecânico
                    </span>
                </div>

            </div>

            <hr class="mb-4" />

            <!-- INFORMAÇÕES -->
            <h5 class="fw-bold mb-3">
                Informações do Mecânico
            </h5>

            <dl class="row mb-4">

                <dt class="col-sm-3">Nome</dt>
                <dd class="col-sm-9">@Model.Nome</dd>

                <dt class="col-sm-3">Especialidade</dt>
                <dd class="col-sm-9">@Model.Especialidade</dd>

                <dt class="col-sm-3">Horário</dt>
                <dd class="col-sm-9">@Model.Horario</dd>

                <dt class="col-sm-3">Contacto</dt>
                <dd class="col-sm-9">@Model.Contacto</dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">

                    @if (Model.Ativo)
                    {
                        <span class="badge bg-success">
                            Ativo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inativo
                        </span>
                    }

                </dd>

            </dl>

            <hr />

            <!-- BOTÕES -->
            <div class="d-flex gap-2 mt-3">

                @if (!string.IsNullOrEmpty(Model.UserId))
                {
                    <a asp-controller="Admin"
                       asp-action="EditUser"
                       asp-route-id="@Model.UserId"
                       class="btn btn-warning">
                        Editar
                    </a>
                }

                <a asp-controller="Mecanicos"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </div>

        </div>
    </div>

</div>
