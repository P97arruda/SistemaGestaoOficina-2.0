
@model SistemaGestaoOficina.Data.Entities.Mecanico

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Detalhes do Mecânico";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Detalhes do Mecânico</h2>
        <p class="text-muted mb-0">
            Consulte as informações do mecânico registado na OficinaCET107.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Informações do Mecânico</h5>

            <dl class="row">
                <dt class="col-sm-3">Nome</dt>
                <dd class="col-sm-9">@Model.Nome</dd>

                <dt class="col-sm-3">Especialidade</dt>
                <dd class="col-sm-9">@Model.Especialidade</dd>

                <dt class="col-sm-3">Horário</dt>
                <dd class="col-sm-9">@Model.Horario</dd>

                <dt class="col-sm-3">Contacto</dt>
                <dd class="col-sm-9">@Model.Contacto</dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    @if (Model.Ativo)
                    {
                        <span class="badge bg-success">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inativo</span>
                    }
                </dd>
            </dl>

            <hr />

            <div class="d-flex gap-2">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    Editar
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>
            </div>

        </div>
    </div>

</div>
