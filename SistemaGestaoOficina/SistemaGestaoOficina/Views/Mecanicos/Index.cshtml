
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Mecanico>

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Mecânicos";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Mecânicos</h2>

            <p class="text-muted mb-0">
                Consulte e gira os mecânicos registados na OficinaCET107.
            </p>
        </div>

        <a asp-controller="Mecanicos"
           asp-action="Create"
           class="btn btn-primary">
            + Criar Mecânico
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Especialidade</th>
                            <th>Horário</th>
                            <th>Contacto</th>
                            <th>Estado</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var mecanico in Model)
                            {
                                <tr>
                                    <td>@mecanico.Nome</td>
                                    <td>@mecanico.Especialidade</td>
                                    <td>@mecanico.Horario</td>
                                    <td>@mecanico.Contacto</td>

                                    <td>
                                        @if (mecanico.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Mecanicos"
                                           asp-action="Details"
                                           asp-route-id="@mecanico.Id"
                                           class="btn btn-sm btn-info text-white">
                                            Detalhes
                                        </a>

                                        <a asp-controller="Mecanicos"
                                           asp-action="Edit"
                                           asp-route-id="@mecanico.Id"
                                           class="btn btn-sm btn-warning">
                                            Editar
                                        </a>

                                        <form asp-controller="Mecanicos"
                                              asp-action="Delete"
                                              asp-route-id="@mecanico.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Tem a certeza de que deseja apagar este mecânico?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Apagar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    Ainda não existem mecânicos registados.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>
    </div>

</div>
