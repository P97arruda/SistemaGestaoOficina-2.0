
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Mecanico>

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Mecânicos";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Mecânicos</h2>

            <p class="text-muted mb-0">
                Consulte e gira os mecânicos registados na OficinaCET107.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="CreateUser"
           class="btn btn-primary">
            + Criar Mecânico
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Especialidade</th>
                            <th>Horário</th>
                            <th>Contacto</th>
                            <th>Estado</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var mecanico in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">

                                            @if (mecanico.User != null &&
                                                 mecanico.User.ImageId != Guid.Empty)
                                            {
                                                <img src="@mecanico.User.ImageFullPath"
                                                     alt="Fotografia de @mecanico.Nome"
                                                     style="width: 38px;
                                                            height: 38px;
                                                            border-radius: 50%;
                                                            object-fit: cover;
                                                            flex-shrink: 0;" />
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center text-white fw-bold"
                                                     style="width: 38px;
                                                            height: 38px;
                                                            min-width: 38px;
                                                            border-radius: 50%;
                                                            background-color: #1683ff;">

                                                    @(string.IsNullOrWhiteSpace(mecanico.Nome)
                                                        ? "M"
                                                        : mecanico.Nome.Substring(0, 1).ToUpper())

                                                </div>
                                            }

                                            <span>
                                                @mecanico.Nome
                                            </span>

                                        </div>
                                    </td>

                                    <td>@mecanico.Especialidade</td>

                                    <td>@mecanico.Horario</td>

                                    <td>@mecanico.Contacto</td>

                                    <td>
                                        @if (mecanico.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">

                                            <!-- APAGAR -->
                                            @if (!string.IsNullOrEmpty(mecanico.UserId))
                                            {
                                                <form asp-controller="Admin"
                                                      asp-action="DeleteUser"
                                                      asp-route-id="@mecanico.UserId"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Tem a certeza de que deseja apagar este mecânico?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger">
                                                        Apagar
                                                    </button>

                                                </form>
                                            }

                                            <!-- EDITAR -->
                                            @if (!string.IsNullOrEmpty(mecanico.UserId))
                                            {
                                                <a asp-controller="Admin"
                                                   asp-action="EditUser"
                                                   asp-route-id="@mecanico.UserId"
                                                   class="btn btn-sm btn-warning">
                                                    Editar
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    Sem conta associada
                                                </span>
                                            }

                                            <!-- DETALHES -->
                                            <a asp-controller="Mecanicos"
                                               asp-action="Details"
                                               asp-route-id="@mecanico.Id"
                                               class="btn btn-sm btn-info text-white">
                                                Detalhes
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    Ainda não existem mecânicos registados.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>
    </div>

</div>
