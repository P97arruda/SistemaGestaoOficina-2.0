
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Mecanico>

@{
    ViewData["Title"] = "Gestão de Mecânicos";
    Layout = "_InternalLayout";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Gestão de Mecânicos</h2>
            <p class="text-muted mb-0">
                Consulte e faça a gestão dos mecânicos da oficina.
            </p>
        </div>

        <a asp-controller="Mecanicos"
           asp-action="Create"
           class="btn btn-primary">
            Novo Mecânico
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    Ainda não existem mecânicos registados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th>Especialidade</th>
                                <th>Horário</th>
                                <th>Contacto</th>
                                <th>Estado</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var mecanico in Model)
                            {
                                <tr>
                                    <td>@mecanico.Nome</td>
                                    <td>@mecanico.Especialidade</td>
                                    <td>@mecanico.Horario</td>
                                    <td>@mecanico.Contacto</td>
                                    <td>
                                        @if (mecanico.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Edit"
                                           asp-route-id="@mecanico.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@mecanico.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Detalhes
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@mecanico.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Eliminar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>

