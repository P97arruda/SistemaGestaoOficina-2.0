
@model IEnumerable<SistemaGestaoOficina.Data.Entities.TipoReparacao>

@{
    ViewData["Title"] = "Tipos de Reparações";
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Tipos de Reparações</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Novo Tipo
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var tipo in Model)
                        {
                            <tr>
                                <td>@tipo.Nome</td>

                                <td class="text-end">

                                    <div class="d-flex justify-content-end align-items-center gap-2">

                                        <!-- APAGAR -->
                                        <form asp-action="Delete"
                                              asp-route-id="@tipo.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Tem a certeza de que deseja apagar este tipo de reparação?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Apagar
                                            </button>

                                        </form>

                                        <!-- EDITAR -->
                                        <a asp-action="Edit"
                                           asp-route-id="@tipo.Id"
                                           class="btn btn-sm btn-warning">
                                            Editar
                                        </a>

                                        <!-- DETALHES -->
                                        <a asp-action="Details"
                                           asp-route-id="@tipo.Id"
                                           class="btn btn-sm btn-info text-white">
                                            Detalhes
                                        </a>

                                    </div>

                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="2"
                                    class="text-center text-muted py-4">
                                    Ainda não existem tipos de reparações registados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
