
@model IEnumerable<SistemaGestaoOficina.Data.Entities.TipoReparacao>

@{
    ViewData["Title"] = "Tipos de Reparações";
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Tipos de Reparações</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Novo Tipo
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var tipo in Model)
                        {
                            <tr>
                                <td>@tipo.Nome</td>

                                <td class="text-end">
                                    <a asp-action="Edit"
                                       asp-route-id="@tipo.Id"
                                       class="btn btn-sm btn-outline-primary me-2">
                                        Editar
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@tipo.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Tem a certeza de que deseja apagar este tipo de reparação?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Apagar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="2"
                                    class="text-center text-muted py-4">
                                    Ainda não existem tipos de reparações registados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
