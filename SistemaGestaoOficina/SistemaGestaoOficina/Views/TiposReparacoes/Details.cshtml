
@model SistemaGestaoOficina.Data.Entities.TipoReparacao

@{
    ViewData["Title"] = "Detalhes do Tipo de Reparação";
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2>Detalhes do Tipo de Reparação</h2>
        <p class="text-muted">
            Consulte as informações do tipo de reparação.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <div class="mb-3">
                <label class="form-label fw-bold">
                    Nome do Tipo de Reparação
                </label>

                <p class="form-control-plaintext">
                    @Model.Nome
                </p>
            </div>

            <div class="d-flex gap-2 mt-4">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    Editar
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Voltar
                </a>

            </div>

        </div>
    </div>

</div>
