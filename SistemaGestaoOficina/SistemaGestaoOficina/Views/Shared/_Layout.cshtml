<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - OficinaCET107</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaGestaoOficina.styles.css" asp-append-version="true" />

    <style>
        html {
            height: 100%;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        .page-content {
            flex: 1;
        }

        .oficina-navbar {
            background: #111820;
            min-height: 76px;
            border-bottom: 3px solid #1683ff;
            padding: 10px 0;
        }

        .oficina-brand {
            color: white !important;
            font-size: 1.3rem;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }

        .brand-blue {
            color: #1683ff;
        }

        .oficina-navbar .nav-link {
            color: #d6dce2 !important;
            font-weight: 500;
            margin: 0 7px;
            padding: 10px 7px !important;
            transition: 0.2s;
        }

        .oficina-navbar .nav-link:hover {
            color: #1683ff !important;
        }

        .user-info .nav-link {
            color: white !important;
            cursor: default;
            white-space: nowrap;
        }

        .user-info .nav-link:hover {
            color: white !important;
        }

        .login-button {
            display: inline-block;
            background: #1683ff;
            color: white !important;
            padding: 9px 24px !important;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: 0.2s;
            white-space: nowrap;
        }

        .login-button:hover {
            background: #0d6efd;
            transform: translateY(-1px);
        }

        .oficina-footer {
            background: #111820;
            color: #aeb7c0;
            padding: 25px 0;
            margin-top: 50px;
            flex-shrink: 0;
        }

        .oficina-footer strong {
            color: white;
        }

        @@media (max-width: 991px) {
            .oficina-navbar {
                padding: 8px 0;
            }

            .oficina-brand {
                font-size: 1.15rem;
            }

            .navbar-collapse {
                padding-top: 15px;
                padding-bottom: 10px;
            }

            .oficina-navbar .navbar-nav {
                align-items: stretch !important;
            }

            .oficina-navbar .nav-link {
                margin: 0;
                padding: 12px 5px !important;
                border-bottom: 1px solid #27313b;
            }

            .login-button {
                display: block;
                width: 100%;
                text-align: center;
                margin-top: 15px;
            }
        }

        @@media (max-width: 576px) {
            .oficina-brand {
                font-size: 1rem;
            }

            .oficina-footer {
                font-size: 0.85rem;
                padding: 20px 10px;
            }
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark oficina-navbar">
            <div class="container">

                <a class="navbar-brand oficina-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Oficina<span class="brand-blue">CET107</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarOficina"
                        aria-controls="navbarOficina"
                        aria-expanded="false"
                        aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarOficina">
                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="servicos">
                                Serviços
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Mecânicos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Horários
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item user-info">
                                <span class="nav-link">
                                    Olá, @User.Identity.Name

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger ms-2">Admin</span>
                                    }

                                    @if (User.IsInRole("Funcionario"))
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Funcionário</span>
                                    }

                                    @if (User.IsInRole("Cliente"))
                                    {
                                        <span class="badge bg-success ms-2">Cliente</span>
                                    }
                                </span>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="login-button"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="login-button"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="page-content">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="oficina-footer">
        <div class="container text-center">
            <strong>OficinaCET107 3.0</strong>
            <span class="mx-2">|</span>
            &copy; 2026 - Todos os direitos reservados
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>