
@using SistemaGestaoOficina.Helpers
@inject IUserHelper UserHelper

@{
    var userEmail = User.Identity?.Name;

    var user = User.Identity?.IsAuthenticated == true &&
               !string.IsNullOrWhiteSpace(userEmail)
        ? await UserHelper.GetUserByEmailAsync(userEmail)
        : null;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - OficinaCET107</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaGestaoOficina.styles.css" asp-append-version="true" />

    <style>
        html {
            height: 100%;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        .page-content {
            flex: 1;
        }

        /* NAVBAR */

        .oficina-navbar {
            background: #111820;
            min-height: 76px;
            border-bottom: 3px solid #1683ff;
            padding: 10px 0;
        }

        .oficina-brand {
            color: white !important;
            font-size: 1.3rem;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }

        .brand-blue {
            color: #1683ff;
        }

        .oficina-navbar .nav-link {
            color: #d6dce2 !important;
            font-weight: 500;
            margin: 0 5px;
            padding: 10px 6px !important;
            transition: 0.2s;
        }

        .oficina-navbar .nav-link:hover {
            color: #1683ff !important;
        }

        /* UTILIZADOR AUTENTICADO */

        .navbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-left: 18px;
            padding-left: 18px;
            border-left: 1px solid #344154;
        }

        .navbar-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
            border: 2px solid #344154;
        }

        .navbar-avatar-default {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #1683ff;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            flex-shrink: 0;
        }

        .navbar-user-details {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .navbar-user-name {
            color: white;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.3;
            white-space: nowrap;
        }

        .navbar-user-role {
            color: #94a3b8;
            font-size: 11px;
            line-height: 1.3;
            margin-top: 3px;
        }

        .navbar-dashboard-link {
            color: #d6dce2;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
            margin-left: 12px;
        }

        .navbar-dashboard-link:hover {
            color: #1683ff;
        }

        /* BOTÃO LOGIN / LOGOUT */

        .login-button {
            display: inline-block;
            background: #1683ff;
            color: white !important;
            padding: 10px 20px !important;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: 0.2s;
            white-space: nowrap;
        }

        .login-button:hover {
            background: #0d6efd;
            transform: translateY(-1px);
        }

        /* FOOTER */

        .oficina-footer {
            background: #111820;
            color: #aeb7c0;
            padding: 25px 0;
            margin-top: 50px;
            flex-shrink: 0;
        }

        .oficina-footer strong {
            color: white;
        }

        /* RESPONSIVIDADE */

        @@media (max-width: 1199px) {
            .oficina-navbar {
                padding: 8px 0;
            }

            .oficina-brand {
                font-size: 1.15rem;
            }

            .navbar-collapse {
                padding-top: 15px;
                padding-bottom: 10px;
            }

            .oficina-navbar .navbar-nav {
                align-items: stretch !important;
            }

            .oficina-navbar .nav-link {
                margin: 0;
                padding: 12px 5px !important;
                border-bottom: 1px solid #27313b;
            }

            .navbar-user {
                margin-left: 0;
                margin-top: 15px;
                padding: 12px 5px;
                border-left: none;
                border-top: 1px solid #344154;
            }

            .navbar-dashboard-link {
                display: block;
                margin: 10px 0;
                padding: 10px 5px;
            }

            .login-button {
                display: block;
                width: 100%;
                text-align: center;
                margin-top: 10px;
            }
        }

        @@media (max-width: 576px) {
            .oficina-brand {
                font-size: 1rem;
            }

            .navbar-user-name {
                white-space: normal;
            }

            .oficina-footer {
                font-size: 0.85rem;
                padding: 20px 10px;
            }
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-xl navbar-dark oficina-navbar">
            <div class="container">

                <!-- LOGO -->

                <a class="navbar-brand oficina-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Oficina<span class="brand-blue">CET107</span>
                </a>

                <!-- MENU MOBILE -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarOficina"
                        aria-controls="navbarOficina"
                        aria-expanded="false"
                        aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarOficina">

                    <ul class="navbar-nav ms-auto align-items-xl-center">

                        <!-- HOME -->

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <!-- SERVIÇOS -->

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="servicos">
                                Serviços
                            </a>
                        </li>

                        <!-- MECÂNICOS -->

                        <li class="nav-item">
                            <span class="nav-link disabled"
                                  aria-disabled="true"
                                  title="Informação em preparação">
                                Mecânicos
                            </span>
                        </li>

                        <!-- HORÁRIOS -->

                        <li class="nav-item">
                            <span class="nav-link disabled"
                                  aria-disabled="true"
                                  title="Informação em preparação">
                                Horários
                            </span>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- INFORMAÇÃO DO UTILIZADOR -->

                            <li class="nav-item">
                                <div class="navbar-user">

                                    @if (user != null && user.ImageId != Guid.Empty)
                                    {
                                        <img src="@user.ImageFullPath"
                                             alt="Fotografia do utilizador"
                                             class="navbar-avatar" />
                                    }
                                    else
                                    {
                                        <div class="navbar-avatar-default">
                                            U
                                        </div>
                                    }

                                    <div class="navbar-user-details">

                                        <span class="navbar-user-name">
                                            @(user?.FullName ?? User.Identity.Name)
                                        </span>

                                        <span class="navbar-user-role">

                                            @if (User.IsInRole("Admin"))
                                            {
                                                <text>Administrador</text>
                                            }
                                            else if (User.IsInRole("Rececionista"))
                                            {
                                                <text>Rececionista</text>
                                            }
                                            else if (User.IsInRole("Cliente"))
                                            {
                                                <text>Cliente</text>
                                            }

                                        </span>

                                    </div>

                                </div>
                            </li>

                            <!-- ÁREA DO ADMINISTRADOR -->

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="navbar-dashboard-link"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        Administração
                                    </a>
                                </li>
                            }

                            <!-- ÁREA DO RECECIONISTA -->

                            @if (User.IsInRole("Rececionista"))
                            {
                                <li class="nav-item">
                                    <a class="navbar-dashboard-link"
                                       asp-controller="RececionistaArea"
                                       asp-action="Index">
                                        Painel da Oficina
                                    </a>
                                </li>
                            }

                            <!-- ÁREA DO CLIENTE -->

                            @if (User.IsInRole("Cliente"))
                            {
                                <li class="nav-item">
                                    <a class="navbar-dashboard-link"
                                       asp-controller="ClienteArea"
                                       asp-action="Index">
                                        Área do Cliente
                                    </a>
                                </li>
                            }

                            <!-- LOGOUT -->

                            <li class="nav-item ms-xl-3">
                                <a class="login-button"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Sair
                                </a>
                            </li>
                        }
                        else
                        {
                            <!-- LOGIN -->

                            <li class="nav-item ms-xl-3">
                                <a class="login-button"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Entrar
                                </a>
                            </li>
                        }

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- CONTEÚDO PRINCIPAL -->

    <div class="page-content">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- FOOTER -->

    <footer class="oficina-footer">
        <div class="container text-center">
            <strong>OficinaCET107</strong>
            <span class="mx-2">|</span>
            &copy; 2026 - Todos os direitos reservados
        </div>
    </footer>

    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
