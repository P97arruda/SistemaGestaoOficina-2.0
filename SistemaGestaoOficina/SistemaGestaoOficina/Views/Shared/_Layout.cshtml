<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - OficinaCET107</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaGestaoOficina.styles.css" asp-append-version="true" />

    <style>
            .oficina-navbar {
                background: #111820;
                min-height: 76px;
                border-bottom: 3px solid #1683ff;
                padding: 10px 0;
            }

            .navbar-logo {
                width: 52px;
                height: 52px;
                object-fit: cover;
                border-radius: 50%;
                transition: 0.2s;
            }

            .oficina-brand {
                color: white !important;
                font-size: 1.3rem;
                font-weight: 700;
                text-decoration: none;
                white-space: nowrap;
            }

            .brand-blue {
                color: #1683ff;
            }

            .oficina-navbar .nav-link {
                color: #d6dce2 !important;
                font-weight: 500;
                margin: 0 8px;
                padding: 10px 8px !important;
                transition: 0.2s;
            }

                .oficina-navbar .nav-link:hover {
                    color: #1683ff !important;
                }

            .login-button {
                display: inline-block;
                background: #1683ff;
                color: white !important;
                padding: 9px 24px !important;
                border-radius: 8px;
                font-weight: 600;
                text-decoration: none;
                transition: 0.2s;
            }

                .login-button:hover {
                    background: #0d6efd;
                    transform: translateY(-1px);
                }

            .oficina-footer {
                background: #111820;
                color: #aeb7c0;
                padding: 25px 0;
                margin-top: 50px;
            }

                .oficina-footer strong {
                    color: white;
                }

            /* TABLET E TELEMÓVEL */
            @@media (max-width: 991px) {

                .oficina-navbar {
                    padding: 8px 0;
                }

                .navbar-logo {
                    width: 44px;
                    height: 44px;
                }

                .oficina-brand {
                    font-size: 1.15rem;
                }

                .navbar-collapse {
                    padding-top: 15px;
                    padding-bottom: 10px;
                }

                .oficina-navbar .navbar-nav {
                    align-items: stretch !important;
                }

                .oficina-navbar .nav-link {
                    margin: 0;
                    padding: 12px 5px !important;
                    border-bottom: 1px solid #27313b;
                }

                .login-button {
                    display: block;
                    width: 100%;
                    text-align: center;
                    margin-top: 15px;
                }
            }

            /* TELEMÓVEIS PEQUENOS */
            @@media (max-width: 576px) {

                .navbar-logo {
                    width: 40px;
                    height: 40px;
                }

                .oficina-brand {
                    font-size: 1rem;
                }

                .oficina-footer {
                    font-size: 0.85rem;
                    padding: 20px 10px;
                }
            }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark oficina-navbar">
            <div class="container">

                <a class="navbar-brand oficina-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/ImagenCET107.png"
                         alt="OficinaCET107"
                         class="navbar-logo" />

                    <span class="ms-2">
                        Oficina<span class="brand-blue">CET107</span>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarOficina"
                        aria-controls="navbarOficina"
                        aria-expanded="false"
                        aria-label="Abrir menu">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarOficina">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="servicos">
                                Serviços
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Mecânicos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Horários
                            </a>
                        </li>

                        <li class="nav-item ms-lg-3">
                            <a class="login-button" href="#">
                                Login
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="oficina-footer">
        <div class="container text-center">
            <strong>OficinaCET107  3.0</strong>
            <span class="mx-2">|</span>
            &copy; 2026 - Todos os direitos reservados
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>