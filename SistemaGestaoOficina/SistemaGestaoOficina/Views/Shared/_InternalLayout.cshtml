
@using SistemaGestaoOficina.Helpers
@inject IUserHelper UserHelper

@{
    var userEmail = User.Identity?.Name;

    var user = User.Identity?.IsAuthenticated == true
        && !string.IsNullOrWhiteSpace(userEmail)
        ? await UserHelper.GetUserByEmailAsync(userEmail)
        : null;

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    var isCliente = User.IsInRole("Cliente");
    var isAdmin = User.IsInRole("Admin");
    var isRececionista = User.IsInRole("Rececionista");
    var isMecanico = User.IsInRole("Mecanico");

    var perfil = isAdmin
        ? "Administrador"
        : isRececionista
            ? "Rececionista"
            : isMecanico
                ? "Mecânico"
                : isCliente
                    ? "Cliente"
                    : "Utilizador";

    var nomeUtilizador =
        user?.FullName ?? User.Identity?.Name ?? "Utilizador";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AutoCET</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SistemaGestaoOficina.styles.css"
          asp-append-version="true" />

    <style>
        /* CONFIGURAÇÕES GERAIS */

        html {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background-color: #edf3fa;
            font-family: Arial, sans-serif;
        }

        /* MENU LATERAL */

        .sidebar {
            width: 260px;
            height: 100vh;
            height: 100dvh;
            position: fixed;
            top: 0;
            left: 0;

            background: linear-gradient(
                180deg,
                #0d1724 0%,
                #111820 100%
            );

            color: white;
            display: flex;
            flex-direction: column;
            z-index: 100;

            border-right: 1px solid rgba(150, 180, 215, 0.12);

            box-shadow:
                4px 0 18px rgba(0, 0, 0, 0.10);
        }

        /* LOGÓTIPO */

        .sidebar-logo {
            display: block;
            padding: 24px 20px;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.3px;
            text-decoration: none;
            color: white;

            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .sidebar-logo:hover {
            color: white;
        }

        .sidebar-logo span {
            color: #1683ff;
        }

        /* CONTEÚDO DO MENU */

        .sidebar-menu {
            padding: 12px 10px 20px;
            flex: 1;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #344154 transparent;
        }

        .sidebar-title {
            padding: 16px 12px 8px;
            color: #8fa3bf;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
        }

        /* LINKS DO MENU */

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            margin-bottom: 4px;
            border-radius: 10px;
            color: #cbd5e1;
            text-decoration: none;
            font-size: 14px;

            transition:
                background-color .2s ease,
                color .2s ease,
                box-shadow .2s ease;
        }

        .sidebar-icon {
            width: 18px;
            height: 18px;
            flex: 0 0 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.75;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .sidebar-link:hover {
            background-color: rgba(255, 255, 255, 0.07);
            color: white;
        }

        /* MENU ATIVO */

        .sidebar-link.active {
            background: linear-gradient(
                90deg,
                #1683ff 0%,
                #2d8fff 100%
            );

            color: white;

            box-shadow:
                0 4px 10px rgba(22, 131, 255, 0.22);
        }

        .sidebar-link.active:hover {
            color: white;
        }

        .sidebar-link:focus-visible,
        .sidebar-logo:focus-visible {
            outline: 2px solid #1683ff;
            outline-offset: 2px;
        }

        /* ÁREA PRINCIPAL */

        .main-area {
            margin-left: 260px;
            min-height: 100vh;
            min-width: 0;
            background-color: #edf3fa;
        }

        /* BARRA SUPERIOR */

        .topbar {
            min-height: 76px;
            background: #0d1724;

            border-bottom:
                1px solid rgba(150, 180, 215, 0.12);

            padding: 15px 30px;

            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 15px;

            box-shadow:
                0 3px 14px rgba(10, 25, 45, 0.10);
        }

        /* UTILIZADOR NO TOPO */

        .topbar-user {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 14px;
            min-width: 0;
        }

        .topbar-user-info {
            text-align: right;
            min-width: 0;
        }

        .topbar-user-name {
            font-size: 13px;
            font-weight: 700;
            color: white;
            line-height: 1.5;
        }

        .topbar-user-role {
            font-size: 12px;
            color: #aebdd0;
            line-height: 1.5;
        }

        /* FOTOGRAFIA DO UTILIZADOR */

        .topbar-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
            border: 2px solid #344154;
        }

        .topbar-avatar-default {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background-color: #1683ff;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: 700;
            flex-shrink: 0;
        }

        /* BOTÃO SAIR */

        .topbar-logout {
            display: inline-flex;
            align-items: center;
            color: #d6e0ec;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            padding-left: 14px;
            margin-left: 5px;
            border-left: 1px solid #344154;
            transition: color .2s ease;
        }

        .topbar-logout:hover {
            color: #66adff;
        }

        /* CONTEÚDO DAS PÁGINAS */

        .main-content {
            padding: 30px;
            min-width: 0;
        }

        .main-content > .container {
            margin-top: 0 !important;
        }

        .main-content .card {
            border-radius: 12px;
        }

        /* RESPONSIVIDADE */

        @@media (max-width: 768px) {

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
                min-height: auto;
            }

            .sidebar-logo {
                padding: 20px;
                font-size: 22px;
            }

            .sidebar-menu {
                overflow-y: visible;
            }

            .main-area {
                margin-left: 0;
            }

            .topbar {
                min-height: 65px;
                padding: 14px 18px;
            }

            .main-content {
                padding: 15px;
            }
        }

        @@media (max-width: 480px) {

            .topbar {
                padding: 12px;
            }

            .topbar-user {
                gap: 9px;
            }

            .topbar-user-name {
                font-size: 12px;
            }

            .topbar-user-role {
                font-size: 11px;
            }

            .topbar-avatar,
            .topbar-avatar-default {
                width: 36px;
                height: 36px;
            }

            .topbar-logout {
                padding-left: 10px;
                margin-left: 0;
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

    <!-- MENU LATERAL -->

    <aside class="sidebar">

        <!-- LOGÓTIPO AUTOCET -->

        <a asp-controller="Home"
           asp-action="Index"
           class="sidebar-logo">

            Auto<span>CET</span>

        </a>

        <nav class="sidebar-menu">

            <!-- ADMINISTRADOR -->

            @if (isAdmin)
            {
                <div class="sidebar-title">
                    Administração
                </div>

                <!-- PAINEL DO ADMINISTRADOR -->

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <rect x="3" y="3" width="7" height="7" rx="1.5" />
                        <rect x="14" y="3" width="7" height="7" rx="1.5" />
                        <rect x="3" y="14" width="7" height="7" rx="1.5" />
                        <rect x="14" y="14" width="7" height="7" rx="1.5" />

                    </svg>

                    Administração

                </a>

                <div class="sidebar-title">
                    Gestão de Utilizadores
                </div>

                <!-- CRIAR FUNCIONÁRIO -->

                <a asp-controller="Admin"
                   asp-action="CreateUser"
                   class="sidebar-link @(currentController == "Admin" && currentAction == "CreateUser" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="9" cy="7" r="3" />

                        <path d="M3 21v-2a6 6 0 0 1 12 0v2M19 8v6m-3-3h6" />

                    </svg>

                    Criar Funcionário

                </a>

                <!-- RECECIONISTAS -->

                <a asp-controller="Admin"
                   asp-action="Rececionistas"
                   class="sidebar-link @(currentController == "Admin" && (currentAction == "Rececionistas" || currentAction == "EditUser") ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="9" cy="7" r="3" />

                        <path d="M3 21v-2a6 6 0 0 1 12 0v2M16 4a3 3 0 0 1 0 6m2 5a5 5 0 0 1 3 4v2" />

                    </svg>

                    Rececionistas

                </a>

                <!-- MECÂNICOS -->

                <a asp-controller="Mecanicos"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Mecanicos" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M14 6a5 5 0 0 0-6 6l-5 5a2.1 2.1 0 0 0 3 3l5-5a5 5 0 0 0 6-6l-3 3-3-3 3-3Z" />

                    </svg>

                    Mecânicos

                </a>

                <div class="sidebar-title">
                    Configuração da Oficina
                </div>

                <!-- TIPOS DE REPARAÇÕES -->

                <a asp-controller="TiposReparacoes"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "TiposReparacoes" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="m14 4 6 6M3 21l9-9M15 3l6 6-3 3-6-6 3-3Z" />

                    </svg>

                    Tipos de Reparações

                </a>

                <!-- PEÇAS -->

                <a asp-controller="Pecas"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Pecas" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M4 7h16v13H4zM4 7l4-4h8l4 4M9 12h6m-6 4h6" />

                    </svg>

                    Peças

                </a>
            }

            <!-- FUNCIONÁRIOS -->

            @if (isRececionista || isMecanico)
            {
                <div class="sidebar-title">
                    Gestão da Oficina
                </div>

                <!-- PAINEL DA OFICINA -->

                <a asp-controller="RececionistaArea"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "RececionistaArea" && currentAction == "Index" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <rect x="3" y="3" width="7" height="7" rx="1.5" />
                        <rect x="14" y="3" width="7" height="7" rx="1.5" />
                        <rect x="3" y="14" width="7" height="7" rx="1.5" />
                        <rect x="14" y="14" width="7" height="7" rx="1.5" />

                    </svg>

                    Painel da Oficina

                </a>

                <!-- CLIENTES -->

                <a asp-controller="RececionistaArea"
                   asp-action="Clientes"
                   class="sidebar-link @(currentController == "RececionistaArea" && currentAction == "Clientes" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="9" cy="7" r="3" />

                        <path d="M3 21v-2a6 6 0 0 1 12 0v2M16 4a3 3 0 0 1 0 6m2 5a5 5 0 0 1 3 4v2" />

                    </svg>

                    Clientes

                </a>

                <!-- TODOS OS VEÍCULOS -->
                <!-- APENAS RECECIONISTA -->

                @if (isRececionista)
                {
                    <a asp-controller="Veiculos"
                       asp-action="TodosVeiculos"
                       class="sidebar-link @(currentController == "Veiculos" && currentAction == "TodosVeiculos" ? "active" : "")">

                        <svg class="sidebar-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="m5 7 2-4h10l2 4 2 3v9H3v-9l2-3ZM5 7h14M3 14h18M6 18v3m12-3v3M6 11h2m8 0h2" />

                        </svg>

                        Todos os Veículos

                    </a>
                }

                <!-- MARCAÇÕES -->

                <a asp-controller="Marcacoes"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Marcacoes" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <rect x="3" y="5" width="18" height="16" rx="2" />

                        <path d="M7 3v4m10-4v4M3 11h18m-13 5h2m4 0h2" />

                    </svg>

                    Marcações

                </a>

                <!-- REPARAÇÕES E FATURAÇÃO -->

                <a asp-controller="Reparacoes"
                   asp-action="Create"
                   class="sidebar-link @(currentController == "Reparacoes" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M14.7 6.3a5 5 0 0 0-6.4 6.4L3 18l3 3 5.3-5.3a5 5 0 0 0 6.4-6.4L14 13l-3-3 3.7-3.7Z" />

                    </svg>

                    Reparações e Faturação

                </a>
            }

            <!-- ÁREA DO CLIENTE -->

            @if (isCliente)
            {
                <div class="sidebar-title">
                    Área do Cliente
                </div>

                <!-- PAINEL INICIAL -->

                <a asp-controller="ClienteArea"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "ClienteArea" && currentAction == "Index" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <rect x="3" y="3" width="7" height="7" rx="1.5" />
                        <rect x="14" y="3" width="7" height="7" rx="1.5" />
                        <rect x="3" y="14" width="7" height="7" rx="1.5" />
                        <rect x="14" y="14" width="7" height="7" rx="1.5" />

                    </svg>

                    Painel Inicial

                </a>

                <!-- MEUS VEÍCULOS -->

                <a asp-controller="ClienteArea"
                   asp-action="MeusVeiculos"
                   class="sidebar-link @(currentController == "ClienteArea" && (currentAction == "MeusVeiculos" || currentAction == "DetalhesVeiculo" || currentAction == "EditarVeiculo") ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="m5 7 2-4h10l2 4 2 3v9H3v-9l2-3ZM5 7h14M3 14h18M6 18v3m12-3v3M6 11h2m8 0h2" />

                    </svg>

                    Meus Veículos

                </a>

                <!-- HISTÓRICO DE REPARAÇÕES -->

                <a asp-controller="ClienteArea"
                   asp-action="HistoricoReparacoes"
                   class="sidebar-link @(currentController == "ClienteArea" && currentAction == "HistoricoReparacoes" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="12" cy="12" r="9" />

                        <path d="M12 7v5l3 2" />

                    </svg>

                    Histórico de Reparações

                </a>
            }

            <!-- COMUNICAÇÕES -->
            <!-- ADMINISTRADOR, RECECIONISTA E MECÂNICO -->

            @if (isAdmin || isRececionista || isMecanico)
            {
                <div class="sidebar-title">
                    Comunicação
                </div>

                <a asp-controller="Comunicacoes"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Comunicacoes" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <rect x="3"
                              y="5"
                              width="18"
                              height="14"
                              rx="2" />

                        <path d="m3 7 9 6 9-6" />

                    </svg>

                    Comunicações

                </a>
            }

            <!-- CONTA -->

            <div class="sidebar-title">
                Conta
            </div>

            <!-- MEU PERFIL -->

            @if (isCliente)
            {
                <a asp-controller="ClienteArea"
                   asp-action="EditarPerfil"
                   class="sidebar-link @(currentController == "ClienteArea" && currentAction == "EditarPerfil" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="12" cy="8" r="4" />

                        <path d="M4 21v-1a8 8 0 0 1 16 0v1" />

                    </svg>

                    Meu Perfil

                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="EditarPerfil"
                   class="sidebar-link @(currentController == "Account" && currentAction == "EditarPerfil" ? "active" : "")">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="12" cy="8" r="4" />

                        <path d="M4 21v-1a8 8 0 0 1 16 0v1" />

                    </svg>

                    Meu Perfil

                </a>
            }

            <!-- PÁGINA INICIAL -->

            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-link @(currentController == "Home" ? "active" : "")">

                <svg class="sidebar-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-8h6v8" />

                </svg>

                Página Inicial

            </a>

        </nav>

    </aside>

    <!-- ÁREA PRINCIPAL -->

    <div class="main-area">

        <!-- BARRA SUPERIOR -->

        <header class="topbar">

            <div class="topbar-user">

                <!-- NOME E FUNÇÃO -->

                <div class="topbar-user-info">

                    <div class="topbar-user-name">
                        @nomeUtilizador
                    </div>

                    <div class="topbar-user-role">
                        @perfil
                    </div>

                </div>

                <!-- FOTOGRAFIA DO PERFIL -->

                @if (user != null && user.ImageId != Guid.Empty)
                {
                    <img src="@user.ImageFullPath"
                         alt="Fotografia de @nomeUtilizador"
                         class="topbar-avatar" />
                }
                else
                {
                    <div class="topbar-avatar-default">

                        @(string.IsNullOrWhiteSpace(nomeUtilizador)
                            ? "U"
                            : nomeUtilizador.Substring(0, 1).ToUpper())

                    </div>
                }

                <!-- LOGOUT -->

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="topbar-logout">

                    Sair

                </a>

            </div>

        </header>

        <!-- CONTEÚDO DAS PÁGINAS -->

        <main class="main-content">
            @RenderBody()
        </main>

    </div>

    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
