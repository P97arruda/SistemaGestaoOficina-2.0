
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Veiculo>

@{
    ViewData["Title"] = "Área do Cliente";
}

<div class="container mt-4 mb-5">

    <!-- Boas-vindas -->
    <div class="mb-4">
        <h2 class="fw-bold">Bem-vindo à sua oficina!</h2>

        <p class="text-muted">
            Consulte os seus veículos, acompanhe os serviços
            e encontre informações sobre a nossa oficina.
        </p>
    </div>

    <!-- Resumo do Cliente -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">Meus Veículos</h6>

                    <h2 class="fw-bold">
                        @(Model?.Count() ?? 0)
                    </h2>

                    <p class="mb-0 text-muted">
                        Veículos associados à sua conta
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">Marcações</h6>

                    <h2 class="fw-bold">—</h2>

                    <p class="mb-0 text-muted">
                        Disponível em breve
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">Serviços Realizados</h6>

                    <h2 class="fw-bold">—</h2>

                    <p class="mb-0 text-muted">
                        Disponível em breve
                    </p>

                </div>
            </div>
        </div>

    </div>

    <!-- Opções do Cliente -->
    <h5 class="fw-bold mb-3">O que deseja consultar?</h5>

    <div class="row g-3">

        <!-- Meus Veículos -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">

                    <h5 class="card-title">Meus Veículos</h5>

                    <p class="card-text">
                        Consulte os veículos associados à sua conta.
                    </p>

                    <button type="button"
                            class="btn btn-primary"
                            onclick="mostrarSecao('secaoVeiculos')">
                        Ver Veículos
                    </button>

                </div>
            </div>
        </div>

        <!-- Marcações -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">

                    <h5 class="card-title">Marcações</h5>

                    <p class="card-text">
                        Consulte as suas marcações na oficina.
                    </p>

                    <button type="button"
                            class="btn btn-primary"
                            disabled>
                        Ver Marcações
                    </button>

                </div>
            </div>
        </div>

        <!-- Histórico -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">

                    <h5 class="card-title">Histórico</h5>

                    <p class="card-text">
                        Consulte o histórico dos serviços realizados.
                    </p>

                    <button type="button"
                            class="btn btn-primary"
                            disabled>
                        Ver Histórico
                    </button>

                </div>
            </div>
        </div>

    </div>

    <!-- Secção dos Veículos -->
    <div id="secaoVeiculos" class="mt-4" style="display: none;">

        <h4 class="fw-bold">Os Meus Veículos</h4>

        <div class="card shadow-sm">
            <div class="card-body">

                @if (Model == null || !Model.Any())
                {
                    <div class="alert alert-info mb-0">
                        Ainda não tem veículos registados.
                        Contacte a oficina para registar o seu veículo.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Marca</th>
                                    <th>Modelo</th>
                                    <th>Matrícula</th>
                                    <th>Ano</th>
                                    <th>Quilometragem</th>
                                    <th>Combustível</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var veiculo in Model)
                                {
                                    <tr>
                                        <td>@veiculo.Marca</td>
                                        <td>@veiculo.Modelo</td>
                                        <td>@veiculo.Matricula</td>
                                        <td>@veiculo.Ano</td>
                                        <td>@veiculo.Quilometragem</td>
                                        <td>@veiculo.Combustivel</td>

                                        <td>
                                        <a asp-controller="ClienteArea"
                                           asp-action="EditarVeiculo"
                                           asp-route-id="@veiculo.Id"
                                           class="btn btn-sm btn-outline-primary">
                                           Editar
                                        </a>
                                        </td>
                                     </tr>
                                }
                            </tbody>

                        </table>

                    </div>
                }

            </div>
        </div>

        <button type="button"
                class="btn btn-outline-secondary mt-3"
                onclick="fecharSecao()">
            Voltar
        </button>

    </div>

</div>

@section Scripts {
    <script>

        function mostrarSecao(id) {

            document.getElementById("secaoVeiculos").style.display = "none";

            document.getElementById(id).style.display = "block";
        }

        function fecharSecao() {

            document.getElementById("secaoVeiculos").style.display = "none";
        }

    </script>
}
