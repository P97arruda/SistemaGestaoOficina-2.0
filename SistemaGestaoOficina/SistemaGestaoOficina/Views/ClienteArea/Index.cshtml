@{
    ViewData["Title"] = "Área do Cliente";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Área do Cliente</h2>
        <p class="text-muted">
            Consulte e gerencie as informações relacionadas com os seus veículos e serviços.
        </p>
    </div>

    <div class="row g-3">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Meus Veículos</h5>
                    <p class="card-text">
                        Consulte os veículos associados à sua conta.
                    </p>

                    <button class="btn btn-primary" disabled>
                        Ver Veículos
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Marcações</h5>
                    <p class="card-text">
                        Consulte as suas marcações na oficina.
                    </p>

                    <button class="btn btn-primary" disabled>
                        Ver Marcações
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Histórico</h5>
                    <p class="card-text">
                        Consulte o histórico dos serviços realizados.
                    </p>

                    <button class="btn btn-primary" disabled>
                        Ver Histórico
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>