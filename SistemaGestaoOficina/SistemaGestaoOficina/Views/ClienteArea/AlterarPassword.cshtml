
@model SistemaGestaoOficina.Models.ChangePasswordViewModel

@{
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
    ViewData["Title"] = "Alterar Password";
}

<div class="container py-4">

    <!-- CABEÇALHO -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Alterar Password
        </h2>

        <p class="text-muted mb-0">
            Atualize a password de acesso à sua conta.
        </p>

    </div>

    <!-- CARTÃO -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="row">

                <div class="col-md-7">

                    <form asp-controller="ClienteArea"
                          asp-action="AlterarPassword"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- PASSWORD ATUAL -->
                        <div class="mb-3">

                            <label asp-for="OldPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="OldPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Password atual" />

                            <span asp-validation-for="OldPassword"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- NOVA PASSWORD -->
                        <div class="mb-3">

                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Nova password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- CONFIRMAR PASSWORD -->
                        <div class="mb-4">

                            <label asp-for="Confirm"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Confirm"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Confirmar nova password" />

                            <span asp-validation-for="Confirm"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- BOTÕES -->
                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                Guardar Nova Password
                            </button>

                            <a asp-controller="ClienteArea"
                               asp-action="EditarPerfil"
                               class="btn btn-secondary">

                                Voltar
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
