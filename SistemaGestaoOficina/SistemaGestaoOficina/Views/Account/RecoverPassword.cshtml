
@model SistemaGestaoOficina.Models.RecoverPasswordViewModel

@{
    ViewData["Title"] = "Recuperar Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h3 class="text-center mb-3">
                        Recuperar Password
                    </h3>

                    <p class="text-muted text-center">
                        Introduza o seu email para receber
                        um link de recuperação da password.
                    </p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-controller="Account"
                          asp-action="RecoverPassword"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Introduza o seu email"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Enviar 
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="text-decoration-none">
                            Voltar ao Login
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
