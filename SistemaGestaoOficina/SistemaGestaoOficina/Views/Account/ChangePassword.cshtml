
@model SistemaGestaoOficina.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Alterar Password";
    Layout = "_InternalLayout";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Alterar Password</h2>
        <p class="text-muted">
            Atualize a password de acesso à sua conta.
        </p>
    </div>

    <div class="row">
        <div class="col-lg-7 col-xl-6">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <form asp-controller="Account"
                          asp-action="ChangePassword"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="OldPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="OldPassword"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Password atual" />

                            <span asp-validation-for="OldPassword"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Nova password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Confirm"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Confirm"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Confirmar nova password" />

                            <span asp-validation-for="Confirm"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar Nova Password
                            </button>

                            <a asp-controller="Account"
                               asp-action="EditarPerfil"
                               class="btn btn-outline-secondary">
                                Voltar
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
