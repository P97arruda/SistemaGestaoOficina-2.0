
@model SistemaGestaoOficina.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sessão";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

            <div class="card border-0 shadow-sm rounded-3">

                <div class="card-body p-4 p-md-5">

                    <!-- TÍTULO -->
                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-2">
                            Bem-vindo!
                        </h2>

                        <p class="text-muted mb-0">
                            Inicie sessão na sua conta OficinaCET107.
                        </p>
                    </div>

                    <!-- MENSAGEM DE SUCESSO -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div id="successAlert"
                             class="alert alert-success alert-dismissible fade show"
                             role="alert">

                            @TempData["SuccessMessage"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Fechar">
                            </button>
                        </div>
                    }

                    <!-- FORMULÁRIO -->
                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- EMAIL -->
                        <div class="mb-3">

                            <label asp-for="Username"
                                   class="form-label fw-semibold">
                                Email
                            </label>

                            <input asp-for="Username"
                                   type="email"
                                   class="form-control"
                                   placeholder="Introduza o seu email"
                                   autocomplete="username" />

                            <span asp-validation-for="Username"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- PASSWORD -->
                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Introduza a sua password"
                                   autocomplete="current-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- LEMBRAR-ME E RECUPERAR PASSWORD -->
                        <div class="d-flex justify-content-between
                                    align-items-center flex-wrap gap-2 mb-4">

                            <div class="form-check">

                                <input asp-for="RememberMe"
                                       type="checkbox"
                                       class="form-check-input" />

                                <label asp-for="RememberMe"
                                       class="form-check-label">
                                    Lembrar-me
                                </label>

                            </div>

                            <a asp-controller="Account"
                               asp-action="RecoverPassword"
                               class="text-decoration-none small fw-semibold">
                                Esqueceu-se da password?
                            </a>

                        </div>

                        <!-- BOTÃO ENTRAR -->
                        <button type="submit"
                                class="btn btn-primary w-100 py-2 fw-semibold">
                            Entrar
                        </button>

                    </form>

                </div>
            </div>

            <!-- RODAPÉ -->
            <p class="text-center text-muted small mt-4">
                OficinaCET107 — Sistema de Gestão de Oficina
            </p>

        </div>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const alert = document.getElementById("successAlert");

            if (alert) {
                setTimeout(function () {
                    alert.remove();
                }, 4000);
            }

        });
    </script>
}
