
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Reparacao>

@{
    ViewData["Title"] = "Reparações";
    Layout = "_InternalLayout";

    var reparacoes = Model?.ToList()
        ?? new List<SistemaGestaoOficina.Data.Entities.Reparacao>();

    var emCurso = reparacoes
        .Where(r => !r.Concluida && !r.Cancelada)
        .ToList();

    var concluidas = reparacoes
        .Where(r => r.Concluida && !r.Cancelada)
        .ToList();
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-wrench-adjustable text-primary me-2"></i>
                Reparações
            </h2>

            <p class="text-muted mb-0">
                Acompanhe as reparações em curso e consulte
                o histórico dos serviços concluídos.
            </p>
        </div>

        <!-- VOLTAR À PÁGINA PRINCIPAL -->
        <a asp-controller="Reparacoes"
           asp-action="Create"
           class="btn btn-outline-primary">

            <i class="bi bi-arrow-left me-1"></i>
            Reparações e Faturação
        </a>

    </div>

    <!-- MENSAGENS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <!-- FILTROS E PESQUISA -->
    <div class="row align-items-center g-3 mb-4">

        <div class="col-lg-7">

            <div class="d-flex gap-2 flex-wrap">

                <!-- EM CURSO -->
                <button type="button"
                        class="btn btn-primary filtro-reparacao"
                        data-filtro="curso">

                    <i class="bi bi-clock me-1"></i>
                    Em Curso (@emCurso.Count)
                </button>

                <!-- CONCLUÍDAS -->
                <button type="button"
                        class="btn btn-outline-primary filtro-reparacao"
                        data-filtro="concluida">

                    <i class="bi bi-check-circle me-1"></i>
                    Concluídas (@concluidas.Count)
                </button>

            </div>

        </div>

        <!-- PESQUISA -->
        <div class="col-lg-5">

            <div class="input-group">

                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>

                <input type="search"
                       id="pesquisaReparacoes"
                       class="form-control"
                       placeholder="Pesquisar cliente, veículo ou serviço..." />

            </div>

        </div>

    </div>

    <!-- REPARAÇÕES EM CURSO -->
    <div id="tabelaEmCurso"
         class="card border-0 shadow-sm tabela-reparacoes">

        <div class="card-body p-3">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>Mecânico</th>
                            <th>Tipo de Serviço</th>
                            <th>Data de Início</th>
                            <th>Estado</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var reparacao in emCurso)
                        {
                            var cliente = reparacao.Marcacao?.User;
                            var veiculo = reparacao.Marcacao?.Veiculo;

                            var mecanicos = reparacao.MecanicoReparacaos?
                                .Where(mr => mr.Mecanico != null)
                                .Select(mr => mr.Mecanico!.Nome)
                                .ToList() ?? new List<string>();

                            var nomeCliente = cliente == null
                                ? "Não informado"
                                : $"{cliente.FirstName} {cliente.LastName}";

                            var nomeMecanicos = mecanicos.Count > 0
                                ? string.Join(", ", mecanicos)
                                : "Não atribuído";

                            var matricula = veiculo?.Matricula ?? "";

                            var pesquisa = $"{nomeCliente} {nomeMecanicos} {matricula} {reparacao.TipoServico}"
                                .ToLowerInvariant();

                            <tr class="linha-reparacao"
                                data-pesquisa="@pesquisa">

                                <td class="fw-semibold">
                                    @nomeCliente
                                </td>

                                <td>
                                    @nomeMecanicos
                                </td>

                                <td>
                                    @reparacao.TipoServico
                                </td>

                                <td>
                                    @reparacao.DataInicio.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-clock me-1"></i>
                                        Em Curso
                                    </span>
                                </td>

                                <!-- APENAS VER -->
                                <td class="text-end">

                                    <a asp-controller="Reparacoes"
                                       asp-action="Details"
                                       asp-route-id="@reparacao.Id"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Ver detalhes da reparação">

                                        <i class="bi bi-eye me-1"></i>
                                        Ver
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- SEM RESULTADOS -->
            <div id="semResultadosCurso"
                 class="text-center text-muted py-5 d-none">

                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                Nenhuma reparação em curso encontrada.
            </div>

            <!-- CONTADOR -->
            <div class="border-top mt-3 pt-3 text-muted small">
                <span id="contadorCurso"></span>
            </div>

        </div>

    </div>

    <!-- REPARAÇÕES CONCLUÍDAS -->
    <div id="tabelaConcluidas"
         class="card border-0 shadow-sm tabela-reparacoes d-none">

        <div class="card-body p-3">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>Veículo</th>
                            <th>Tipo de Serviço</th>
                            <th>Valor Total</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var reparacao in concluidas)
                        {
                            var cliente = reparacao.Marcacao?.User;
                            var veiculo = reparacao.Marcacao?.Veiculo;

                            var nomeCliente = cliente == null
                                ? "Não informado"
                                : $"{cliente.FirstName} {cliente.LastName}";

                            var nomeVeiculo = veiculo == null
                                ? "Não informado"
                                : $"{veiculo.Marca} {veiculo.Modelo}";

                            var matricula = veiculo?.Matricula ?? "";

                            var pesquisa = $"{nomeCliente} {nomeVeiculo} {matricula} {reparacao.TipoServico}"
                                .ToLowerInvariant();

                            <tr class="linha-reparacao"
                                data-pesquisa="@pesquisa">

                                <td class="fw-semibold">
                                    @nomeCliente
                                </td>

                                <td>

                                    <div class="fw-semibold">
                                        @nomeVeiculo
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(matricula))
                                    {
                                        <small class="text-muted">
                                            @matricula
                                        </small>
                                    }

                                </td>

                                <td>
                                    @reparacao.TipoServico
                                </td>

                                <td class="fw-bold text-success">
                                    @reparacao.CustoTotal.ToString("N2") €
                                </td>

                                <!-- APENAS VER -->
                                <td class="text-end">

                                    <a asp-controller="Reparacoes"
                                       asp-action="Details"
                                       asp-route-id="@reparacao.Id"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Ver detalhes da reparação">

                                        <i class="bi bi-eye me-1"></i>
                                        Ver
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- SEM RESULTADOS -->
            <div id="semResultadosConcluidas"
                 class="text-center text-muted py-5 d-none">

                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                Nenhuma reparação concluída encontrada.
            </div>

            <!-- CONTADOR -->
            <div class="border-top mt-3 pt-3 text-muted small">
                <span id="contadorConcluidas"></span>
            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const botoes =
                document.querySelectorAll(".filtro-reparacao");

            const pesquisa =
                document.getElementById("pesquisaReparacoes");

            // APENAS DOIS FILTROS
            const tabelas = {
                curso: document.getElementById("tabelaEmCurso"),
                concluida: document.getElementById("tabelaConcluidas")
            };

            const mensagensVazias = {
                curso: document.getElementById("semResultadosCurso"),
                concluida: document.getElementById("semResultadosConcluidas")
            };

            const contadores = {
                curso: document.getElementById("contadorCurso"),
                concluida: document.getElementById("contadorConcluidas")
            };

            let filtroAtual = "curso";

            function atualizarTabela() {

                const termo = pesquisa.value.trim().toLowerCase();

                const tabelaAtual = tabelas[filtroAtual];

                const linhas =
                    tabelaAtual.querySelectorAll(".linha-reparacao");

                let visiveis = 0;

                linhas.forEach(linha => {

                    const texto = linha.dataset.pesquisa || "";

                    const mostrar = texto.includes(termo);

                    linha.classList.toggle("d-none", !mostrar);

                    if (mostrar) {
                        visiveis++;
                    }
                });

                mensagensVazias[filtroAtual].classList.toggle(
                    "d-none",
                    visiveis > 0
                );

                contadores[filtroAtual].textContent =
                    `A mostrar ${visiveis} reparação(ões)`;
            }

            // ALTERNAR ENTRE EM CURSO E CONCLUÍDAS
            botoes.forEach(botao => {

                botao.addEventListener("click", function () {

                    filtroAtual = this.dataset.filtro;

                    botoes.forEach(b => {
                        b.classList.remove("btn-primary");
                        b.classList.add("btn-outline-primary");
                    });

                    this.classList.remove("btn-outline-primary");
                    this.classList.add("btn-primary");

                    Object.values(tabelas).forEach(tabela => {
                        tabela.classList.add("d-none");
                    });

                    tabelas[filtroAtual].classList.remove("d-none");

                    atualizarTabela();
                });
            });

            // PESQUISA EM TEMPO REAL
            pesquisa.addEventListener("input", atualizarTabela);

            // INICIALIZAÇÃO
            atualizarTabela();
        });
    </script>
}
