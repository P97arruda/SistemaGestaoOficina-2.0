
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Reparacao>

@using System.Linq

@{
    ViewData["Title"] = "Reparações";
    Layout = "~/Views/Shared/_InternalLayout.cshtml";

    var reparacoes = (Model
        ?? Enumerable.Empty<SistemaGestaoOficina.Data.Entities.Reparacao>())
        .Where(r => r.Concluida && !r.Cancelada)
        .OrderByDescending(r => r.DataInicio)
        .ToList();
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Reparações concluídas</h2>

            <p class="text-muted mb-0">
                Consulte as reparações concluídas e os serviços
                realizados na oficina.
            </p>
        </div>

        <a asp-controller="Reparacoes"
           asp-action="Create"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar
        </a>

    </div>

    <!-- MENSAGENS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <!-- LISTAGEM DE REPARAÇÕES -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-3">

            <!-- PESQUISA -->
            <div class="mb-4">

                <label for="pesquisaReparacoes"
                       class="form-label fw-semibold">
                    Pesquisar Reparações
                </label>

                <div class="input-group"
                     style="max-width: 550px;">

                    <span class="input-group-text bg-white">
                        <i class="bi bi-search text-muted"></i>
                    </span>

                    <input type="search"
                           id="pesquisaReparacoes"
                           class="form-control"
                           placeholder="Cliente, veículo, matrícula ou serviço..."
                           autocomplete="off" />

                    <button type="button"
                            id="limparPesquisa"
                            class="btn btn-outline-secondary"
                            title="Limpar pesquisa"
                            aria-label="Limpar pesquisa">

                        <i class="bi bi-x-lg"></i>
                    </button>

                </div>

            </div>

            <!-- TABELA -->
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="tabelaReparacoes">

                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>Veículo</th>
                            <th>Tipo de Serviço</th>
                            <th>Data de Conclusão</th>
                            <th>Valor Final</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var reparacao in reparacoes)
                        {
                            var cliente = reparacao.Marcacao?.User;
                            var veiculo = reparacao.Marcacao?.Veiculo;

                            var nomeCliente = cliente == null
                                ? "Não informado"
                                : $"{cliente.FirstName} {cliente.LastName}";

                            var nomeVeiculo = veiculo == null
                                ? "Não informado"
                                : $"{veiculo.Marca} {veiculo.Modelo}";

                            var matricula = veiculo?.Matricula ?? "";

                            var pesquisa = $"{nomeCliente} {nomeVeiculo} {matricula} {reparacao.TipoServico}"
                                .ToLowerInvariant();

                            <tr class="linha-reparacao"
                                data-pesquisa="@pesquisa">

                                <!-- CLIENTE -->
                                <td class="fw-semibold">
                                    @nomeCliente
                                </td>

                                <!-- VEÍCULO -->
                                <td>

                                    <div class="fw-semibold">
                                        @nomeVeiculo
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(matricula))
                                    {
                                        <small class="text-muted">
                                            @matricula
                                        </small>
                                    }

                                </td>

                                <!-- SERVIÇO -->
                                <td>
                                    @reparacao.TipoServico
                                </td>

                                <!-- DATA -->
                                <td>
                                    @(reparacao.DataFim?.ToString("dd/MM/yyyy")
                                        ?? "Não informada")
                                </td>

                                <!-- VALOR -->
                                <td class="fw-bold text-success">
                                    @reparacao.CustoTotal.ToString("N2") €
                                </td>

                                <!-- AÇÕES -->
                                <td class="text-end">

                                    <a asp-controller="Reparacoes"
                                       asp-action="Details"
                                       asp-route-id="@reparacao.Id"
                                       class="btn btn-sm btn-info text-white">

                                        Detalhes
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- NENHUMA REPARAÇÃO -->
            @if (!reparacoes.Any())
            {
                <div class="text-center text-muted py-4">
                    Nenhuma reparação concluída registada.
                </div>
            }

            <!-- NENHUM RESULTADO NA PESQUISA -->
            <div id="semResultados"
                 class="text-center text-muted py-4 d-none">
                Nenhuma reparação encontrada.
            </div>

            <!-- CONTADOR -->
            <div class="border-top mt-3 pt-3 text-muted small">
                <span id="contadorReparacoes">
                    @reparacoes.Count reparações
                </span>
            </div>

        </div>
    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const pesquisa =
                document.getElementById("pesquisaReparacoes");

            const limparPesquisa =
                document.getElementById("limparPesquisa");

            const linhas =
                document.querySelectorAll(".linha-reparacao");

            const semResultados =
                document.getElementById("semResultados");

            const contador =
                document.getElementById("contadorReparacoes");

            function atualizarPesquisa() {

                const termo = pesquisa.value.trim().toLowerCase();

                let encontrados = 0;

                linhas.forEach(function (linha) {

                    const texto = linha.dataset.pesquisa || "";

                    const corresponde = texto.includes(termo);

                    linha.classList.toggle("d-none", !corresponde);

                    if (corresponde) {
                        encontrados++;
                    }
                });

                semResultados.classList.toggle(
                    "d-none",
                    encontrados > 0 || linhas.length === 0
                );

                contador.textContent =
                    `A mostrar ${encontrados} reparação(ões)`;
            }

            pesquisa.addEventListener("input", atualizarPesquisa);

            limparPesquisa.addEventListener("click", function () {
                pesquisa.value = "";
                atualizarPesquisa();
                pesquisa.focus();
            });

            atualizarPesquisa();
        });
    </script>
}
