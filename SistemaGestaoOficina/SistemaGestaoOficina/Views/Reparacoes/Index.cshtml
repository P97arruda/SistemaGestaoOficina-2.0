@model IEnumerable<SistemaGestaoOficina.Data.Entities.Reparacao>

@{
    ViewData["Title"] = "Gestão de Reparações";
    Layout = "_InternalLayout";

    var reparacoes = Model.ToList();
    var emCurso = reparacoes.Count(r => !r.Concluida);
    var concluidas = reparacoes.Count(r => r.Concluida);
}

<div class="container-fluid py-4">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-wrench-adjustable text-primary me-2"></i>
                Gestão de Reparações
            </h2>
            <p class="text-muted mb-0">
                Registe, acompanhe e conclua as reparações da oficina.
            </p>
        </div>

        <a asp-controller="Reparacoes"
           asp-action="Create"
           class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>
            Nova Reparação
        </a>
    </div>

    <!-- Mensagens -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Filtros -->
    <div class="row align-items-center g-3 mb-4">
        <div class="col-lg-7">
            <div class="d-flex gap-2 flex-wrap">
                <button type="button"
                        class="btn btn-primary filtro-reparacao"
                        data-filtro="curso">
                    <i class="bi bi-clock me-1"></i>
                    Em Curso (@emCurso)
                </button>

                <button type="button"
                        class="btn btn-outline-primary filtro-reparacao"
                        data-filtro="concluida">
                    <i class="bi bi-check-circle me-1"></i>
                    Concluídas (@concluidas)
                </button>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>

                <input type="search"
                       id="pesquisaReparacoes"
                       class="form-control"
                       placeholder="Pesquisar por serviço ou ID..." />
            </div>
        </div>
    </div>

    <!-- Tabela -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Serviço</th>
                            <th>Data de Início</th>
                            <th>Data de Fim</th>
                            <th>Custo (€)</th>
                            <th>Estado</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var reparacao in reparacoes)
                        {
                            <tr class="linha-reparacao"
                                data-estado="@(reparacao.Concluida ? "concluida" : "curso")"
                                data-pesquisa="@($"{reparacao.Id} {reparacao.TipoServico}".ToLowerInvariant())">

                                <td class="fw-semibold">
                                    #@reparacao.Id
                                </td>

                                <td>
                                    @reparacao.TipoServico
                                </td>

                                <td>
                                    @reparacao.DataInicio.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @(reparacao.DataFim?.ToString("dd/MM/yyyy") ?? "-")
                                </td>

                                <td class="fw-semibold">
                                    @reparacao.CustoTotal.ToString("N2") €
                                </td>

                                <td>
                                    @if (reparacao.Concluida)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Concluída
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-clock me-1"></i>
                                            Em Curso
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@reparacao.Id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Ver detalhes">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (!reparacao.Concluida)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@reparacao.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar reparação">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="semResultados"
                 class="text-center text-muted py-5 d-none">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                Nenhuma reparação encontrada.
            </div>

            <div class="border-top mt-3 pt-3 text-muted small">
                <span id="contadorReparacoes"></span>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const botoes = document.querySelectorAll(".filtro-reparacao");
            const linhas = document.querySelectorAll(".linha-reparacao");
            const pesquisa = document.getElementById("pesquisaReparacoes");
            const semResultados = document.getElementById("semResultados");
            const contador = document.getElementById("contadorReparacoes");

            let filtroAtual = "curso";

            function atualizarTabela() {
                const termo = pesquisa.value.trim().toLowerCase();
                let visiveis = 0;

                linhas.forEach(linha => {
                    const estado = linha.dataset.estado;
                    const texto = linha.dataset.pesquisa;

                    const mostrar = estado === filtroAtual &&
                                    texto.includes(termo);

                    linha.classList.toggle("d-none", !mostrar);

                    if (mostrar) {
                        visiveis++;
                    }
                });

                semResultados.classList.toggle("d-none", visiveis > 0);

                contador.textContent =
                    `A mostrar ${visiveis} reparação(ões)`;
            }

            botoes.forEach(botao => {
                botao.addEventListener("click", function () {
                    filtroAtual = this.dataset.filtro;

                    botoes.forEach(b => {
                        b.classList.remove("btn-primary");
                        b.classList.add("btn-outline-primary");
                    });

                    this.classList.remove("btn-outline-primary");
                    this.classList.add("btn-primary");

                    atualizarTabela();
                });
            });

            pesquisa.addEventListener("input", atualizarTabela);

            atualizarTabela();
        });
    </script>
}
