@model SistemaGestaoOficina.Models.ReparacaoViewModel

@{
    ViewData["Title"] = "Nova Reparação";
    Layout = "_InternalLayout";
}

<style>
    .repair-page {
        padding: 12px 4px 28px;
    }

    .repair-heading {
        margin-bottom: 20px;
    }

        .repair-heading h2 {
            font-size: 23px;
            font-weight: 700;
        }

        .repair-heading p {
            font-size: 13px;
            color: #667085;
        }

    .repair-navigation {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
    }

        .repair-navigation .btn {
            font-size: 12px;
            font-weight: 600;
            border-radius: 8px;
            padding: 9px 15px;
        }

    .repair-card {
        position: relative;
        background: #fff;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        overflow: visible;
        margin-bottom: 16px;
        box-shadow: 0 3px 12px rgba(16, 24, 40, .04);
    }

        .repair-card:focus-within {
            z-index: 20;
        }

    .repair-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 15px 17px;
        border-bottom: 1px solid #edf0f4;
        border-radius: 12px 12px 0 0;
    }

        .repair-card-header i {
            color: #2563eb;
            font-size: 18px;
        }

        .repair-card-header h5 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
        }

    .repair-card-body {
        padding: 17px;
    }

    .repair-card .form-label {
        font-size: 12px;
        font-weight: 600;
        color: #344054;
    }

    .repair-card .form-control,
    .repair-card .form-select {
        min-height: 39px;
        font-size: 12px;
        border-radius: 8px;
    }

    .repair-card .btn {
        font-size: 12px;
        border-radius: 8px;
    }

    .repair-list {
        min-height: 90px;
        max-height: 190px;
        overflow-y: auto;
        margin-top: 12px;
        padding: 9px;
        border: 1px solid #e9edf3;
        border-radius: 9px;
        background: #f8fafc;
    }

    .repair-mechanic-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 9px 11px;
        margin-bottom: 7px;
        background: #fff;
        border: 1px solid #e5eaf0;
        border-radius: 8px;
        font-size: 12px;
    }

    .repair-empty {
        text-align: center;
        color: #98a2b3;
        padding: 20px 10px;
        font-size: 12px;
    }

    .repair-table-wrapper {
        max-height: 240px;
        overflow: auto;
        border: 1px solid #edf0f4;
        border-radius: 9px;
    }

    .repair-table {
        font-size: 12px;
        margin: 0;
    }

        .repair-table th {
            background: #f8fafc;
            font-size: 11px;
            color: #667085;
            white-space: nowrap;
        }

        .repair-table td,
        .repair-table th {
            padding: 10px 8px;
            vertical-align: middle;
        }

    .repair-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
        font-size: 13px;
    }

        .repair-summary-row span {
            color: #667085;
        }

        .repair-summary-row strong {
            font-weight: 700;
        }

    .repair-summary-divider {
        border: 0;
        border-top: 1px solid #e5eaf0;
        margin: 18px 0;
        opacity: 1;
    }

    .repair-labor-row {
        padding: 12px;
        border-radius: 9px;
        background: #f8fafc;
    }

        .repair-labor-row strong {
            color: #2563eb;
        }

    .repair-total-box {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 11px;
        padding: 17px;
        margin-top: 15px;
    }

    .repair-total-label {
        color: #475467;
        font-size: 12px;
        font-weight: 600;
    }

    .repair-total-value {
        color: #1d4ed8;
        font-size: 29px;
        font-weight: 800;
        margin-top: 6px;
    }

    .repair-total-note {
        font-size: 11px;
        color: #667085;
        margin-top: 8px;
    }

    .repair-booking-help {
        font-size: 11px;
        color: #667085;
        margin-top: 7px;
    }

    /* PESQUISA AUTOMÁTICA */
    .campo-pesquisa {
        position: relative;
    }

    .pesquisa-resultados {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        z-index: 1050;
        max-height: 220px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    }

    .pesquisa-resultado {
        display: block;
        width: 100%;
        padding: 10px 12px;
        border: 0;
        border-bottom: 1px solid #f1f3f5;
        background: #fff;
        text-align: left;
        font-size: 12px;
        cursor: pointer;
    }

        .pesquisa-resultado:hover,
        .pesquisa-resultado:focus {
            background: #eff6ff;
            color: #0d6efd;
        }

    .repair-date-locked {
        background-color: #f1f5f9 !important;
        color: #475467 !important;
        opacity: 1 !important;
        cursor: not-allowed;
    }

    @@media (min-width: 1200px) {
        .repair-summary-card {
            position: sticky;
            top: 18px;
        }
    }

    @@media (max-width: 767px) {
        .repair-card-body {
            padding: 13px;
        }

        .repair-heading h2 {
            font-size: 20px;
        }

        .repair-navigation {
            width: 100%;
        }
    }
</style>

<div class="container-fluid repair-page">

    <!-- CABEÇALHO -->
    <div class="repair-heading d-flex justify-content-between align-items-center flex-wrap gap-3">

        <div>
            <h2>
                <i class="bi bi-wrench-adjustable text-primary me-2"></i>
                Nova Reparação
            </h2>

            <p class="mb-0">
                Registe os dados da reparação, os mecânicos
                responsáveis e as peças utilizadas.
            </p>
        </div>

        <div class="repair-navigation">

            <a asp-controller="Reparacoes"
               asp-action="Index"
               class="btn btn-outline-primary">

                <i class="bi bi-list-check me-1"></i>
                Ver Reparações

            </a>

        </div>
    </div>

    <!-- FORMULÁRIO -->
    <form asp-controller="Reparacoes"
          asp-action="Create"
          method="post"
          id="repairForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger small mb-3"></div>

        <div class="row g-3">

            <!-- INFORMAÇÕES DA REPARAÇÃO -->
            <div class="col-12 col-xl-4">

                <div class="repair-card">

                    <div class="repair-card-header">
                        <i class="bi bi-clipboard-check"></i>
                        <h5>Informações da Reparação</h5>
                    </div>

                    <div class="repair-card-body">

                        <!-- MARCAÇÃO COM PESQUISA -->
                        <div class="mb-3">

                            <label for="pesquisaMarcacao"
                                   class="form-label">
                                Marcação *
                            </label>

                            <div class="campo-pesquisa"
                                 id="areaPesquisaMarcacao">

                                <input type="text"
                                       id="pesquisaMarcacao"
                                       class="form-control"
                                       placeholder="Pesquisar cliente, matrícula ou serviço..."
                                       autocomplete="off"
                                       aria-autocomplete="list"
                                       aria-controls="resultadosMarcacao" />

                                <div id="resultadosMarcacao"
                                     class="pesquisa-resultados d-none"
                                     role="listbox"></div>

                            </div>

                            <!-- VALOR ENVIADO AO CONTROLLER -->
                            <select asp-for="MarcacaoId"
                                    id="MarcacaoId"
                                    class="d-none"
                                    tabindex="-1"
                                    aria-hidden="true">

                                <option value="">
                                    Selecione uma marcação...
                                </option>

                                @if (ViewBag.Marcacoes != null)
                                {
                                    @foreach (var marcacao in ViewBag.Marcacoes)
                                    {
                                        var cliente = marcacao.User?.FullName
                                            ?? "Cliente não identificado";

                                        var matricula = marcacao.Veiculo?.Matricula
                                            ?? "Sem matrícula";

                                        var horario = marcacao.DataHora
                                            .ToString("dd/MM/yyyy HH:mm");

                                        <option value="@marcacao.Id"
                                                data-servico="@marcacao.TipoServico"
                                                data-data="@marcacao.DataHora.ToString("yyyy-MM-ddTHH:mm")"
                                                data-data-exibicao="@horario">
                                            @($"{cliente} | {matricula} | {horario} | {marcacao.TipoServico}")
                                        </option>
                                    }
                                }

                            </select>

                            <div class="repair-booking-help">
                                <i class="bi bi-info-circle me-1"></i>
                                Cliente | Matrícula | Horário | Serviço
                            </div>

                            <span asp-validation-for="MarcacaoId"
                                  class="text-danger small"></span>
                        </div>

                        <!-- TIPO DE SERVIÇO -->
                        <div class="mb-3">

                            <label asp-for="TipoServico"
                                   class="form-label">
                                Tipo de Serviço
                            </label>

                            <input asp-for="TipoServico"
                                   class="form-control repair-date-locked"
                                   placeholder="Preenchido pela marcação"
                                   readonly
                                   tabindex="-1" />

                            <span asp-validation-for="TipoServico"
                                  class="text-danger small"></span>
                        </div>

                        <!-- DATAS -->
                        <div class="row g-2 mb-3">

                            <!-- DATA DE INÍCIO BLOQUEADA -->
                            <div class="col-12 col-md-6">

                                <label for="dataInicioExibicao"
                                       class="form-label">
                                    Data de Início
                                </label>

                                <input type="text"
                                       id="dataInicioExibicao"
                                       class="form-control repair-date-locked"
                                       placeholder="Preenchida pela marcação"
                                       disabled />

                                <!-- DATA REAL ENVIADA AO CONTROLLER -->
                                <input asp-for="DataInicio"
                                       type="hidden"
                                       id="DataInicio" />

                                <span asp-validation-for="DataInicio"
                                      class="text-danger small"></span>
                            </div>

                            <!-- DATA DE FIM -->
                            <div class="col-12 col-md-6">

                                <label asp-for="DataFim"
                                       class="form-label">
                                    Data de Fim
                                </label>

                                <input asp-for="DataFim"
                                       type="datetime-local"
                                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                                       class="form-control" />

                                <span asp-validation-for="DataFim"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <!-- ESTADO REMOVIDO -->

                    </div>
                </div>

            </div>

            <!-- MECÂNICOS E PEÇAS -->
            <div class="col-12 col-xl-5">

                <!-- MECÂNICOS -->
                <div class="repair-card">

                    <div class="repair-card-header">
                        <i class="bi bi-people"></i>
                        <h5>Mecânicos Responsáveis</h5>
                    </div>

                    <div class="repair-card-body">

                        <div class="row g-2 align-items-end">

                            <div class="col-8">

                                <label for="pesquisaMecanico"
                                       class="form-label">
                                    Mecânico
                                </label>

                                <div class="campo-pesquisa"
                                     id="areaPesquisaMecanico">

                                    <input type="text"
                                           id="pesquisaMecanico"
                                           class="form-control"
                                           placeholder="Pesquisar mecânico..."
                                           autocomplete="off"
                                           aria-autocomplete="list"
                                           aria-controls="resultadosMecanico" />

                                    <div id="resultadosMecanico"
                                         class="pesquisa-resultados d-none"
                                         role="listbox"></div>

                                </div>

                                <!-- SELECT ORIGINAL OCULTO -->
                                <select id="mecanicoSelect"
                                        class="d-none"
                                        tabindex="-1"
                                        aria-hidden="true">

                                    <option value="">
                                        Selecione...
                                    </option>

                                    @if (ViewBag.Mecanicos != null)
                                    {
                                        @foreach (var mecanico in ViewBag.Mecanicos)
                                        {
                                            <option value="@mecanico.Id">
                                                @mecanico.Nome
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                            <div class="col-4">

                                <button type="button"
                                        class="btn btn-outline-primary w-100"
                                        onclick="adicionarMecanico()">

                                    <i class="bi bi-plus-lg"></i>
                                    Adicionar

                                </button>

                            </div>
                        </div>

                        <div class="text-muted small mt-2">
                            Mão de obra: 45,00 € por mecânico.
                        </div>

                        <div id="listaMecanicos"
                             class="repair-list"></div>

                        <div id="mecanicosInputs"></div>

                    </div>
                </div>

                <!-- PEÇAS -->
                <div class="repair-card">

                    <div class="repair-card-header">
                        <i class="bi bi-gear"></i>
                        <h5>Peças Utilizadas</h5>
                    </div>

                    <div class="repair-card-body">

                        <div class="row g-2 align-items-end mb-3">

                            <div class="col-6">

                                <label for="pesquisaPeca"
                                       class="form-label">
                                    Peça
                                </label>

                                <div class="campo-pesquisa"
                                     id="areaPesquisaPeca">

                                    <input type="text"
                                           id="pesquisaPeca"
                                           class="form-control"
                                           placeholder="Pesquisar peça..."
                                           autocomplete="off"
                                           aria-autocomplete="list"
                                           aria-controls="resultadosPeca" />

                                    <div id="resultadosPeca"
                                         class="pesquisa-resultados d-none"
                                         role="listbox"></div>

                                </div>

                                <!-- SELECT ORIGINAL OCULTO -->
                                <select id="pecaSelect"
                                        class="d-none"
                                        tabindex="-1"
                                        aria-hidden="true">

                                    <option value="">
                                        Selecione...
                                    </option>

                                    @if (ViewBag.Pecas != null)
                                    {
                                        @foreach (var peca in ViewBag.Pecas)
                                        {
                                            <option value="@peca.Id"
                                                    data-preco="@peca.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                @peca.Nome
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                            <div class="col-2">

                                <label for="quantidadePeca"
                                       class="form-label">
                                    Qtd.
                                </label>

                                <input id="quantidadePeca"
                                       type="number"
                                       class="form-control"
                                       value="1"
                                       min="1"
                                       step="1" />

                            </div>

                            <div class="col-4">

                                <button type="button"
                                        class="btn btn-outline-primary w-100"
                                        onclick="adicionarPeca()">

                                    <i class="bi bi-plus-lg"></i>
                                    Adicionar

                                </button>

                            </div>

                        </div>

                        <div class="repair-table-wrapper">

                            <table class="table repair-table">

                                <thead>
                                    <tr>
                                        <th>Peça</th>
                                        <th>Qtd.</th>
                                        <th class="text-end">Preço</th>
                                        <th class="text-end">Subtotal</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody id="tabelaPecas"></tbody>

                            </table>

                        </div>

                        <div id="pecasInputs"></div>

                    </div>
                </div>

            </div>

            <!-- RESUMO DA REPARAÇÃO -->
            <div class="col-12 col-xl-3">

                <div class="repair-card repair-summary-card">

                    <div class="repair-card-header">
                        <i class="bi bi-receipt"></i>
                        <h5>Resumo da Reparação</h5>
                    </div>

                    <div class="repair-card-body">

                        <div class="repair-summary-row">
                            <span>Quantidade de peças</span>
                            <strong id="totalQuantidadePecas">0</strong>
                        </div>

                        <div class="repair-summary-row">
                            <span>Mecânicos responsáveis</span>
                            <strong id="totalMecanicos">0</strong>
                        </div>

                        <hr class="repair-summary-divider" />

                        <div class="repair-summary-row">
                            <span>Total das peças</span>
                            <strong id="totalPecasVisual">
                                0,00 €
                            </strong>
                        </div>

                        <div class="repair-summary-row repair-labor-row">

                            <span>
                                <i class="bi bi-tools me-1"></i>
                                Mão de obra
                            </span>

                            <strong id="totalMaoDeObra">
                                0,00 €
                            </strong>

                        </div>

                        <div class="text-muted small mt-2">
                            45,00 € ×
                            <span id="quantidadeMecanicosValor">0</span>
                            mecânico(s)
                        </div>

                        <hr class="repair-summary-divider" />

                        <div class="repair-total-box">

                            <div class="repair-total-label">
                                Custo Total da Reparação
                            </div>

                            <div id="totalVisual"
                                 class="repair-total-value">
                                0,00 €
                            </div>

                            <div class="repair-total-note">
                                Total das peças + mão de obra
                            </div>

                        </div>

                        <!-- VALOR ENVIADO AO CONTROLLER -->
                        <input asp-for="CustoTotal"
                               type="hidden" />

                        <span asp-validation-for="CustoTotal"
                              class="text-danger small"></span>

                        <!-- CONCLUIR REPARAÇÃO -->
                        <div class="d-flex justify-content-center mt-4 pt-2">

                            <button type="submit"
                                    class="btn btn-primary px-4 py-2">

                                <i class="bi bi-check-lg me-2"></i>
                                Concluir Reparação

                            </button>

                        </div>

                    </div>
                </div>

            </div>

        </div>
    </form>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const CUSTO_POR_MECANICO = 45.00;

        const mecanicos = [];
        const pecas = [];

        // FORMATAR VALORES EM EUROS
        const formatarEuro = valor =>
            new Intl.NumberFormat("pt-PT", {
                style: "currency",
                currency: "EUR"
            }).format(valor);

        // CAMPOS PRINCIPAIS
        const marcacaoSelect =
            document.getElementById("MarcacaoId");

        const tipoServicoInput =
            document.getElementById("TipoServico");

        const dataInicioInput =
            document.getElementById("DataInicio");

        const dataInicioExibicao =
            document.getElementById("dataInicioExibicao");

        const dataFimInput =
            document.getElementById("DataFim");

        // NORMALIZAR TEXTO
        function normalizar(texto) {

            return texto.normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toLowerCase();
        }

        // PESQUISA REUTILIZÁVEL
        function configurarPesquisa(
            inputId,
            selectId,
            resultadosId,
            areaId,
            mensagemVazia
        ) {
            const input =
                document.getElementById(inputId);

            const select =
                document.getElementById(selectId);

            const resultados =
                document.getElementById(resultadosId);

            const area =
                document.getElementById(areaId);

            // FECHAR LISTA
            function fecharResultados() {

                resultados.classList.add("d-none");
                resultados.replaceChildren();

                input.setAttribute("aria-expanded", "false");
            }

            // MOSTRAR TEXTO SELECIONADO
            function sincronizarTexto() {

                const opcao =
                    select.options[select.selectedIndex];

                if (select.value && opcao) {
                    input.value = opcao.textContent.trim();
                } else {
                    input.value = "";
                }
            }

            // FILTRAR RESULTADOS
            function mostrarResultados() {

                resultados.replaceChildren();

                const busca =
                    normalizar(input.value.trim());

                // AGUARDAR PELO MENOS UMA LETRA
                if (busca.length === 0) {

                    fecharResultados();
                    return;
                }

                const encontrados =
                    Array.from(select.options)
                        .filter(opcao =>
                            opcao.value &&
                            normalizar(
                                opcao.textContent.trim()
                            ).includes(busca))
                        .slice(0, 8);

                if (encontrados.length === 0) {

                    const aviso =
                        document.createElement("div");

                    aviso.className =
                        "text-muted small p-3";

                    aviso.textContent =
                        mensagemVazia;

                    resultados.appendChild(aviso);
                }

                encontrados.forEach(opcao => {

                    const botao =
                        document.createElement("button");

                    botao.type = "button";
                    botao.className = "pesquisa-resultado";
                    botao.textContent =
                        opcao.textContent.trim();

                    botao.setAttribute("role", "option");

                    botao.addEventListener("click", function () {

                        select.value = opcao.value;

                        sincronizarTexto();

                        fecharResultados();

                        select.dispatchEvent(
                            new Event("change", {
                                bubbles: true
                            })
                        );
                    });

                    resultados.appendChild(botao);
                });

                resultados.classList.remove("d-none");

                input.setAttribute("aria-expanded", "true");
            }

            // PESQUISAR AO ESCREVER
            input.addEventListener("input", function () {

                if (select.value) {

                    select.value = "";

                    select.dispatchEvent(
                        new Event("change", {
                            bubbles: true
                        })
                    );
                }

                mostrarResultados();
            });

            // NÃO MOSTRAR NOMES COM O CAMPO VAZIO
            input.addEventListener("focus", function () {

                if (input.value.trim().length === 0) {

                    fecharResultados();
                    return;
                }

                if (!select.value) {
                    mostrarResultados();
                }
            });

            // ENTER E ESCAPE
            input.addEventListener("keydown", function (event) {

                if (event.key === "Escape") {
                    fecharResultados();
                }

                if (event.key === "Enter") {

                    event.preventDefault();

                    const primeiro =
                        resultados.querySelector("button");

                    if (primeiro &&
                        !resultados.classList.contains("d-none")) {

                        primeiro.click();
                    }
                }
            });

            // FECHAR AO CLICAR FORA
            document.addEventListener("click", function (event) {

                if (!area.contains(event.target)) {
                    fecharResultados();
                }
            });

            // LIMPAR SELEÇÃO
            function limpar() {

                select.value = "";
                input.value = "";

                fecharResultados();
            }

            return {
                sincronizarTexto,
                fecharResultados,
                limpar
            };
        }

        // PESQUISA DE MARCAÇÕES
        const pesquisaMarcacoes = configurarPesquisa(
            "pesquisaMarcacao",
            "MarcacaoId",
            "resultadosMarcacao",
            "areaPesquisaMarcacao",
            "Nenhuma marcação encontrada."
        );

        // PESQUISA DE MECÂNICOS
        const pesquisaMecanicos = configurarPesquisa(
            "pesquisaMecanico",
            "mecanicoSelect",
            "resultadosMecanico",
            "areaPesquisaMecanico",
            "Nenhum mecânico encontrado."
        );

        // PESQUISA DE PEÇAS
        const pesquisaPecas = configurarPesquisa(
            "pesquisaPeca",
            "pecaSelect",
            "resultadosPeca",
            "areaPesquisaPeca",
            "Nenhuma peça encontrada."
        );

        // AO SELECIONAR A MARCAÇÃO
        marcacaoSelect.addEventListener("change", function () {

            const opcao =
                this.options[this.selectedIndex];

            // TIPO DE SERVIÇO
            tipoServicoInput.value =
                opcao?.dataset.servico || "";

            // DATA ENVIADA AO CONTROLLER
            dataInicioInput.value =
                opcao?.dataset.data || "";

            // DATA EXIBIDA, SEM PERMITIR EDIÇÃO
            dataInicioExibicao.value =
                opcao?.dataset.dataExibicao || "";
        });

        // ADICIONAR MECÂNICO
        function adicionarMecanico() {

            const select =
                document.getElementById("mecanicoSelect");

            const id = Number(select.value);

            if (!id) {

                alert("Selecione um mecânico.");
                return;
            }

            if (mecanicos.some(m => m.id === id)) {

                alert("Este mecânico já foi adicionado.");
                return;
            }

            mecanicos.push({
                id: id,
                nome: select.options[select.selectedIndex]
                    .text.trim()
            });

            pesquisaMecanicos.limpar();

            atualizarMecanicos();
        }

        // REMOVER MECÂNICO
        function removerMecanico(id) {

            const indice =
                mecanicos.findIndex(m => m.id === id);

            if (indice !== -1) {
                mecanicos.splice(indice, 1);
            }

            atualizarMecanicos();
        }

        // ATUALIZAR MECÂNICOS
        function atualizarMecanicos() {

            const lista =
                document.getElementById("listaMecanicos");

            const inputs =
                document.getElementById("mecanicosInputs");

            lista.replaceChildren();
            inputs.replaceChildren();

            if (mecanicos.length === 0) {

                const vazio =
                    document.createElement("div");

                vazio.className = "repair-empty";
                vazio.textContent =
                    "Nenhum mecânico adicionado.";

                lista.appendChild(vazio);
            }

            mecanicos.forEach((mecanico, index) => {

                const item =
                    document.createElement("div");

                item.className = "repair-mechanic-item";

                const nome =
                    document.createElement("span");

                nome.textContent = mecanico.nome;

                const botao =
                    document.createElement("button");

                botao.type = "button";
                botao.className =
                    "btn btn-sm btn-outline-danger";

                botao.textContent = "Remover";

                botao.addEventListener("click", () =>
                    removerMecanico(mecanico.id));

                item.append(nome, botao);
                lista.appendChild(item);

                // INPUT ENVIADO AO CONTROLLER
                const input =
                    document.createElement("input");

                input.type = "hidden";
                input.name = `MecanicoIds[${index}]`;
                input.value = mecanico.id;

                inputs.appendChild(input);
            });

            document.getElementById("totalMecanicos")
                .textContent = mecanicos.length;

            document.getElementById("quantidadeMecanicosValor")
                .textContent = mecanicos.length;

            atualizarResumo();
        }

        // ADICIONAR PEÇA
        function adicionarPeca() {

            const select =
                document.getElementById("pecaSelect");

            const id = Number(select.value);

            const quantidade = Number(
                document.getElementById("quantidadePeca").value
            );

            if (!id) {

                alert("Selecione uma peça.");
                return;
            }

            if (!Number.isSafeInteger(quantidade) ||
                quantidade < 1) {

                alert("Informe uma quantidade válida.");
                return;
            }

            const opcao =
                select.options[select.selectedIndex];

            const preco = Number(opcao.dataset.preco);

            if (!Number.isFinite(preco) || preco < 0) {

                alert("Preço inválido.");
                return;
            }

            const existente =
                pecas.find(p => p.id === id);

            if (existente) {

                existente.quantidade += quantidade;

            } else {

                pecas.push({
                    id: id,
                    nome: opcao.text.trim(),
                    preco: preco,
                    quantidade: quantidade
                });
            }

            pesquisaPecas.limpar();

            document.getElementById("quantidadePeca")
                .value = 1;

            atualizarPecas();
        }

        // REMOVER PEÇA
        function removerPeca(id) {

            const indice =
                pecas.findIndex(p => p.id === id);

            if (indice !== -1) {
                pecas.splice(indice, 1);
            }

            atualizarPecas();
        }

        // ATUALIZAR PEÇAS
        function atualizarPecas() {

            const tabela =
                document.getElementById("tabelaPecas");

            const inputs =
                document.getElementById("pecasInputs");

            tabela.replaceChildren();
            inputs.replaceChildren();

            if (pecas.length === 0) {

                const linha =
                    document.createElement("tr");

                const coluna =
                    document.createElement("td");

                coluna.colSpan = 5;
                coluna.className = "repair-empty";
                coluna.textContent =
                    "Nenhuma peça adicionada.";

                linha.appendChild(coluna);
                tabela.appendChild(linha);
            }

            pecas.forEach(peca => {

                const subtotal =
                    peca.preco * peca.quantidade;

                const linha =
                    document.createElement("tr");

                function criarColuna(texto, classe = "") {

                    const td =
                        document.createElement("td");

                    td.className = classe;
                    td.textContent = texto;

                    return td;
                }

                linha.appendChild(
                    criarColuna(peca.nome)
                );

                linha.appendChild(
                    criarColuna(
                        peca.quantidade,
                        "text-center"
                    )
                );

                linha.appendChild(
                    criarColuna(
                        formatarEuro(peca.preco),
                        "text-end"
                    )
                );

                linha.appendChild(
                    criarColuna(
                        formatarEuro(subtotal),
                        "text-end fw-semibold"
                    )
                );

                const colunaAcao =
                    document.createElement("td");

                const botao =
                    document.createElement("button");

                botao.type = "button";
                botao.className =
                    "btn btn-sm btn-outline-danger";

                botao.textContent = "Remover";

                botao.addEventListener("click", () =>
                    removerPeca(peca.id));

                colunaAcao.appendChild(botao);
                linha.appendChild(colunaAcao);
                tabela.appendChild(linha);

                // INPUTS ENVIADOS AO CONTROLLER
                function criarInput(nome, valor) {

                    const input =
                        document.createElement("input");

                    input.type = "hidden";
                    input.name = nome;
                    input.value = valor;

                    inputs.appendChild(input);
                }

                criarInput("pecaIds", peca.id);
                criarInput("quantidades", peca.quantidade);
            });

            atualizarResumo();
        }

        // ATUALIZAR RESUMO
        function atualizarResumo() {

            const totalPecas = pecas.reduce(
                (total, peca) =>
                    total + peca.preco * peca.quantidade,
                0
            );

            const quantidadePecas = pecas.reduce(
                (total, peca) =>
                    total + peca.quantidade,
                0
            );

            const custoMaoDeObra =
                mecanicos.length * CUSTO_POR_MECANICO;

            const custoTotal =
                totalPecas + custoMaoDeObra;

            document.getElementById("totalQuantidadePecas")
                .textContent = quantidadePecas;

            document.getElementById("totalPecasVisual")
                .textContent = formatarEuro(totalPecas);

            document.getElementById("totalMaoDeObra")
                .textContent = formatarEuro(custoMaoDeObra);

            document.getElementById("totalVisual")
                .textContent = formatarEuro(custoTotal);

            document.getElementById("CustoTotal")
                .value = custoTotal.toFixed(2).replace(".", ",");
        }

        // VALIDAÇÃO DO FORMULÁRIO
        document.getElementById("repairForm")
            .addEventListener("submit", function (event) {

                // EXIGIR MARCAÇÃO
                if (!marcacaoSelect.value) {

                    event.preventDefault();

                    alert("Selecione uma marcação.");
                    return;
                }

                // EXIGIR MECÂNICO
                if (mecanicos.length === 0) {

                    event.preventDefault();

                    alert("Selecione pelo menos um mecânico.");
                    return;
                }

                // EXIGIR PEÇA
                if (pecas.length === 0) {

                    event.preventDefault();

                    alert("Adicione pelo menos uma peça à reparação.");
                    return;
                }

                // EXIGIR DATA DE INÍCIO
                if (!dataInicioInput.value) {

                    event.preventDefault();

                    alert("Selecione uma marcação válida.");
                    return;
                }

                // EXIGIR DATA DE FIM
                if (!dataFimInput.value) {

                    event.preventDefault();

                    alert("Informe a data de fim da reparação.");
                    return;
                }

                // VALIDAR AS DATAS
                if (dataFimInput.value < dataInicioInput.value) {

                    event.preventDefault();

                    alert(
                        "A data de fim não pode ser anterior à data de início."
                    );

                    return;
                }
            });

        // INICIALIZAÇÃO
        atualizarMecanicos();
        atualizarPecas();

        pesquisaMarcacoes.sincronizarTexto();

        marcacaoSelect.dispatchEvent(
            new Event("change")
        );

    </script>
}
