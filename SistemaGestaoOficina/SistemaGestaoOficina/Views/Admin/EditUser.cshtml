
@model SistemaGestaoOficina.Models.EditUserViewModel

@{
    Layout = "_InternalLayout";

    bool isMecanico = Model.Role == "Mecanico";

    ViewData["Title"] = isMecanico
        ? "Editar Mecânico"
        : "Editar Rececionista";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            @(isMecanico ? "Editar Mecânico" : "Editar Rececionista")
        </h2>

        <p class="text-muted mb-0">
            Altere os dados da conta do funcionário.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="row">
                <div class="col-md-6">

                    <form asp-controller="Admin"
                          asp-action="EditUser"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="Role" type="hidden" />

                        <!-- Tipo de Utilizador -->
                        <div class="mb-3">
                            <label class="form-label">
                                Tipo de Utilizador
                            </label>

                            <input value="@(isMecanico ? "Mecânico" : "Rececionista")"
                                   class="form-control"
                                   readonly />
                        </div>

                        <!-- Fotografia -->
                        <div class="mb-4">

                            <label asp-for="ImageFile"
                                   class="form-label fw-semibold">
                                Fotografia do Funcionário
                            </label>

                            <div class="d-flex align-items-center gap-3 mb-3">

                                <img id="imagePreview"
                                     src="@Model.ImageUrl"
                                     alt="Fotografia do funcionário"
                                     class="rounded-circle border"
                                     style="width: 100px; height: 100px; object-fit: cover;"
                                     onerror="this.style.display='none'; document.getElementById('imagePlaceholder').classList.remove('d-none'); document.getElementById('imagePlaceholder').classList.add('d-flex');" />

                                <div id="imagePlaceholder"
                                     class="rounded-circle border bg-light d-none align-items-center justify-content-center"
                                     style="width: 100px; height: 100px;">

                                    <span class="text-muted small">
                                        Sem foto
                                    </span>

                                </div>

                            </div>

                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   id="imageFileInput" />

                            <span asp-validation-for="ImageFile"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Formatos permitidos: JPG, PNG ou WebP.
                                Tamanho máximo: 2 MB.
                                Se não selecionar uma nova fotografia,
                                a atual será mantida.
                            </small>

                        </div>

                        <!-- Nome -->
                        <div class="mb-3">

                            <label asp-for="FirstName"
                                   class="form-label">
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Apelido -->
                        <div class="mb-3">

                            <label asp-for="LastName"
                                   class="form-label">
                            </label>

                            <input asp-for="LastName"
                                   class="form-control" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Email -->
                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Contacto -->
                        <div class="mb-3">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Especialidade e Estado -->
                        @if (isMecanico)
                        {
                            <div class="mb-3">

                                <label asp-for="TipoReparacaoId"
                                       class="form-label">
                                </label>

                                <select asp-for="TipoReparacaoId"
                                        asp-items="ViewBag.TiposReparacao"
                                        class="form-select">

                                    <option value="">
                                        Selecione uma especialidade
                                    </option>

                                </select>

                                <span asp-validation-for="TipoReparacaoId"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="mb-3">

                                <label asp-for="Ativo"
                                       class="form-label">
                                    Estado do Mecânico
                                </label>

                                <select asp-for="Ativo"
                                        class="form-select">

                                    <option value="true">Ativo</option>
                                    <option value="false">Inativo</option>

                                </select>

                                <span asp-validation-for="Ativo"
                                      class="text-danger">
                                </span>

                                <small class="text-muted">
                                    Um mecânico com marcações agendadas
                                    não poderá ser desativado.
                                </small>

                            </div>
                        }

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar Alterações
                            </button>

                            @if (isMecanico)
                            {
                                <a asp-controller="Mecanicos"
                                   asp-action="Index"
                                   class="btn btn-secondary">
                                    Voltar
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Admin"
                                   asp-action="Rececionistas"
                                   class="btn btn-secondary">
                                    Voltar
                                </a>
                            }

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const imageInput = document.getElementById("imageFileInput");
            const imagePreview = document.getElementById("imagePreview");
            const imagePlaceholder = document.getElementById("imagePlaceholder");

            imageInput.addEventListener("change", function () {

                const file = this.files[0];

                if (!file) {
                    return;
                }

                const allowedTypes = [
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                ];

                if (!allowedTypes.includes(file.type)) {
                    alert("Selecione uma imagem JPG, PNG ou WebP.");
                    this.value = "";
                    return;
                }

                if (file.size > 2 * 1024 * 1024) {
                    alert("A fotografia deve ter no máximo 2 MB.");
                    this.value = "";
                    return;
                }

                const reader = new FileReader();

                reader.onload = function (event) {

                    imagePreview.src = event.target.result;
                    imagePreview.style.display = "block";

                    imagePlaceholder.classList.remove("d-flex");
                    imagePlaceholder.classList.add("d-none");
                };

                reader.readAsDataURL(file);
            });
        });
    </script>
}
