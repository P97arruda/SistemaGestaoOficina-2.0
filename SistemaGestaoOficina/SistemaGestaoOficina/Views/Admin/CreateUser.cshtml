
@model SistemaGestaoOficina.Models.CreateUserViewModel

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Criar Utilizador";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Criar Utilizador
        </h2>

        <p class="text-muted mb-0">
            Registe um novo funcionário na OficinaCET107.
        </p>
    </div>

    @if (ViewBag.Message != null)
    {
        <div id="successAlert"
             class="alert alert-success alert-dismissible fade show"
             role="alert">

            @ViewBag.Message

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="row">
                <div class="col-md-6">

                    <form asp-controller="Admin"
                          asp-action="CreateUser"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Fotografia -->
                        <div class="mb-3">

                            <label asp-for="ImageFile"
                                   class="form-label">
                            </label>

                            <div class="d-flex align-items-center gap-3 mb-2">

                                <div id="photoPreviewContainer"
                                     class="rounded-circle border bg-light d-flex align-items-center justify-content-center overflow-hidden"
                                     style="width: 90px; height: 90px; flex-shrink: 0;">

                                    <span id="photoPlaceholder"
                                          class="text-secondary"
                                          style="font-size: 30px;">
                                        &#128247;
                                    </span>

                                    <img id="photoPreview"
                                         class="d-none"
                                         alt="Fotografia selecionada"
                                         style="width: 100%; height: 100%; object-fit: cover;" />

                                </div>

                                <div>
                                    <input asp-for="ImageFile"
                                           type="file"
                                           class="form-control"
                                           accept=".jpg,.jpeg,.png,.webp" />

                                    <small class="text-muted">
                                        Fotografia opcional. JPG, PNG ou WebP. Máximo 2 MB.
                                    </small>
                                </div>

                            </div>

                            <span asp-validation-for="ImageFile"
                                  class="text-danger">
                            </span>

                            <div id="photoError"
                                 class="text-danger small"
                                 role="alert"
                                 aria-live="polite">
                            </div>

                        </div>

                        <!-- Tipo de utilizador -->
                        <div class="mb-3">

                            <label asp-for="Role"
                                   class="form-label">
                            </label>

                            <select asp-for="Role"
                                    class="form-select"
                                    id="roleSelect">

                                <option value="">Selecione...</option>
                                <option value="Rececionista">Rececionista</option>

                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Nome -->
                        <div class="mb-3">

                            <label asp-for="FirstName"
                                   class="form-label">
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Apelido -->
                        <div class="mb-3">

                            <label asp-for="LastName"
                                   class="form-label">
                            </label>

                            <input asp-for="LastName"
                                   class="form-control" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Email -->
                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Contacto -->
                        <div class="mb-3">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Botões -->
                        <button type="submit"
                                class="btn btn-primary">
                            Criar Conta
                        </button>

                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Voltar
                        </a>

                    </form>

                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Pré-visualização da fotografia
            const inputFoto = document.getElementById("ImageFile");
            const previewFoto = document.getElementById("photoPreview");
            const placeholder = document.getElementById("photoPlaceholder");
            const photoError = document.getElementById("photoError");

            let imageUrl = null;

            function clearPhoto() {
                if (imageUrl) {
                    URL.revokeObjectURL(imageUrl);
                    imageUrl = null;
                }

                previewFoto.removeAttribute("src");
                previewFoto.classList.add("d-none");
                placeholder.classList.remove("d-none");
            }

            inputFoto.addEventListener("change", function () {
                photoError.textContent = "";
                clearPhoto();

                const file = this.files[0];

                if (!file) return;

                const allowedTypes = [
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                ];

                if (!allowedTypes.includes(file.type) ||
                    file.size === 0 ||
                    file.size > 2 * 1024 * 1024) {

                    photoError.textContent =
                        "Escolha uma fotografia JPG, PNG ou WebP com até 2 MB.";

                    this.value = "";
                    return;
                }

                imageUrl = URL.createObjectURL(file);

                previewFoto.onload = function () {
                    if (imageUrl) {
                        URL.revokeObjectURL(imageUrl);
                        imageUrl = null;
                    }
                };

                previewFoto.src = imageUrl;
                previewFoto.classList.remove("d-none");
                placeholder.classList.add("d-none");
            });

            // Ocultar mensagem de sucesso após 4 segundos
            const successAlert = document.getElementById("successAlert");

            if (successAlert) {
                setTimeout(function () {
                    successAlert.remove();
                }, 4000);
            }

        });
    </script>
}
