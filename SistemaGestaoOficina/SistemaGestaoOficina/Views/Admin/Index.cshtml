
@using System
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
    ViewData["Title"] = "Painel do Administrador";

    var meses = ViewBag.MesesLabels as string[]
        ?? Array.Empty<string>();

    var ganhos = ViewBag.GanhosMensais as decimal[]
        ?? Array.Empty<decimal>();
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .admin-financeiro {
        padding: 10px 0 30px;
        color: #172033;
    }

    .admin-financeiro-titulo {
        font-size: 27px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .admin-financeiro-subtitulo {
        font-size: 13px;
        color: #667085;
        margin-bottom: 28px;
    }

    .admin-financeiro-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 5px 20px rgba(16, 24, 40, .05);
    }

    .admin-financeiro-cabecalho {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 30px;
    }

    .admin-financeiro-identidade {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .admin-financeiro-icone {
        width: 50px;
        height: 50px;
        background: #eff6ff;
        color: #0d6efd;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .admin-financeiro-identidade h2 {
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .admin-financeiro-identidade p {
        font-size: 12px;
        color: #667085;
        margin: 0;
    }

    /* FILTROS */

    .admin-financeiro-filtros {
        display: flex;
        gap: 5px;
        padding: 5px;
        background: #f3f6fa;
        border-radius: 10px;
        border: 1px solid #e5eaf0;
    }

    .admin-financeiro-filtro {
        border: 0;
        background: transparent;
        color: #475467;
        padding: 11px 17px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

    .admin-financeiro-filtro:hover {
        color: #0d6efd;
    }

    .admin-financeiro-filtro.active {
        background: #0d6efd;
        color: white;
    }

    /* GRÁFICO */

    .admin-financeiro-grafico {
        position: relative;
        height: 360px;
        width: 100%;
    }

    .admin-financeiro-sem-dados {
        text-align: center;
        font-size: 12px;
        color: #667085;
        margin-top: 15px;
    }

    /* TOTAL */

    .admin-financeiro-total {
        margin-top: 25px;
        background: #eff6ff;
        border-radius: 12px;
        padding: 22px 25px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
    }

    .admin-financeiro-total span {
        font-size: 14px;
        color: #475467;
        font-weight: 600;
    }

    .admin-financeiro-total strong {
        color: #0d6efd;
        font-size: 27px;
        font-weight: 800;
    }

    /* RESPONSIVIDADE */

    @@media (max-width: 768px) {

        .admin-financeiro-cabecalho {
            flex-direction: column;
            align-items: stretch;
        }

        .admin-financeiro-card {
            padding: 20px;
        }

        .admin-financeiro-filtros {
            width: 100%;
        }

        .admin-financeiro-filtro {
            flex: 1;
            padding: 10px 5px;
        }

        .admin-financeiro-grafico {
            height: 270px;
        }

        .admin-financeiro-total strong {
            font-size: 23px;
        }
    }
</style>

<div class="container-fluid admin-financeiro">

    <!-- CABEÇALHO -->

    <h1 class="admin-financeiro-titulo">
        Dashboard do Administrador
    </h1>

    <p class="admin-financeiro-subtitulo">
        Consulte os valores faturados pela AutoCET.
    </p>

    <!-- CARTÃO PRINCIPAL -->

    <section class="admin-financeiro-card">

        <div class="admin-financeiro-cabecalho">

            <div class="admin-financeiro-identidade">

                <div class="admin-financeiro-icone">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>

                <div>
                    <h2>Faturação da Oficina</h2>

                    <p>
                        Valores das reparações concluídas.
                    </p>
                </div>

            </div>

            <!-- FILTROS -->

            <div class="admin-financeiro-filtros"
                 aria-label="Selecionar período">

                <button type="button"
                        class="admin-financeiro-filtro"
                        data-periodo="1">
                    1 mês
                </button>

                <button type="button"
                        class="admin-financeiro-filtro"
                        data-periodo="3">
                    3 meses
                </button>

                <button type="button"
                        class="admin-financeiro-filtro active"
                        data-periodo="6">
                    6 meses
                </button>

                <button type="button"
                        class="admin-financeiro-filtro"
                        data-periodo="12">
                    Anual
                </button>

            </div>

        </div>

        <!-- GRÁFICO -->

        <div class="admin-financeiro-grafico">

            <canvas id="graficoFaturacao"
                    aria-label="Gráfico de faturação da oficina"
                    role="img">
            </canvas>

        </div>

        <p id="mensagemSemDados"
           class="admin-financeiro-sem-dados d-none">
            Não existe faturação registada neste período.
        </p>

        <!-- TOTAL DO PERÍODO -->

        <div class="admin-financeiro-total">

            <span id="tituloTotal">
                Total dos últimos 6 meses
            </span>

            <strong id="valorTotal">
                0,00 €
            </strong>

        </div>

    </section>

</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const canvas =
                document.getElementById("graficoFaturacao");

            if (!canvas || typeof Chart === "undefined") {
                return;
            }

            // DADOS REAIS DO CONTROLLER

            const meses =
                @Html.Raw(JsonSerializer.Serialize(meses));

            const ganhos =
                @Html.Raw(JsonSerializer.Serialize(ganhos));

            const botoes =
                document.querySelectorAll(
                    ".admin-financeiro-filtro"
                );

            const tituloTotal =
                document.getElementById("tituloTotal");

            const valorTotal =
                document.getElementById("valorTotal");

            const mensagemSemDados =
                document.getElementById("mensagemSemDados");

            const formatoEuro = new Intl.NumberFormat(
                "pt-PT",
                {
                    style: "currency",
                    currency: "EUR"
                }
            );

            // CRIAR O GRÁFICO

            const grafico = new Chart(canvas, {

                type: "bar",

                data: {

                    labels: [],

                    datasets: [{
                        label: "Faturação",
                        data: [],
                        backgroundColor: "#0d6efd",
                        hoverBackgroundColor: "#0756d5",
                        borderRadius: 7,
                        maxBarThickness: 85
                    }]
                },

                options: {

                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            display: false
                        },

                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return formatoEuro.format(
                                        context.parsed.y
                                    );
                                }
                            }
                        }
                    },

                    scales: {

                        x: {
                            grid: {
                                display: false
                            },

                            ticks: {
                                color: "#667085"
                            }
                        },

                        y: {
                            beginAtZero: true,

                            border: {
                                display: false
                            },

                            grid: {
                                color: "#e5eaf0"
                            },

                            ticks: {
                                color: "#667085",

                                callback: function (valor) {
                                    return formatoEuro.format(valor);
                                }
                            }
                        }
                    }
                }
            });

            // ATUALIZAR O PERÍODO

            function atualizarPeriodo(periodo) {

                const mesesFiltrados =
                    meses.slice(-periodo);

                const ganhosFiltrados =
                    ganhos.slice(-periodo);

                grafico.data.labels = mesesFiltrados;

                grafico.data.datasets[0].data =
                    ganhosFiltrados;

                grafico.update();

                // CALCULAR TOTAL

                const total = ganhosFiltrados.reduce(
                    (soma, valor) => soma + valor,
                    0
                );

                valorTotal.textContent =
                    formatoEuro.format(total);

                if (periodo === 1) {

                    tituloTotal.textContent =
                        "Total do mês atual";

                } else if (periodo === 12) {

                    tituloTotal.textContent =
                        "Total dos últimos 12 meses";

                } else {

                    tituloTotal.textContent =
                        `Total dos últimos ${periodo} meses`;
                }

                // MOSTRAR AVISO SE NÃO EXISTIREM VALORES

                mensagemSemDados.classList.toggle(
                    "d-none",
                    ganhosFiltrados.some(valor => valor > 0)
                );

                // BOTÃO SELECIONADO

                botoes.forEach(function (botao) {

                    const ativo =
                        Number(botao.dataset.periodo) === periodo;

                    botao.classList.toggle("active", ativo);

                    botao.setAttribute(
                        "aria-pressed",
                        ativo ? "true" : "false"
                    );
                });
            }

            // EVENTO DOS BOTÕES

            botoes.forEach(function (botao) {

                botao.addEventListener("click", function () {

                    atualizarPeriodo(
                        Number(botao.dataset.periodo)
                    );
                });
            });

            // PERÍODO INICIAL: 6 MESES

            atualizarPeriodo(6);
        });
    </script>
}
