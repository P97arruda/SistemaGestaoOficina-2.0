@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Administração";
}

<div class="container py-4">
    <div class="mb-4">
        <span class="text-primary small fw-bold text-uppercase">Administração</span>
        <h2 class="fw-bold mt-2">Bem-vindo à OficinaCET107</h2>
        <p class="text-muted mb-0">Organize as contas dos utilizadores e acompanhe os módulos de gestão da oficina.</p>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <span class="badge bg-success mb-3">Disponível</span>
            <h3 class="h5 fw-bold">Gestão de utilizadores</h3>
            <p class="text-muted">Crie contas para clientes e funcionários, consulte os utilizadores registados e edite ou remova contas de funcionários.</p>
            <p class="mb-0 small">Escolha <strong>Criar Utilizador</strong>, <strong>Clientes</strong> ou <strong>Funcionários</strong> no menu lateral para começar.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <section class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <span class="badge bg-light text-secondary border mb-3">Em desenvolvimento</span>
                    <h3 class="h5 fw-bold">Equipa da oficina</h3>
                    <p class="text-muted mb-0">Gestão de mecânicos e rececionistas. A organização destas funções será disponibilizada numa próxima etapa.</p>
                </div>
            </section>
        </div>
        <div class="col-md-6">
            <section class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <span class="badge bg-light text-secondary border mb-3">Em desenvolvimento</span>
                    <h3 class="h5 fw-bold">Tipos de reparações</h3>
                    <p class="text-muted mb-0">Organização dos tipos de reparações disponibilizados pela oficina.</p>
                </div>
            </section>
        </div>
        <div class="col-12">
            <section class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <span class="badge bg-light text-secondary border mb-3">Em desenvolvimento</span>
                    <h3 class="h5 fw-bold">A minha conta</h3>
                    <p class="text-muted mb-0">A edição do perfil do administrador e a recuperação de password ainda não estão disponíveis nesta área.</p>
                </div>
            </section>
        </div>
    </div>
</div>