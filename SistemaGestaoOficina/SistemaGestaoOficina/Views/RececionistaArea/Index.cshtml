
@using SistemaGestaoOficina.Data.Entities
@using System.Collections.Generic
@using System.Linq

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Painel do Rececionista";

    var ultimosVeiculos = ViewBag.UltimosVeiculos as IEnumerable<Veiculo>
        ?? Enumerable.Empty<Veiculo>();

    var marcacoesHoje = ViewBag.MarcacoesHoje as IEnumerable<Marcacao>
        ?? Enumerable.Empty<Marcacao>();

    var totalMarcacoesHoje = marcacoesHoje.Count();
}

<div class="container-fluid px-4 py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center
                flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Painel do Rececionista
            </h2>

            <p class="text-muted mb-0">
                Visão geral dos clientes, veículos e marcações da oficina.
            </p>
        </div>

        <div class="bg-white border rounded px-3 py-2 shadow-sm">
            <i class="bi bi-calendar3 me-2 text-secondary"></i>
            <span class="text-muted">
                @DateTime.Today.ToString("dd/MM/yyyy")
            </span>
        </div>

    </div>

    <!-- INDICADORES -->
    <div class="row g-3 mb-4">

        <!-- CLIENTES -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-2">
                                Clientes
                            </p>

                            <h2 class="fw-bold mb-0">
                                @(ViewBag.TotalClientes ?? 0)
                            </h2>
                        </div>

                        <div class="rounded p-3"
                             style="background-color: #e8f2ff;">

                            <i class="bi bi-people-fill fs-3 text-primary"></i>

                        </div>

                    </div>

                </div>

            </div>
        </div>

        <!-- VEÍCULOS -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-2">
                                Veículos
                            </p>

                            <h2 class="fw-bold mb-0">
                                @(ViewBag.TotalVeiculos ?? 0)
                            </h2>
                        </div>

                        <div class="rounded p-3"
                             style="background-color: #e5f7ef;">

                            <i class="bi bi-car-front-fill fs-3 text-success"></i>

                        </div>

                    </div>

                </div>

            </div>
        </div>

        <!-- MARCAÇÕES DE HOJE -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-2">
                                Marcações de Hoje
                            </p>

                            <h2 class="fw-bold mb-0">
                                @totalMarcacoesHoje
                            </h2>
                        </div>

                        <div class="rounded p-3"
                             style="background-color: #fff2e6;">

                            <i class="bi bi-calendar-check fs-3 text-warning"></i>

                        </div>

                    </div>

                </div>

            </div>
        </div>

    </div>

    <!-- INFORMAÇÕES PRINCIPAIS -->
    <div class="row g-3">

        <!-- MARCAÇÕES DE HOJE -->
        <div class="col-xl-7">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white border-0 p-4 pb-2">

                    <div class="d-flex justify-content-between align-items-center
                                flex-wrap gap-2">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Marcações de Hoje
                            </h5>

                            <p class="text-muted small mb-0">
                                Atendimentos previstos para hoje.
                            </p>
                        </div>

                        <a asp-controller="Marcacoes"
                           asp-action="Index"
                           class="btn btn-primary btn-sm">

                            Ver Marcações
                        </a>

                    </div>

                </div>

                <div class="card-body px-4 pt-3">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Hora</th>
                                    <th>Cliente</th>
                                    <th>Veículo</th>
                                    <th>Serviço</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (marcacoesHoje.Any())
                                {
                                    foreach (var marcacao in marcacoesHoje
                                        .OrderBy(m => m.DataHora))
                                    {
                                        <tr>

                                            <td class="text-nowrap">
                                                @marcacao.DataHora.ToString("HH:mm")
                                            </td>

                                            <td class="fw-semibold">
                                                @(marcacao.User?.FullName
                                                    ?? "Não informado")
                                            </td>

                                            <td>
                                                @if (marcacao.Veiculo != null)
                                                {
                                                    <div>
                                                        @marcacao.Veiculo.Marca
                                                        @marcacao.Veiculo.Modelo
                                                    </div>

                                                    <small class="text-muted">
                                                        @marcacao.Veiculo.Matricula
                                                    </small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Não informado
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @marcacao.TipoServico
                                            </td>

                                            <td>

                                                @if (marcacao.Estado == "Agendada")
                                                {
                                                    <span class="badge bg-primary">
                                                        Agendada
                                                    </span>
                                                }
                                                else if (marcacao.Estado == "Concluida" ||
                                                         marcacao.Estado == "Concluída")
                                                {
                                                    <span class="badge bg-success">
                                                        Concluída
                                                    </span>
                                                }
                                                else if (marcacao.Estado == "Cancelada")
                                                {
                                                    <span class="badge bg-danger">
                                                        Cancelada
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        @marcacao.Estado
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5"
                                            class="text-center text-muted py-4">

                                            <i class="bi bi-calendar-x d-block fs-4 mb-2"></i>

                                            Nenhuma marcação registada para hoje.

                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

        <!-- ÚLTIMOS VEÍCULOS -->
        <div class="col-xl-5">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white border-0 p-4 pb-2">

                    <h5 class="fw-bold mb-1">
                        Últimos Veículos Registados
                    </h5>

                    <p class="text-muted small mb-0">
                        Veículos adicionados à oficina.
                    </p>

                </div>

                <div class="card-body px-4 pt-3">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Matrícula</th>
                                    <th>Veículo</th>
                                    <th>Proprietário</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (ultimosVeiculos.Any())
                                {
                                    foreach (var veiculo in ultimosVeiculos)
                                    {
                                        <tr>

                                            <td class="fw-semibold text-nowrap">
                                                @veiculo.Matricula
                                            </td>

                                            <td>
                                                @veiculo.Marca @veiculo.Modelo
                                            </td>

                                            <td>
                                                @(veiculo.User?.FullName
                                                    ?? "Não informado")
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3"
                                            class="text-center text-muted py-4">

                                            Nenhum veículo registado.

                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
