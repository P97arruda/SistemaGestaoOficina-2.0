
@model IEnumerable<SistemaGestaoOficina.Data.Entities.User>

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Clientes";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Clientes</h2>
            <p class="text-muted mb-0">
                Clientes registados na oficina.
            </p>
        </div>

        <div>
            <a asp-controller="RececionistaArea"
               asp-action="CreateCliente"
               class="btn btn-primary">
                + Criar Cliente
            </a>

            <a asp-controller="RececionistaArea"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Voltar
            </a>
        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Contacto</th>
                            <th>NIF</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td>@cliente.FullName</td>
                                    <td>@cliente.Email</td>
                                    <td>@cliente.PhoneNumber</td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(cliente.NIF))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            @cliente.NIF
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="RececionistaArea"
                                           asp-action="EditCliente"
                                           asp-route-id="@cliente.Id"
                                           class="btn btn-sm btn-warning">
                                            Editar
                                        </a>

                                        <form asp-controller="RececionistaArea"
                                              asp-action="DeleteCliente"
                                              asp-route-id="@cliente.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Tem a certeza que deseja apagar este cliente?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Apagar
                                            </button>
                                        </form>

                                        <a asp-controller="Veiculos"
                                           asp-action="Index"
                                           asp-route-id="@cliente.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Veículos
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Ainda não existem clientes registados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
