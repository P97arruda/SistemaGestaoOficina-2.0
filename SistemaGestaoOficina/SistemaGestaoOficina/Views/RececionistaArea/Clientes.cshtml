
@model IEnumerable<SistemaGestaoOficina.Data.Entities.User>

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Clientes";
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Clientes</h2>
            <p class="text-muted mb-0">
                Consulte e gira os clientes registados na OficinaCET107.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="RececionistaArea"
               asp-action="CreateCliente"
               class="btn btn-primary">
                + Criar Cliente
            </a>

            <a asp-controller="RececionistaArea"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Voltar
            </a>

        </div>
    </div>

    <!-- MENSAGENS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- TABELA -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-3">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Contacto</th>
                            <th>NIF</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var cliente in Model)
                            {
                                <tr>

                                    <!-- FOTOGRAFIA E NOME -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">

                                            @if (cliente.ImageId != Guid.Empty)
                                            {
                                                <img src="@cliente.ImageFullPath"
                                                     alt="Fotografia de @cliente.FullName"
                                                     class="rounded-circle"
                                                     style="width: 38px;
                                                            height: 38px;
                                                            object-fit: cover;
                                                            flex-shrink: 0;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-primary text-white
                                                            d-flex align-items-center justify-content-center
                                                            fw-bold"
                                                     style="width: 38px;
                                                            height: 38px;
                                                            min-width: 38px;">

                                                    @(string.IsNullOrWhiteSpace(cliente.FirstName)
                                                        ? "C"
                                                        : cliente.FirstName.Substring(0, 1).ToUpper())

                                                </div>
                                            }

                                            <span class="fw-semibold">
                                                @cliente.FullName
                                            </span>

                                        </div>
                                    </td>

                                    <td>@cliente.Email</td>

                                    <td>@cliente.PhoneNumber</td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(cliente.NIF))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            @cliente.NIF
                                        }
                                    </td>

                                    <!-- AÇÕES -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">

                                            <!-- VEÍCULOS -->
                                            <a asp-controller="Veiculos"
                                               asp-action="Index"
                                               asp-route-id="@cliente.Id"
                                               class="btn btn-sm btn-primary">
                                                Veículos
                                            </a>

                                            <!-- APAGAR -->
                                            <form asp-controller="RececionistaArea"
                                                  asp-action="DeleteCliente"
                                                  asp-route-id="@cliente.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Tem a certeza que deseja apagar este cliente?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Apagar
                                                </button>

                                            </form>

                                            <!-- EDITAR -->
                                            <a asp-controller="RececionistaArea"
                                               asp-action="EditCliente"
                                               asp-route-id="@cliente.Id"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            <!-- DETALHES -->
                                            <a asp-controller="RececionistaArea"
                                               asp-action="DetailsCliente"
                                               asp-route-id="@cliente.Id"
                                               class="btn btn-sm btn-info text-white">
                                                Detalhes
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    Ainda não existem clientes registados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
