
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Reparacao>

@using System.Linq
@using SistemaGestaoOficina.Data.Entities

@{
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
    ViewData["Title"] = "Histórico de Reparações";

    var veiculo = ViewBag.Veiculo as Veiculo;

    var reparacoes = (Model ?? Enumerable.Empty<Reparacao>())
        .OrderByDescending(r => r.DataInicio)
        .ToList();
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Histórico de Reparações
        </h2>

        <p class="text-muted mb-0">
            Consulte as reparações realizadas neste veículo.
        </p>
    </div>

    <!-- IDENTIFICAÇÃO DO VEÍCULO -->
    @if (veiculo != null)
    {
        <div class="card shadow-sm border-0 mb-4"
             style="max-width: 900px;">

            <div class="card-body p-4">

                <h4 class="fw-bold mb-2">
                    @veiculo.Marca @veiculo.Modelo
                </h4>

                <div class="d-flex align-items-center gap-2 flex-wrap">

                    <span class="badge bg-primary">
                        @veiculo.Matricula
                    </span>

                    <span class="text-muted small">
                        Ano: @veiculo.Ano
                    </span>

                </div>

            </div>
        </div>
    }

    <!-- TÍTULO DA LISTAGEM -->
    <div class="mb-3">
        <h5 class="fw-bold mb-1">
            Reparações do Veículo
        </h5>

        <p class="text-muted mb-0">
            Informações e peças utilizadas em cada reparação.
        </p>
    </div>

    <!-- REPARAÇÕES -->
    @if (!reparacoes.Any())
    {
        <div class="card shadow-sm border-0"
             style="max-width: 900px;">

            <div class="card-body text-center py-5">

                <i class="bi bi-clock-history fs-1 text-muted"></i>

                <h5 class="fw-bold mt-3">
                    Nenhuma reparação registada
                </h5>

                <p class="text-muted mb-0">
                    Este veículo ainda não possui reparações no histórico.
                </p>

            </div>
        </div>
    }
    else
    {
        @foreach (var reparacao in reparacoes)
        {
            <div class="card shadow-sm border-0 mb-4"
                 style="max-width: 900px;">

                <div class="card-body p-4">

                    <!-- IDENTIFICAÇÃO DA REPARAÇÃO -->
                    <div class="d-flex justify-content-between
                                align-items-center flex-wrap gap-2 mb-3">

                        <div>
                            <h5 class="fw-bold mb-1">
                                @reparacao.TipoServico
                            </h5>

                            <span class="text-muted small">
                                Reparação #@reparacao.Id
                            </span>
                        </div>

                        @if (reparacao.Concluida)
                        {
                            <span class="badge bg-success">
                                Concluída
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Em curso
                            </span>
                        }

                    </div>

                    <hr class="mb-4" />

                    <!-- INFORMAÇÕES DA REPARAÇÃO -->
                    <h6 class="fw-bold mb-3">
                        Informações da Reparação
                    </h6>

                    <dl class="row mb-4">

                        <dt class="col-sm-4">
                            Tipo de Serviço
                        </dt>

                        <dd class="col-sm-8">
                            @reparacao.TipoServico
                        </dd>

                        <dt class="col-sm-4">
                            Data de Início
                        </dt>

                        <dd class="col-sm-8">
                            @reparacao.DataInicio.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-4">
                            Data de Conclusão
                        </dt>

                        <dd class="col-sm-8">

                            @if (reparacao.DataFim.HasValue)
                            {
                                @reparacao.DataFim.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Ainda não concluída
                                </span>
                            }

                        </dd>

                    </dl>

                    <!-- PEÇAS UTILIZADAS -->
                    <h6 class="fw-bold mb-3">
                        Peças Utilizadas
                    </h6>

                    @if (reparacao.ReparacaoPecas != null &&
                         reparacao.ReparacaoPecas.Any())
                    {
                        <div class="table-responsive mb-4">

                            <table class="table table-bordered
                                          table-hover align-middle mb-0">

                                <thead class="table-light">
                                    <tr>
                                        <th>Descrição da Peça</th>
                                        <th class="text-center">
                                            Qtd.
                                        </th>
                                        <th class="text-end">
                                            Preço Unitário
                                        </th>
                                        <th class="text-end">
                                            Subtotal
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in reparacao.ReparacaoPecas)
                                    {
                                        var subtotal = item.Quantidade *
                                                       item.PrecoUnitario;

                                        <tr>

                                            <td>
                                                @(item.Peca?.Nome
                                                    ?? "Peça não identificada")
                                            </td>

                                            <td class="text-center">
                                                @item.Quantidade
                                            </td>

                                            <td class="text-end">
                                                @item.PrecoUnitario.ToString("N2") €
                                            </td>

                                            <td class="text-end fw-semibold">
                                                @subtotal.ToString("N2") €
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="bg-light rounded p-3 mb-4">
                            <span class="text-muted">
                                Nenhuma peça registada nesta reparação.
                            </span>
                        </div>
                    }

                    <!-- CUSTOS DA REPARAÇÃO -->
                    <div class="border-top pt-3">

                        <!-- MÃO DE OBRA -->
                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                Mão de Obra
                            </span>

                            <span class="fw-semibold">
                                @reparacao.CustoMaoDeObra.ToString("N2") €
                            </span>

                        </div>

                        <!-- VALOR FINAL -->
                        <div class="d-flex justify-content-between
                                    align-items-center flex-wrap gap-2">

                            <span class="fw-bold">
                                Valor Final da Reparação
                            </span>

                            <h5 class="fw-bold text-success mb-0">
                                @reparacao.CustoTotal.ToString("N2") €
                            </h5>

                        </div>

                    </div>

                </div>
            </div>
        }
    }

    <!-- BOTÃO VOLTAR -->
    <div class="mt-4">

        <a asp-controller="Veiculos"
           asp-action="Details"
           asp-route-id="@veiculo?.Id"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar

        </a>

    </div>

</div>
