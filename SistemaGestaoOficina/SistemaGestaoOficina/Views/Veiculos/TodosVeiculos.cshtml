
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Veiculo>

@{
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
    ViewData["Title"] = "Todos os Veículos";
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Todos os Veículos</h2>

            <p class="text-muted mb-0">
                Consulte os veículos registados na oficina
                e os respetivos proprietários.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="RececionistaArea"
               asp-action="Clientes"
               class="btn btn-primary">
                + Adicionar Veículo
            </a>

            <a asp-controller="RececionistaArea"
               asp-action="Index"
               class="btn btn-secondary">
                Voltar
            </a>

        </div>
    </div>

    <!-- MENSAGENS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- TABELA PRINCIPAL -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-3">

            <!-- PESQUISA -->
            <div class="mb-4">

                <label for="pesquisaVeiculos"
                       class="form-label fw-semibold">
                    Pesquisar Veículos
                </label>

                <input type="text"
                       id="pesquisaVeiculos"
                       class="form-control"
                       placeholder="Pesquisar por matrícula, marca, modelo ou proprietário..."
                       style="max-width: 550px;" />

            </div>

            <!-- LISTAGEM -->
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="tabelaVeiculos">

                    <thead class="table-light">
                        <tr>
                            <th>Matrícula</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Ano</th>
                            <th>Proprietário</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var veiculo in Model)
                            {
                                <tr>

                                    <!-- MATRÍCULA -->
                                    <td>
                                        <span class="badge bg-light text-dark border px-3 py-2">
                                            @veiculo.Matricula
                                        </span>
                                    </td>

                                    <!-- MARCA -->
                                    <td class="fw-semibold">
                                        @veiculo.Marca
                                    </td>

                                    <!-- MODELO -->
                                    <td>
                                        @veiculo.Modelo
                                    </td>

                                    <!-- ANO -->
                                    <td>
                                        @veiculo.Ano
                                    </td>

                                    <!-- PROPRIETÁRIO -->
                                    <td>
                                        @if (veiculo.User != null)
                                        {
                                            <div class="d-flex align-items-center gap-2">

                                                @if (veiculo.User.ImageId != Guid.Empty)
                                                {
                                                    <img src="@veiculo.User.ImageFullPath"
                                                         alt="Fotografia do proprietário"
                                                         class="rounded-circle"
                                                         style="width: 36px;
                                                                height: 36px;
                                                                object-fit: cover;
                                                                flex-shrink: 0;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle bg-primary text-white
                                                                d-flex align-items-center justify-content-center fw-bold"
                                                         style="width: 36px;
                                                                height: 36px;
                                                                min-width: 36px;">

                                                        @(string.IsNullOrWhiteSpace(veiculo.User.FirstName)
                                                            ? "C"
                                                            : veiculo.User.FirstName.Substring(0, 1).ToUpper())

                                                    </div>
                                                }

                                                <span>
                                                    @veiculo.User.FullName
                                                </span>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Não identificado
                                            </span>
                                        }
                                    </td>

                                    <!-- AÇÕES -->
                                    <td class="text-end">

                                        <a asp-controller="Veiculos"
                                           asp-action="Index"
                                           asp-route-id="@veiculo.UserId"
                                           class="btn btn-sm btn-primary">
                                            Gerir
                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    Ainda não existem veículos registados na oficina.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- SEM RESULTADOS NA PESQUISA -->
            <p id="semResultados"
               class="text-muted text-center mt-4"
               style="display: none;">
                Nenhum veículo encontrado.
            </p>

        </div>
    </div>

</div>

@section Scripts {

    <script>
        document.getElementById("pesquisaVeiculos")
            .addEventListener("input", function () {

                const pesquisa = this.value.toLowerCase().trim();

                const linhas = document.querySelectorAll(
                    "#tabelaVeiculos tbody tr"
                );

                let encontrados = 0;

                linhas.forEach(function (linha) {

                    const texto = linha.innerText.toLowerCase();

                    const corresponde = texto.includes(pesquisa);

                    linha.style.display = corresponde ? "" : "none";

                    if (corresponde) {
                        encontrados++;
                    }
                });

                document.getElementById("semResultados").style.display =
                    encontrados === 0 ? "block" : "none";
            });
    </script>
}
