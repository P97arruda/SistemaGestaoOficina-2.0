
@model SistemaGestaoOficina.Models.CriarVeiculoViewModel

@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Adicionar Veículo";
}

<div class="container mt-5">

    <h2 class="fw-bold">Adicionar Veículo</h2>

    <form action="@Url.Action("Create", "Veiculos")"
          method="post">

        @Html.AntiForgeryToken()

        <!-- ID do cliente -->
        <input type="hidden"
               asp-for="UserId" />

        <div asp-validation-summary="All"
             class="text-danger">
        </div>

        <!-- MARCA -->
        <div class="mb-3">
            <label asp-for="Marca" class="form-label"></label>

            <input asp-for="Marca"
                   class="form-control" />

            <span asp-validation-for="Marca"
                  class="text-danger"></span>
        </div>

        <!-- MODELO -->
        <div class="mb-3">
            <label asp-for="Modelo" class="form-label"></label>

            <input asp-for="Modelo"
                   class="form-control" />

            <span asp-validation-for="Modelo"
                  class="text-danger"></span>
        </div>

        <!-- MATRÍCULA -->
        <div class="mb-3">
            <label asp-for="Matricula" class="form-label"></label>

            <input asp-for="Matricula"
                   class="form-control" />

            <span asp-validation-for="Matricula"
                  class="text-danger"></span>
        </div>

        <!-- ANO -->
        <div class="mb-3">
            <label asp-for="Ano" class="form-label"></label>

            <input asp-for="Ano"
                   type="number"
                   class="form-control" />

            <span asp-validation-for="Ano"
                  class="text-danger"></span>
        </div>

        <!-- QUILOMETRAGEM -->
        <div class="mb-3">
            <label asp-for="Quilometragem"
                   class="form-label"></label>

            <input asp-for="Quilometragem"
                   type="number"
                   class="form-control" />

            <span asp-validation-for="Quilometragem"
                  class="text-danger"></span>
        </div>

        <!-- COMBUSTÍVEL -->
        <div class="mb-3">
            <label asp-for="Combustivel"
                   class="form-label"></label>

            <input asp-for="Combustivel"
                   class="form-control" />

            <span asp-validation-for="Combustivel"
                  class="text-danger"></span>
        </div>

        <!-- BOTÕES -->
        <div class="mt-3">

            <button type="submit"
                    class="btn btn-primary">
                Guardar
            </button>

            <a asp-controller="Veiculos"
               asp-action="Index"
               asp-route-id="@Model.UserId"
               class="btn btn-outline-secondary">
                Voltar
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
