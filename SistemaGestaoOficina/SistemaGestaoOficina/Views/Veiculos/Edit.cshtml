@model SistemaGestaoOficina.Models.VeiculoViewModel

@{
    ViewData["Title"] = "Editar Veículo";
}

<div class="container mt-5">

    <h2 class="fw-bold">Editar Veículo</h2>

    <form asp-controller="Veiculos" asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserId" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Marca" class="form-label"></label>
            <input asp-for="Marca" class="form-control" />
            <span asp-validation-for="Marca" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Modelo" class="form-label"></label>
            <input asp-for="Modelo" class="form-control" />
            <span asp-validation-for="Modelo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Matricula" class="form-label"></label>
            <input asp-for="Matricula" class="form-control" />
            <span asp-validation-for="Matricula" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Ano" class="form-label"></label>
            <input asp-for="Ano" type="number" class="form-control" />
            <span asp-validation-for="Ano" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Quilometragem" class="form-label"></label>
            <input asp-for="Quilometragem" type="number" class="form-control" />
            <span asp-validation-for="Quilometragem" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Combustivel" class="form-label"></label>
            <input asp-for="Combustivel" class="form-control" />
            <span asp-validation-for="Combustivel" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Guardar Alterações
        </button>

        <a asp-controller="Veiculos"
           asp-action="Index"
           asp-route-id="@Model.UserId"
           class="btn btn-outline-secondary">
            Voltar
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}