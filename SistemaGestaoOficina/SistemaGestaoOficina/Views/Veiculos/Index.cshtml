
@model IEnumerable<SistemaGestaoOficina.Data.Entities.Veiculo>

@{
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
    ViewData["Title"] = "Veículos do Cliente";
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Veículos do Cliente @ViewBag.NomeCliente
            </h2>

            <p class="text-muted mb-0">
                Consulte e gira os veículos associados ao cliente.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Veiculos"
               asp-action="Create"
               asp-route-id="@ViewBag.ClienteId"
               class="btn btn-primary">
                + Adicionar Veículo
            </a>

            <a asp-controller="RececionistaArea"
               asp-action="Clientes"
               class="btn btn-secondary">
                Voltar
            </a>

        </div>
    </div>

    <!-- MENSAGENS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- TABELA DE VEÍCULOS -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-3">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Matrícula</th>
                            <th>Ano</th>
                            <th>Quilometragem</th>
                            <th>Combustível</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var veiculo in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @veiculo.Marca
                                    </td>

                                    <td>@veiculo.Modelo</td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @veiculo.Matricula
                                        </span>
                                    </td>

                                    <td>@veiculo.Ano</td>

                                    <td>@veiculo.Quilometragem</td>

                                    <td>@veiculo.Combustivel</td>

                                    <!-- AÇÕES -->
                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- APAGAR -->
                                            <form asp-controller="Veiculos"
                                                  asp-action="Delete"
                                                  asp-route-id="@veiculo.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Tem a certeza de que deseja apagar este veículo?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Apagar
                                                </button>

                                            </form>

                                            <!-- EDITAR -->
                                            <a asp-controller="Veiculos"
                                               asp-action="Edit"
                                               asp-route-id="@veiculo.Id"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            <!-- DETALHES -->
                                            <a asp-controller="Veiculos"
                                               asp-action="Details"
                                               asp-route-id="@veiculo.Id"
                                               class="btn btn-sm btn-info text-white">
                                                Detalhes
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    Ainda não existem veículos registados para este cliente.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
